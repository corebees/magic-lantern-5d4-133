     menu_add( "Overlay", zebra_menus, COUNT(zebra_menus) );
     menu_add( "Debug", livev_dbg_menus, COUNT(livev_dbg_menus) );
     //~ menu_add( "Movie", movie_menus, COUNT(movie_menus) );
diff --git a/src/test90_5d4_zebra.inc b/src/test90_5d4_zebra.inc
new file mode 100644
index 0000000..0db25c8
--- /dev/null
+++ b/src/test90_5d4_zebra.inc
@@ -0,0 +1,475 @@
+#ifdef CONFIG_5D4
+
+/*
+ * TEST90
+ *
+ * Real ML Zebra renderer -> indexed BMP -> RGBA
+ * -> double-buffered dedicated XIMR layer 1.
+ *
+ * Global Draw intentionally remains OFF.
+ */
+
+extern volatile int lv_5d4;
+extern int XimrExe(void *);
+
+volatile int test90_dedicated_active = 0;
+
+/*
+ * TEST91:
+ * 0 = generic getter
+ * 1/2/3 = force corresponding 5D4 YUV LV buffer.
+ */
+volatile int test91_yuv_slot = 0;
+
+static int
+test100_classify_vram(uint32_t addr, uint32_t *offset)
+{
+    const uint32_t size = 0x003F4800;
+
+    if (addr >= 0x7F02D400 &&
+        addr <  0x7F02D400 + size)
+    {
+        *offset = addr - 0x7F02D400;
+        return 1;
+    }
+
+    if (addr >= 0x7F421C00 &&
+        addr <  0x7F421C00 + size)
+    {
+        *offset = addr - 0x7F421C00;
+        return 2;
+    }
+
+    if (addr >= 0x7F816400 &&
+        addr <  0x7F816400 + size)
+    {
+        *offset = addr - 0x7F816400;
+        return 3;
+    }
+
+    if (addr >= 0x7FC0AC00 &&
+        addr <  0x7FC0AC00 + size)
+    {
+        *offset = addr - 0x7FC0AC00;
+        return 4;
+    }
+
+    *offset = 0;
+    return 0;
+}
+
+
+typedef int (*t90_surface_fn)(
+    void *, uint32_t, struct MARV *, uint32_t
+);
+
+typedef int (*t90_enable_fn)(
+    void *, uint32_t, uint32_t
+);
+
+typedef int (*t90_rect_fn)(
+    void *, uint32_t,
+    uint32_t, uint32_t,
+    uint32_t, uint32_t,
+    uint32_t, uint32_t
+);
+
+typedef int (*t90_blend_fn)(
+    void *, uint32_t,
+    uint32_t, uint32_t, uint32_t
+);
+
+typedef int (*t90_mode_fn)(
+    void *, uint32_t,
+    struct MARV *, uint32_t
+);
+
+#define T90_THUMB(addr, type) \
+    ((type)((uintptr_t)(addr) | 1))
+
+static void test90_zebra_layer_task(void *unused)
+{
+    /*
+     * Wait for Photo LiveView with Zebra enabled.
+     * Global Draw is NOT required for this diagnostic.
+     */
+    while (!lv_5d4 || !zebra_draw)
+        msleep(100);
+
+    msleep(1500);
+
+    if (!lv_5d4 || !zebra_draw)
+        return;
+
+    struct MARV *canon = _rgb_vram_info;
+
+    if (!canon ||
+        canon->signature != 0x5652414D ||
+        !canon->bitmap_data ||
+        canon->width < 720 ||
+        canon->height < 480 ||
+        canon->width > 1024 ||
+        canon->height > 640)
+    {
+        return;
+    }
+
+    uint32_t w = canon->width;
+    uint32_t h = canon->height;
+    uint32_t bytes = w * h * 4;
+
+    struct MARV *marv_a =
+        malloc(sizeof(struct MARV));
+
+    struct MARV *marv_b =
+        malloc(sizeof(struct MARV));
+
+    if (!marv_a || !marv_b)
+        return;
+
+    memcpy(marv_a, canon, sizeof(struct MARV));
+    memcpy(marv_b, canon, sizeof(struct MARV));
+
+    uint8_t *raw_a =
+        malloc(bytes + 0x100);
+
+    uint8_t *raw_b =
+        malloc(bytes + 0x100);
+
+    if (!raw_a || !raw_b)
+        return;
+
+    uint8_t *buf_a = UNCACHEABLE(
+        (uint8_t *)
+        ((((uintptr_t)raw_a + 0x100) >> 8) << 8)
+    );
+
+    uint8_t *buf_b = UNCACHEABLE(
+        (uint8_t *)
+        ((((uintptr_t)raw_b + 0x100) >> 8) << 8)
+    );
+
+    marv_a->bitmap_data = buf_a;
+    marv_a->opacity_data = 0;
+
+    marv_b->bitmap_data = buf_b;
+    marv_b->opacity_data = 0;
+
+    memset(buf_a, 0, bytes);
+    memset(buf_b, 0, bytes);
+
+    t90_surface_fn set_surface =
+        T90_THUMB(0xfe23d7e8, t90_surface_fn);
+
+    t90_enable_fn set_enable =
+        T90_THUMB(0xfe23d7c8, t90_enable_fn);
+
+    t90_rect_fn set_rect =
+        T90_THUMB(0xfe23d886, t90_rect_fn);
+
+    t90_blend_fn set_blend =
+        T90_THUMB(0xfe23d994, t90_blend_fn);
+
+    t90_mode_fn set_mode =
+        T90_THUMB(0xfe23da24, t90_mode_fn);
+
+    void *ctx = (void *)XIMR_CONTEXT;
+
+    if (set_surface(ctx, 1, marv_a, 0) ||
+        set_rect(ctx, 1, 120, 30, 720, 480, 0, 0) ||
+        set_blend(ctx, 1, 0, 3, 255) ||
+        set_mode(ctx, 1, marv_a, 1))
+    {
+        set_enable(ctx, 1, 0);
+        return;
+    }
+
+    ml_refresh_display_needed = 0;
+    test90_dedicated_active = 1;
+
+    if (set_enable(ctx, 1, 1))
+    {
+        test90_dedicated_active = 0;
+        return;
+    }
+
+    sync_caches();
+    XimrExe(ctx);
+
+    uint32_t ox =
+        (w >= 960) ? 120 : 0;
+
+    uint32_t oy =
+        (h >= 540) ? 30 : 0;
+
+    int display_a = 1;
+
+    /*
+     * 75 frames @ 200ms ~= 15 seconds.
+     */
+    for (uint32_t frame = 0;
+         frame < 80;
+         frame++)
+    {
+        if (!lv_5d4 ||
+            !zebra_draw ||
+            gui_menu_shown())
+        {
+            break;
+        }
+
+        struct MARV *next_marv =
+            display_a ? marv_b : marv_a;
+
+        uint8_t *next_buf =
+            display_a ? buf_b : buf_a;
+
+        /*
+         * TEST100 — Canon CurrentImgAddr.
+         */
+        test91_yuv_slot = 0;
+
+        uint32_t (*canon_img_a)(uint32_t) =
+            (void *)0xFE46898D;
+
+        uint32_t (*canon_img_b)(uint32_t) =
+            (void *)0xFE4689D7;
+
+        uint32_t a0 = canon_img_a(0);
+        uint32_t a1 = canon_img_a(1);
+        uint32_t a2 = canon_img_a(2);
+
+        uint32_t b0 = canon_img_b(0);
+        uint32_t b1 = canon_img_b(1);
+        uint32_t b2 = canon_img_b(2);
+
+        uint32_t oa0, oa1, oa2;
+        uint32_t ob0, ob1, ob2;
+
+        int ia0 = test100_classify_vram(a0, &oa0);
+        int ia1 = test100_classify_vram(a1, &oa1);
+        int ia2 = test100_classify_vram(a2, &oa2);
+
+        int ib0 = test100_classify_vram(b0, &ob0);
+        int ib1 = test100_classify_vram(b1, &ob1);
+        int ib2 = test100_classify_vram(b2, &ob2);
+
+        BMP_LOCK(
+            uint8_t *bmp = bmp_vram();
+
+            if (bmp)
+            {
+                /*
+                 * Clean indexed visible area.
+                 */
+                for (uint32_t y = 0;
+                     y < 480;
+                     y++)
+                {
+                    memset(
+                        bmp + BM(0, y),
+                        COLOR_TRANSPARENT_BLACK,
+                        720
+                    );
+                }
+
+                /*
+                 * REAL Magic Lantern Zebra renderer.
+                 */
+                /*
+                 * TEST99
+                 *
+                 * Canon's own locked wrapper around FE110BF0:
+                 *
+                 *   FE46898C(arg)
+                 *
+                 * arg:
+                 *   0 = current according to Disp_VramCtrl state
+                 *   1 = slot +0x78
+                 *   2 = slot +0x70
+                 *
+                 * Canon itself uses the returned value as an
+                 * image pointer in a width*height*2 copy path.
+                 */
+                
+/*
+                 * Build the next RGBA frame off-screen.
+                 */
+                /*
+                 * TEST109
+                 *
+                 * Hypothesis derived from TEST108:
+                 *
+                 * one 0x96000 surface contains four
+                 * sequential 160x480 UYVY vertical tiles.
+                 *
+                 * tile size:
+                 *   160 * 480 * 2 = 0x25800
+                 *
+                 * four tiles:
+                 *   4 * 0x25800 = 0x96000
+                 *
+                 * Reconstruct them side-by-side into
+                 * one 640x480 image.
+                 */
+
+                (void)a1;
+                (void)a2;
+                (void)b0;
+                (void)b1;
+                (void)b2;
+
+                (void)ia0;
+                (void)ia1;
+                (void)ia2;
+                (void)ib0;
+                (void)ib1;
+                (void)ib2;
+
+                (void)oa0;
+                (void)oa1;
+                (void)oa2;
+                (void)ob0;
+                (void)ob1;
+                (void)ob2;
+
+                volatile uint8_t *src =
+                    (volatile uint8_t *)a0;
+
+                for (uint32_t y = 0; y < 480; y += 2)
+                {
+                    for (uint32_t x = 0; x < 720; x += 2)
+                    {
+                        uint32_t sx =
+                            (x * 640) / 720;
+
+                        uint32_t tile =
+                            sx / 160;
+
+                        uint32_t tx =
+                            sx % 160;
+
+                        tx &= ~1U;
+
+                        uint32_t off =
+                            tile * 0x25800 +
+                            y * 320 +
+                            tx * 2;
+
+                        uint32_t q =
+                            *(volatile uint32_t *)
+                            (src + off);
+
+                        uint32_t Y0 =
+                            (q >> 8) & 0xff;
+
+                        uint32_t Y1 =
+                            (q >> 24) & 0xff;
+
+                        uint32_t Y =
+                            (Y0 + Y1) >> 1;
+
+                        uint8_t c;
+
+                        if (Y < 64)
+                            c = COLOR_BLUE;
+                        else if (Y < 128)
+                            c = COLOR_GREEN1;
+                        else if (Y < 192)
+                            c = COLOR_RED;
+                        else
+                            c = COLOR_WHITE;
+
+                        bmp[BM(x,     y    )] = c;
+                        bmp[BM(x + 1, y    )] = c;
+                        bmp[BM(x,     y + 1)] = c;
+                        bmp[BM(x + 1, y + 1)] = c;
+                    }
+                }
+
+                memset(next_buf, 0, bytes);
+
+                uint32_t *dst =
+                    (uint32_t *)next_buf;
+
+                for (uint32_t y = 0;
+                     y < 480;
+                     y++)
+                {
+                    uint8_t *src =
+                        bmp + BM(0, y);
+
+                    uint32_t *out =
+                        dst + (y + oy) * w + ox;
+
+                    for (uint32_t x = 0;
+                         x < 720;
+                         x++)
+                    {
+                        out[x] =
+                            indexed2rgb(src[x]);
+                    }
+                }
+
+                sync_caches();
+
+                /*
+                 * Atomic-ish frame publication:
+                 * switch source only after conversion is complete.
+                 */
+                if (!set_surface(
+                        ctx,
+                        1,
+                        next_marv,
+                        0))
+                {
+                    XimrExe(ctx);
+                    display_a = !display_a;
+                }
+            }
+        )
+
+        msleep(200);
+    }
+
+    test91_yuv_slot = 0;
+
+    set_enable(ctx, 1, 0);
+
+    sync_caches();
+    XimrExe(ctx);
+
+    test90_dedicated_active = 0;
+    ml_refresh_display_needed = 0;
+
+    BMP_LOCK(
+        uint8_t *bmp = bmp_vram();
+
+        if (bmp)
+        {
+            for (uint32_t y = 0;
+                 y < 480;
+                 y++)
+            {
+                memset(
+                    bmp + BM(0, y),
+                    COLOR_TRANSPARENT_BLACK,
+                    720
+                );
+            }
+        }
+    )
+}
+
+#if 0 /* TEST90_AUTOSTART_DISABLED — real Zebra test */
+TASK_CREATE(
+    "5d4_zebra_test",
+    test90_zebra_layer_task,
+    0,
+    0x1f,
+    0x4000
+);
+#endif
+
+
+#endif
diff --git a/src/ui01_r1_quickpanel.inc b/src/ui01_r1_quickpanel.inc
new file mode 100644
index 0000000..a71a331
--- /dev/null
+++ b/src/ui01_r1_quickpanel.inc
@@ -0,0 +1,122 @@
+
+/*
+ * UI01-R1C — Magic Lantern Next UI
+ * Canon EOS 5D Mark IV FW 1.3.3
+ *
+ * STATIC PREVIEW ONLY.
+ * No touch handling.
+ * No property writes.
+ * No intervalometer activation.
+ */
+
+static int ui01_r1_preview = 0;
+
+static void ui01_r1_draw(void)
+{
+    bmp_fill(COLOR_ALMOST_BLACK, 0, 0, 720, 480);
+
+    /* Header */
+    bmp_fill(COLOR_DARK_RED, 0, 0, 720, 58);
+
+    bmp_printf(
+        FONT(FONT_MED, COLOR_WHITE, COLOR_DARK_RED),
+        20, 15, "MAGIC LANTERN NEXT");
+
+    bmp_printf(
+        FONT(FONT_SMALL, COLOR_WHITE, COLOR_DARK_RED),
+        565, 20, "UI01-R1C");
+
+    /* EXPO card */
+    bmp_fill(COLOR_GRAY(15), 20, 78, 680, 165);
+    bmp_draw_rect(COLOR_GRAY(55), 20, 78, 680, 165);
+
+    bmp_printf(
+        FONT(FONT_MED, COLOR_WHITE, COLOR_GRAY(15)),
+        38, 96, "EXPO  /  ISO");
+
+    bmp_printf(
+        FONT(FONT_SMALL, COLOR_ALMOST_WHITE,
+             COLOR_GRAY(15)),
+        38, 132, "SIMULAZIONE");
+
+    bmp_fill(COLOR_DARK_RED, 368, 161, 82, 58);
+    bmp_fill(COLOR_DARK_RED, 594, 161, 82, 58);
+
+    bmp_printf(
+        FONT(FONT_LARGE, COLOR_WHITE, COLOR_DARK_RED),
+        397, 173, "-");
+
+    bmp_printf(
+        FONT(FONT_LARGE, COLOR_WHITE, COLOR_GRAY(15)),
+        483, 173, "400");
+
+    bmp_printf(
+        FONT(FONT_LARGE, COLOR_WHITE, COLOR_DARK_RED),
+        621, 173, "+");
+
+    /* SHOOT card */
+    bmp_fill(COLOR_GRAY(15), 20, 260, 680, 125);
+    bmp_draw_rect(COLOR_GRAY(55), 20, 260, 680, 125);
+
+    bmp_printf(
+        FONT(FONT_MED, COLOR_WHITE, COLOR_GRAY(15)),
+        38, 279, "SHOOT  /  Intervalometer");
+
+    bmp_printf(
+        FONT(FONT_SMALL, COLOR_ALMOST_WHITE,
+             COLOR_GRAY(15)),
+        38, 319, "NESSUNO SCATTO");
+
+    bmp_fill(COLOR_GRAY(45), 561, 309, 115, 48);
+
+    bmp_printf(
+        FONT(FONT_MED, COLOR_WHITE, COLOR_GRAY(45)),
+        597, 320, "OFF");
+
+    /* Footer */
+    bmp_printf(
+        FONT(FONT_SMALL, COLOR_ALMOST_WHITE,
+             COLOR_ALMOST_BLACK),
+        20, 414, "Touch non ancora attivo");
+
+    bmp_printf(
+        FONT(FONT_SMALL, COLOR_ALMOST_WHITE,
+             COLOR_ALMOST_BLACK),
+        20, 445, "SET: chiudi  |  MENU: esci");
+}
+
+static MENU_SELECT_FUNC(ui01_r1_select)
+{
+    (void)priv;
+    (void)delta;
+    ui01_r1_preview = !ui01_r1_preview;
+}
+
+static MENU_UPDATE_FUNC(ui01_r1_update)
+{
+    if (!entry->selected || lv)
+        ui01_r1_preview = 0;
+
+    MENU_SET_VALUE(
+        ui01_r1_preview ? "PREVIEW" : "OPEN"
+    );
+
+    MENU_SET_HELP("Static Next UI preview.");
+
+    if (ui01_r1_preview && entry->selected)
+    {
+        /* UI01-R2F: drawn in late pass */
+        info->custom_drawing =
+            CUSTOM_DRAW_THIS_MENU;
+    }
+}
+
+static struct menu_entry ui01_r1_entries[] =
+{
+    {
+        .name = "Next UI Demo",
+        .select = ui01_r1_select,
+        .update = ui01_r1_update,
+        .help = "Experimental Next UI preview.",
+    },
+};
