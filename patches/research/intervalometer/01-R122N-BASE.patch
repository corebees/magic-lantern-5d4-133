+/*
+ * GD-D6-ZEBRA31X
+ *
+ * Combined Luma Zebra state.
+ *
+ * zlh already becomes 255 when OVER is disabled.
+ * zll already becomes 0 when UNDER is disabled.
+ *
+ * Therefore no per-sample configuration branches are needed.
+ *
+ * State:
+ *   0 = transparent
+ *   1 = OVER feather
+ *   2 = OVER normal
+ *   3 = UNDER normal
+ */
+/* GHOST11E: spatial UYVY pair average from the current frame only.
+ * Same aligned word load; no frame history, new buffers or waits.
+ * Identical adjacent luminances keep the original classification.
+ */
+static inline int gd5d4_g11e_pair_luma(uint32_t word)
+{
+    return (((word >> 8) & 0xFFU) + (word >> 24) + 1U) >> 1;
+}
+
+static inline uint8_t
+gd5d4_z31x_luma_state(
+    int Y,
+    int zlh,
+    int zll
+)
+{
+    const uint8_t over =
+        gd5d4_z31w_over_state(
+            Y,
+            zlh
+        );
+
+    if (over)
+        return over;
+
+    if (Y < zll)
+        return 3;
+
+    return 0;
+}
+
+
+/*
+ * Collapse presentation states into threshold classes
+ * for adaptive Y2 edge detection:
+ *
+ *   0 = no Zebra
+ *   1 = OVER
+ *   2 = UNDER
+ *
+ * OVER feather/full therefore do not trigger extra YUV reads.
+ */
+static inline uint8_t
+gd5d4_z31x_state_class(
+    uint8_t state
+)
+{
+    if (state == 3)
+        return 2;
+
+    if (state != 0)
+        return 1;
+
+    return 0;
+}
