+                                row1[x + 0] = 0;
+                                row1[x + 1] = 0;
+                                row1[x + 2] = 0;
+                                row1[x + 3] = 0;
+                            }
+
+                            if (new_state != 0)
+                            {
+                                const uint32_t draw_color =
+                                    (new_state == 1)
+                                        ? edge_color
+                                        : (
+                                            (new_state == 3)
+                                                ? under_color
+                                                : ready_color
+                                          );
+
+                                /*
+                                 * Classic ML diagonal phase.
+                                 */
+                                switch (py & 3)
+                                {
+                                    case 0:
+                                        row0[x + 0] =
+                                            draw_color;
+                                        row0[x + 1] =
+                                            draw_color;
+                                        break;
+
+                                    case 1:
+                                        row0[x + 1] =
+                                            draw_color;
+                                        row0[x + 2] =
+                                            draw_color;
+                                        break;
+
+                                    case 2:
+                                        row0[x + 2] =
+                                            draw_color;
+                                        row0[x + 3] =
+                                            draw_color;
+                                        break;
+
+                                    default:
+                                        row0[x + 3] =
+                                            draw_color;
+                                        row0[x + 0] =
+                                            draw_color;
+                                        break;
+                                }
+
+                                switch ((py + 1) & 3)
+                                {
+                                    case 0:
+                                        row1[x + 0] =
+                                            draw_color;
+                                        row1[x + 1] =
+                                            draw_color;
+                                        break;
+
+                                    case 1:
+                                        row1[x + 1] =
+                                            draw_color;
+                                        row1[x + 2] =
+                                            draw_color;
+                                        break;
+
+                                    case 2:
+                                        row1[x + 2] =
+                                            draw_color;
+                                        row1[x + 3] =
+                                            draw_color;
+                                        break;
+
+                                    default:
+                                        row1[x + 3] =
+                                            draw_color;
+                                        row1[x + 0] =
+                                            draw_color;
+                                        break;
+                                }
+                            }
+                        }
+                    }
+
+                    if (has_next)
+                    {
+                        uint8_t *tmp =
+                            coarse_cur;
+
+                        coarse_cur =
+                            coarse_next;
+
+                        coarse_next =
+                            tmp;
+                    }
+                }
+            }
+        }
+    }
+
+    if (phase_capture) phase.raster = get_ms_clock();
+    if (gd5d4_g10g_active >= 0)
+        gd5d4_g10g_rows[gd5d4_g10g_active].scan = (uint32_t)get_ms_clock();
+    gd5d4_g4_phase_stamp(
+        gd5d4_g4_scan_done_ms
+    );
+
+#ifdef FEATURE_HISTOGRAM
+    gd5d4_copy_histogram_rgba_cached(
+        dst,
+        pitch,
+        ox,
+        oy
+    );
+#endif
+
+    if (phase_capture) phase.wf0 = get_ms_clock();
+#ifdef FEATURE_WAVEFORM
+    gd5d4_draw_small_waveform_rgba_cached(
+        dst,
+        pitch,
+        ox,
+        oy
+    );
+    gd5d4_draw_large_waveform_rgba_cached(dst, pitch, ox, oy);
+#endif
+    if (phase_capture) phase.wf1 = get_ms_clock();
+
+    if (
+        gd5d4_layer1_menu_entry_pending &&
+        (
+            gd5d4_z31y_late_handoff_inhibit ||
+            (!gd5d4_z31y_transition_bridge_active && !gd5d4_g10t_entry_render)
+        )
+    )
+        return -20;
+
+    /*
+     * Z31D:
+     * do NOT swap A/B.
+     *
+     * Flush the cached writes and ask XIMR to re-render the same
+     * surface already selected as layer1 input.
+     */
+    gd5d4_g4_phase_stamp(
+        gd5d4_g4_pre_exec_ms
+    );
+
+    if (
+        gd5d4_g3_trace_active() &&
+        !gd5d4_g3_before_execute_ms
+    )
+    {
+        gd5d4_g3_before_execute_ms =
+            (uint32_t)get_ms_clock();
+    }
+
+    if (gd5d4_z31y_exit_pending &&
+        gd5d4_z31y_exit_fade_step >= 2 &&
+        gd5d4_z31y_exit_fade_step <= 4)
+        gd5d4_g10e_phase[5 + (gd5d4_z31y_exit_fade_step - 2) * 2] =
+            (uint32_t)get_ms_clock();
+    if (gd5d4_g10g_active >= 0)
+        gd5d4_g10g_rows[gd5d4_g10g_active].exec0 = (uint32_t)get_ms_clock();
+    if (phase_capture) phase.exec0 = get_ms_clock();
+    int g3_execute_rc =
+        test31e_5d4_gdraw_execute_visible();
+    if (phase_capture) {
+        phase.end = get_ms_clock();
+        phase.ready_end = DV_VRAM_READY; phase.active_end = DV_VRAM_ACTIVE;
+        phase.gen_end = gd5d4_z31p_commit_generation; phase.rc = g3_execute_rc;
+        gd5d4_g12c_store(&phase);
+    }
+    if (gd5d4_g10g_active >= 0)
+    {
+        volatile struct gd5d4_g10g_record *d =
+            &gd5d4_g10g_rows[gd5d4_g10g_active];
+        d->exec1 = (uint32_t)get_ms_clock();
+        d->ready1 = DV_VRAM_READY;
+        d->active1 = DV_VRAM_ACTIVE;
+        d->gen1 = gd5d4_z31p_commit_generation;
+    }
+
+    gd5d4_g4_phase_stamp(
+        gd5d4_g4_post_exec_ms
+    );
+
+    if (
+        gd5d4_g3_trace_active() &&
+        !gd5d4_g3_after_execute_ms
+    )
+    {
+        gd5d4_g3_after_execute_ms =
+            (uint32_t)get_ms_clock();
+
+        gd5d4_g3_execute_rc =
+            (uint32_t)g3_execute_rc;
+    }
+
+    /*
+     * GHOST09A:
+     * frame-driven post-ML fade.
+     *
+     * No timer and no sleeps. Failed XIMR executes do not advance
+     * the lifecycle and therefore cannot prematurely unlock DELETE.
+     */
+    return g3_execute_rc;
+}
+#endif
