+/*
+ * TESTLV15B — LiveView Q-host preparation.
+ *
+ * HW-certified native Canon behavior:
+ *
+ *   LiveView + Q:
+ *     - LiveView video continues
+ *     - MAIN no longer changes Tv
+ *     - MAIN becomes GUI navigation
+ *
+ * TESTLV14D additionally proved selector13 may already occur at:
+ *
+ *   CURRENT_GUI_MODE = 0x29
+ *   PROP_GUI_STATE   = 9
+ *
+ * Architecture under test:
+ *
+ *   LiveView YUV stays active
+ *   Canon Quick Control stays logically active
+ *   Canon GUI layer0 stays hidden
+ *   ML renders on dedicated layer1
+ *
+ * Critical TESTLV4 rule:
+ *
+ *   delayed callback performs no XIMR operations.
+ */
+static volatile int
+    testlv15b_lv_q_host_pending_5d4 = 0;
+
+static volatile unsigned int
+    testlv15b_lv_q_host_poll_count_5d4 = 0;
+
+
+/*
+ * GD-D6-ZEBRA31Y-G6J2W-READONLY-COMMIT-GATE
+ *
+ * Canon EOS 5D Mark IV FW 1.3.3 GraphicSystemFinish state.
+ *
+ * Established by G6J2S/T/U:
+ *
+ *   base  = 0x0000FDE4
+ *   +0x08 = GraphicSystemFinish generation
+ *   +0x28 = GraphicSystemFinish transaction busy
+ *
+ * READ ONLY.
+ * Never write either Canon field.
+ */
+#define GD5D4_G6J2W_GS_GEN_ADDR   0x0000FDECU
+#define GD5D4_G6J2W_GS_BUSY_ADDR  0x0000FE0CU
+
+static volatile unsigned int
+    testlv15b_lv_gs_gen_before_5d4 = 0;
+
+static volatile int
+    testlv15b_lv_gs_token_armed_5d4 = 0;
+
+
+static unsigned int
+testlv15b_lv_gs_read_5d4(unsigned int addr)
+{
+    return *(volatile unsigned int *)addr;
+}
+
+
+
+static void
+testlv15b_lv_q_host_poll_cbr()
+{
+    if (!testlv15b_lv_q_host_pending_5d4)
+        return;
+
+    /*
+     * Q must commit while ML is still closed and LV alive.
+     */
+    if (menu_shown || !lv_5d4)
+    {
+        testlv15b_lv_q_host_pending_5d4 = 0;
+        testlv15b_lv_q_host_poll_count_5d4 = 0;
+        testlv15b_lv_gs_token_armed_5d4 = 0;
+
+        /*
+         * Request cleanup in normal menu_task context.
+         * No XIMR work from this callback.
+         */
+        testlv4_lv_cleanup_pending_5d4 = 1;
+        return;
+    }
+
+    /*
+     * TESTGM18B-A:
+     * renewable Canon LiveView host 0x4A committed.
+     *
+     * Stop here and hand control to the existing dedicated
+     * layer1 ML lifecycle.
+     *
+     * No Q, no PLAY and no keepalive.
+     */
+    /*
+     * G6J2W:
+     *
+     * CURRENT_GUI_MODE alone is not sufficient to release the
+     * Zebra transition curtain.
+     *
+     * Require the GraphicSystemFinish transaction that occurred
+     * after our pre-request generation snapshot to have completed.
+     */
+    /*
+     * G6J3H-R9-GS-EXACT-TIMELINE
+     *
+     * Independent READ-ONLY observation.
+     * Do not reuse these values for the lifecycle decision below;
+     * the original gate remains byte-for-byte logically unchanged.
+     */
+    if (testlv15b_lv_gs_token_armed_5d4)
+    {
+        unsigned int gd5d4_g6j3h_r9_gen_now =
+            testlv15b_lv_gs_read_5d4(
+                GD5D4_G6J2W_GS_GEN_ADDR
+            );
+
+        unsigned int gd5d4_g6j3h_r9_busy_now =
+            testlv15b_lv_gs_read_5d4(
+                GD5D4_G6J2W_GS_BUSY_ADDR
+            );
+
+        gd5d4_g1_mark_gs_poll(
+            (uint32_t)CURRENT_GUI_MODE,
+            testlv15b_lv_gs_gen_before_5d4,
+            gd5d4_g6j3h_r9_gen_now,
+            gd5d4_g6j3h_r9_busy_now
+        );
+    }
+
+    if (
+        CURRENT_GUI_MODE == 0x4A &&
+        testlv15b_lv_gs_token_armed_5d4 &&
+        testlv15b_lv_gs_read_5d4(
+            GD5D4_G6J2W_GS_GEN_ADDR
+        ) != testlv15b_lv_gs_gen_before_5d4 &&
+        testlv15b_lv_gs_read_5d4(
+            GD5D4_G6J2W_GS_BUSY_ADDR
+        ) == 0
+    )
+    {
+        gd5d4_g1_mark_gs_handoff(
+            testlv15b_lv_gs_gen_before_5d4,
+            testlv15b_lv_gs_read_5d4(
+                GD5D4_G6J2W_GS_GEN_ADDR
+            ),
+            testlv15b_lv_gs_read_5d4(
+                GD5D4_G6J2W_GS_BUSY_ADDR
+            )
+        );
+
+        /*
+         * GD-D6-ZEBRA31Y-G6J2Z-LIVE-BRIDGE-CUTOFF
+         *
+         * G6J2W has now proven:
+         *
+         *   CURRENT_GUI_MODE == 0x4A
+         *   generation changed
+         *   GraphicSystemFinish busy == 0
+         *
+         * Stop new Zebra publication NOW.
+         *
+         * An already-running Zebra frame remains serialized by
+         * BMP_LOCK; first ML publication uses the same lock.
+         */
+        gd5d4_z31y_late_handoff_inhibit = 1;
+
+        /*
+         * G1: first observed real Canon 0 -> 0x4A commit.
+         */
+        gd5d4_g1_mark_mode4a();
+
+        /*
+         * TESTNS16E-RC4:
+         * fresh LV hidden-Q transaction.
+         */
+        testlv15d_q_host_exit_armed_5d4 = 0;
+
+        testlv15b_lv_q_host_pending_5d4 = 0;
+        testlv15b_lv_q_host_poll_count_5d4 = 0;
+        testlv15b_lv_gs_token_armed_5d4 = 0;
+
+        /*
+         * TESTLV15D-A:
+         * establish t=0 only after Canon really committed Q.
+         */
+        /*
+         * TESTLV15D-B:
+         * start periodic Q-host keepalive timing from the
+         * actual Canon Q commit.
+         */
+        /*
+         * TESTGM18F-C1:
+         * start renewable 0x4A lease timing from actual commit.
+         */
+        testlv15d_q_host_last_refresh_ms_5d4 =
+            (unsigned int)get_ms_clock();
+
+        /*
+         * Reuse the already HW-proven TESTLV6 rendering and
+         * close lifecycle.
+         *
+         * Historical variable name says "no_host"; TESTLV15B
+         * now keeps Canon Q logically underneath while layer0
+         * remains visually hidden.
+         */
+        testlv6_lv_menu_no_host_5d4 = 1;
+
+        /*
+         * TESTGM18B-D:
+         *
+         * Retire the legacy +5000 ms TESTLV4 cleanup after a
+         * SUCCESSFUL 0x4A host commit.
+         *
+         * GM18B-A/B/C all lost ML at ~6 s, matching this timer.
+         *
+         * Entry/commit failure handling remains intact elsewhere.
+         * No delayed callback is required once 0x4A has committed
+         * and menu_open() is explicitly requested below.
+         */
+        give_semaphore(gui_sem);
+        return;
+    }
+
+    testlv15b_lv_q_host_poll_count_5d4++;
+
+    /*
+     * 100 polls * 10 ms ~= 1 second maximum.
+     */
+    if (testlv15b_lv_q_host_poll_count_5d4 < 100)
+    {
+        delayed_call(
+            10,
+            testlv15b_lv_q_host_poll_cbr,
+            0
+        );
+
+        return;
+    }
+
+    /*
+     * Timeout:
+     * request normal-context curtain cleanup only.
+     */
+    testlv15b_lv_q_host_pending_5d4 = 0;
+    testlv15b_lv_q_host_poll_count_5d4 = 0;
+    testlv15b_lv_gs_token_armed_5d4 = 0;
+    testlv4_lv_cleanup_pending_5d4 = 1;
+}
+
+
+
+/*
+ * TESTLV15C — hidden Q#2 LiveView host exit.
+ *
+ * At entry:
+ *
+ *   menu_shown = 0
+ *   Canon Q host still logically active
+ *   Canon layer0 still OFF
+ *   ML layer1 still visible
+ *
+ * Send Q#2 while layer1 covers the transition.
+ *
+ * Delayed callback performs NO XIMR operations.
+ */
+static void
+testlv15c_lv_q_exit_cbr()
+{
+    if (!testlv15c_lv_q_exit_stage_5d4)
+        return;
+
+    /*
+     * Never change Canon host underneath a reopened ML menu.
+     */
+    if (menu_shown)
+    {
+        testlv15c_lv_q_exit_stage_5d4 = 0;
+        testlv15c_lv_q_exit_poll_count_5d4 = 0;
+        testlv15c_lv_q_exit_stable_count_5d4 = 0;
+        return;
+    }
+
+    /*
+     * If LiveView disappeared, release the curtain using
+     * the existing safe menu_task cleanup path.
+     */
+    /*
+     * TESTNS16B:
+     * LV15C Q#2 exit is also valid for normal-shooting copycat.
+     * Abort only if we are in neither supported host.
+     */
+    if (
+        !lv_5d4 &&
+        !testns16b_shoot_copycat_active_5d4
+    )
+    {
+        testlv15c_lv_q_exit_stage_5d4 = 0;
+        testlv15c_lv_q_exit_poll_count_5d4 = 0;
+        testlv15c_lv_q_exit_stable_count_5d4 = 0;
+        testlv4_lv_cleanup_pending_5d4 = 1;
+        return;
+    }
+
+    /*
+     * Stage 1:
+     * Q host should still be committed.
+     */
+    if (testlv15c_lv_q_exit_stage_5d4 == 1)
+    {
+        /*
+         * If Canon already left Q, just reveal normal LV.
+         */
+        if (CURRENT_GUI_MODE != 0x29)
+        {
+            testlv15c_lv_q_exit_stage_5d4 = 0;
+            testlv15c_lv_q_exit_poll_count_5d4 = 0;
+            testlv4_lv_cleanup_pending_5d4 = 1;
+            return;
+        }
+
+        /*
+         * Q #2.
+         *
+         * Native HW test:
+         * Q while Quick Control is active returns directly
+         * to normal LiveView.
+         */
+        fake_simple_button(BGMT_Q);
+
+        testlv15c_lv_q_exit_stage_5d4 = 2;
+        testlv15c_lv_q_exit_poll_count_5d4 = 0;
+        testlv15c_lv_q_exit_stable_count_5d4 = 0;
+
+        delayed_call(
+            10,
+            testlv15c_lv_q_exit_cbr,
+            0
+        );
+
+        return;
+    }
+
+    /*
+     * Stage 2:
+     * keep ML layer1 covering Canon until Q really exited.
+     */
+    if (testlv15c_lv_q_exit_stage_5d4 == 2)
+    {
+        /*
+         * TESTNS16F-B:
+         *
+         * Do not reveal Canon on the first transient sample
+         * outside Q mode.
+         *
+         * Require 15 consecutive 10 ms observations with
+         * CURRENT_GUI_MODE != 0x29.
+         *
+         * If Q appears again during the window, restart the
+         * stability counter from zero.
+         */
+        if (CURRENT_GUI_MODE != 0x29)
+        {
+            testlv15c_lv_q_exit_stable_count_5d4++;
+
+            if (
+                testlv15c_lv_q_exit_stable_count_5d4 < 15
+            )
+            {
+                delayed_call(
+                    10,
+                    testlv15c_lv_q_exit_cbr,
+                    0
+                );
+
+                return;
+            }
+
+            /*
+             * Stable outside Q for >=150 ms.
+             *
+             * menu_task performs the HW-proven:
+             *
+             *   Canon layer0 ON
+             *   layer1 blank
+             *   layer1 disable
+             */
+            testlv15c_lv_q_exit_stage_5d4 = 0;
+            testlv15c_lv_q_exit_poll_count_5d4 = 0;
+            testlv15c_lv_q_exit_stable_count_5d4 = 0;
+
+            testlv4_lv_cleanup_pending_5d4 = 1;
+            return;
+        }
+
+        /*
+         * Returned/still in Q:
+         * any partial exit observation was transient.
+         */
+        testlv15c_lv_q_exit_stable_count_5d4 = 0;
+
+        testlv15c_lv_q_exit_poll_count_5d4++;
+
+        if (testlv15c_lv_q_exit_poll_count_5d4 < 100)
+        {
+            delayed_call(
+                10,
+                testlv15c_lv_q_exit_cbr,
+                0
+            );
+
+            return;
+        }
+
+        /*
+         * ~1 second timeout.
+         *
+         * Prefer revealing Canon Q over leaving layer1 stuck.
+         */
+        testlv15c_lv_q_exit_stage_5d4 = 0;
+        testlv15c_lv_q_exit_poll_count_5d4 = 0;
+        testlv15c_lv_q_exit_stable_count_5d4 = 0;
+        testlv4_lv_cleanup_pending_5d4 = 1;
+        return;
+    }
+
+    testlv15c_lv_q_exit_stage_5d4 = 0;
+    testlv15c_lv_q_exit_poll_count_5d4 = 0;
+    testlv15c_lv_q_exit_stable_count_5d4 = 0;
+}
