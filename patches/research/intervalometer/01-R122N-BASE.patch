+ * TESTLV4 — deferred LiveView curtain cleanup.
+ *
+ * Critical rule:
+ *
+ * delayed_call callback only requests cleanup.
+ * It must never touch XIMR.
+ *
+ * menu_task performs the actual blank + disable operation.
+ */
+extern int
+testlv5_5d4_canon_gui_layer_enable(int enable);
+
+
+static volatile int
+testlv4_lv_cleanup_pending_5d4 = 0;
+
