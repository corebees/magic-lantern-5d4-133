+static void menu_open()
+{
+#ifdef CONFIG_5D4
+    if (!get_halfshutter_pressed())
+        tesths2a_halfshutter_close_armed_5d4 = 0;
+#endif
+
+    if (menu_shown)
+        return;
+
+    DryosDebugMsg(0, 15, "in menu_open");
+
+    // start in my menu, if configured
+    /*
+    if (start_in_my_menu)
+    {
+        struct menu * my_menu = menu_find_by_name(MY_MENU_NAME, 0);
+        if (menu_has_visible_items(my_menu))
+            select_menu_by_icon(ICON_ML_MYMENU);
+    }
+    */
+
+#ifdef CONFIG_5DC
+    //~ forces the 5dc screen to turn on for ML menu.
+    if (!DISPLAY_IS_ON)
+        fake_simple_button(BGMT_MENU);
+    msleep(50);
+#endif
+
+    menu_lv_transparent_mode = 0;
+    submenu_level = 0;
+    edit_mode = 0;
+    customize_mode = 0;
+    menu_help_active = 0;
+    keyrepeat = 0;
+    menu_shown = 1;
+
+#ifdef CONFIG_5D4
+    /*
+     * G1: menu_shown has become authoritative.
+     * RAM only.
+     */
+    gd5d4_g1_mark_menu_shown();
+#endif
+
+    //~ menu_hidden_should_display_help = 0;
+    if (lv)
+        menu_zebras_mirror_dirty = 1;
+
+    piggyback_canon_menu();
+
+
+#ifdef CONFIG_5D4
+    /*
+     * TESTGM18D-A:
+     *
+     * Renewable LiveView host 0x4A is already providing native
+     * MAIN/REAR ownership and ML renders on dedicated layer1.
+     *
+     * Do NOT disable Canon's front buffer for this one host.
+     *
+     * GM18F: naked 0x4A has a natural ~6 s lease; all ML-host tests so far
+     * return autonomously to mode 0 after ~6 s.
+     *
+     * This is distinct from the XIMR layer0 enable/disable test.
+     */
+    if (!(
+        lv_5d4 &&
+        testlv6_lv_menu_no_host_5d4 &&
+        CURRENT_GUI_MODE == 0x4A
+    ))
+    {
+        canon_gui_disable_front_buffer(0);
+    }
+#else
+    canon_gui_disable_front_buffer(0);
+#endif
+
+    if (lv && EXT_MONITOR_CONNECTED)
+        clrscr();
+
+#if !defined(CONFIG_XF605)
+#ifdef CONFIG_5D4
+    /*
+     * TESTGM18D-B:
+     *
+     * Naked 0x4A also never executes CancelDateTimer().
+     * Do not alter Canon timer state during this differential.
+     */
+    if (!(
+        lv_5d4 &&
+        testlv6_lv_menu_no_host_5d4 &&
+        CURRENT_GUI_MODE == 0x4A
+    ))
+    {
+        CancelDateTimer();
+    }
+#else
+    CancelDateTimer();
+#endif
+#endif
+
+    menu_redraw_full();
+}
