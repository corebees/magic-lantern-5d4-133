+static inline uint8_t
+gd5d4_z29m_alpha_from_level(uint8_t level)
+{
+    switch (level)
+    {
+        case 1:
+            return 0x4D;   /* ~30% */
+
+        case 2:
+            return 0x80;   /* ~50% */
+
+        case 3:
+            return 0xB3;   /* ~70% */
+
+        default:
+            return 0xED;   /* ~93% */
+    }
+}
+
+
+static inline uint32_t
+gd5d4_z29m_color_for_state(
+    uint8_t state,
+    uint32_t red,
+    uint32_t blue
+)
+{
+    if (!state)
+        return 0;
+
+    const int under =
+        state > 4;
+
+    const uint8_t level =
+        under
+            ? state - 4
+            : state;
+
+    const uint32_t rgb =
+        under
+            ? blue
+            : red;
+
+    const uint8_t alpha =
+        gd5d4_z29m_alpha_from_level(level);
+
+    return
+        (rgb & 0x00FFFFFF) |
+        ((uint32_t)alpha << 24);
+}
