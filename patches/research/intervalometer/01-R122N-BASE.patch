+ *   2 = test161_5d4_gdraw_blank_keepalive()
+ */
+volatile uint32_t gd5d4_ghost04_seq_5d4 = 0xFFFFFFFFU;
+volatile uint32_t gd5d4_ghost04_kind_5d4 = 0xFFFFFFFFU;
+volatile uint32_t gd5d4_ghost04_caller_5d4 = 0xFFFFFFFFU;
+
+
+static uint32_t
+gd5d4_ghost03_buffer_id_5d4(const void *p)
+{
+    if (p == (const void *)test154_draw_a)
