+/*
+ * BEGIN FRAME
+ *
+ * Return the RGBA surface NOT currently visible.
+ */
+static uint32_t *
+test146_backend_begin_frame(void)
+{
+    if (!test146_active)
+        return NULL;
+
+    /*
+     * TEST154:
+     *
+     * CPU draws through the cached mapping.
+     *
+     * The MARV presented to XIMR continues to reference the
+     * corresponding UNCACHEABLE mapping of the same memory.
+     *
+     * test146_backend_present() already performs sync_caches()
+     * before switching the XIMR surface.
+     */
+    uint8_t *back =
+        test146_display_a
+        ? test154_draw_b
+        : test154_draw_a;
+
+    if (!back)
+        return NULL;
+
+    return (uint32_t *)back;
+}
