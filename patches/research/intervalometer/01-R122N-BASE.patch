+ *
+ * Do NOT:
+ * - switch A/B surfaces
+ * - call set_surface()
+ * - change rectangle
+ * - change blend
+ * - change mode
+ * - change enable
+ *
+ * Only make CPU writes visible and ask XIMR/Zico to execute the
+ * already configured context.
+ */
+extern void
+gd5d4_g4_compositor_stamp(
+    int phase
+);
