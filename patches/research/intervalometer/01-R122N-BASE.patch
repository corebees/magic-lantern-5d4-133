+static int gd5d4_g12a_rgb_only(void)
+{
+    return zebra_draw && zebra_colorspace == 1 && !hist_draw && !waveform_draw;
+}
+
+static unsigned int gd5d4_g12a_rgb_state(int Y, int R, int G, int B, int hi, int lo)
+{
+    if (Y < lo) return 8U;
+    return (R > hi ? 4U : 0U) | (G > hi ? 2U : 0U) | (B > hi ? 1U : 0U);
+}
+
+static int gd5d4_g12a_render_rgb_locked(void)
+{
+    if (!gd5d4_g12a_rgb_only() || gui_menu_shown() || gd5d4_z31y_menu_active) return -32;
+    if (gd5d4_layer1_menu_entry_pending && !gd5d4_graph_entry_allowed()) return -20;
+    if (!lv_luma_is_accurate() || !(zebra_rec || NOT_RECORDING)) return -33;
+    /* GRAPHS12: keep RGB exit source policy aligned with Luma. */
+    const int use_active = gd5d4_z31y_transition_bridge_active ||
+        gd5d4_g10t_entry_render || gd5d4_g11i_info_render == 1;
+    /* Exclude entry/exit/INFO fades: measure ordinary RGB tracking. */
+    const int capture = 0 && gd5d4_g12c_armed && !use_active &&
+        !gd5d4_z31y_exit_pending && !gd5d4_g11i_info_render &&
+        !gd5d4_layer1_menu_entry_pending && gd5d4_fad05_alpha_scale_5d4 == 255U;
+    struct gd5d4_g12c_row trace = {0};
+    if (capture) { trace.start = get_ms_clock(); trace.gen_start = gd5d4_z31p_commit_generation; }
+    uint32_t address = use_active ? DV_VRAM_ACTIVE : DV_VRAM_READY;
+    struct vram_info *lv_info = get_yuv422_vram();
+    if (!lv_info || !address) return -34;
+    uint8_t *source = (uint8_t *)CACHEABLE(address);
+    uint32_t *dst = 0, pitch = 0, ox = 0, oy = 0;
+    int rc = test31d_5d4_gdraw_begin_visible_rgba(&dst, &pitch, &ox, &oy);
+    if (rc != 0 || !dst) return rc ? rc : -35;
+    if (capture) { trace.begin = get_ms_clock(); trace.source = address; }
+    const int off = get_y_skip_offset_for_overlays();
+    const int x0 = COERCE(os.x0, 0, 720), x1 = COERCE(os.x_max, 0, 720);
+    const int y0 = COERCE(os.y0 + off, 0, 480), y1 = COERCE(os.y_max - off, 0, 480);
+    /* GHOST12J: reuse Luma's per-physical-surface byte cache at full opacity.
+     * A reserved menu-generation value distinguishes RGB from Luma. Luma
+     * already invalidates any nonzero generation on return to ordinary LV.
+     * Geometry is packed only within exact bounded fields; other layouts
+     * and all transitions take the unconditional raster path.
+     */
+    struct gd5d4_z19_state *rgb_cache = 0;
+    uint32_t rgb_geometry = 0;
+    int rgb_valid = 0;
+    if (!use_active && !gd5d4_z31y_exit_pending && !gd5d4_g11i_info_render &&
+        !gd5d4_layer1_menu_entry_pending && gd5d4_fad05_alpha_scale_5d4 == 255U &&
+        x0 == 0 && x1 == 720 && y0 == 0 && y1 == 480 &&
+        pitch < 2048U && ox < 1024U && oy < 1024U)
+    {
+        rgb_cache = gd5d4_z19_select(dst);
+        rgb_geometry = pitch | (ox << 11) | (oy << 21);
+        rgb_valid = !rgb_cache->full_clear && rgb_cache->z31s_delta_valid &&
+            rgb_cache->z31y_menu_generation == 0xFFFFFFFFU &&
+            rgb_cache->count == rgb_geometry;
+    }
+    else gd5d4_z19_reset = 1;
+    /* GHOST12H: the sampled rectangle is completely overwritten below,
+     * including transparent cells. Clear only its complement to retire menu
+     * pixels and previous layouts; empty rectangles require a full clear.
+     */
+    for (int y = 0; y < 480; y++)
+    {
+        uint32_t *out = dst + (oy + y) * pitch + ox;
+        if (y < y0 || y >= y1 || x0 >= x1)
+            memset(out, 0, 720U * sizeof(uint32_t));
+        else
+        {
+            if (x0) memset(out, 0, x0 * sizeof(uint32_t));
+            if (x1 < 720) memset(out + x1, 0, (720 - x1) * sizeof(uint32_t));
+        }
+    }
+    if (capture) trace.clear = get_ms_clock();
+    const int hi = zebra_level_hi * 255 / 100 - 1;
+    const int lo = zebra_level_lo * 255 / 100;
+    uint32_t pixels[4][9][4];
+    for (unsigned phase = 0; phase < 4; phase++)
+        for (unsigned state = 0; state < 9; state++)
+        {
+            uint32_t packed = (uint32_t)zebra_rgb_color(state == 8, state & 4, state & 2, state & 1, phase);
+            for (unsigned k = 0; k < 4; k++)
+            {
+                unsigned pal = (packed >> (k * 8U)) & 0xFFU;
+                pixels[phase][state][k] = pal ? gd5d4_graph_fade_rgba(indexed2rgb(pal)) : 0;
+            }
+        }
+    for (int y = y0; y < y1; y += 2)
+    {
+        const uint32_t *row = (const uint32_t *)(source + BM2LV_R(y));
+        for (int x = x0; x < x1; x += 4)
+        {
+            uint32_t word = row[(x * 5) >> 3];
+            int Y, R, G, B;
+            COMPUTE_UYVY2YRGB(word, Y, R, G, B);
+            unsigned state = gd5d4_g12a_rgb_state(Y, R, G, B, hi, lo);
+            if (rgb_cache)
+            {
+                uint8_t *prior = &rgb_cache->z31s_delta[y >> 1][x >> 2];
+                if (rgb_valid && *prior == state) continue;
+                *prior = state;
+            }
+            for (int dy = 0; dy < 2 && y + dy < y1; dy++)
+            {
+                uint32_t *out = dst + (oy + y + dy) * pitch + ox;
+                const uint32_t *cell = pixels[(y + dy) & 3][state];
+                if (x + 4 <= x1)
+                {
+                    out[x] = cell[0];
+                    out[x + 1] = cell[1];
+                    out[x + 2] = cell[2];
+                    out[x + 3] = cell[3];
+                }
+                else
+                    for (int dx = 0; x + dx < x1; dx++)
+                        out[x + dx] = cell[dx];
+            }
+        }
+    }
+    if (rgb_cache)
+    {
+        rgb_cache->z31y_menu_generation = 0xFFFFFFFFU;
+        rgb_cache->count = rgb_geometry;
+        rgb_cache->full_clear = 0;
+        rgb_cache->z31s_delta_valid = 1;
+    }
+    if (capture) trace.raster = get_ms_clock();
+    if (gui_menu_shown() || gd5d4_z31y_menu_active ||
+        (gd5d4_layer1_menu_entry_pending && !gd5d4_graph_entry_allowed())) return -20;
+    rc = test31e_5d4_gdraw_execute_visible();
+    if (capture) {
+        trace.end = get_ms_clock(); trace.rc = rc;
+        trace.ready_end = DV_VRAM_READY; trace.active_end = DV_VRAM_ACTIVE;
+        trace.gen_end = gd5d4_z31p_commit_generation;
+        gd5d4_g12c_store(&trace);
+    }
+    return rc;
+}
