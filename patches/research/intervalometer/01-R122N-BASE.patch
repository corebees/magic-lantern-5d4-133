+int
+test31e_5d4_gdraw_execute_visible(void)
+{
+    if (!test146_active)
+        return -1;
+
+    void *ctx =
+        (void *)XIMR_CONTEXT;
+
+    gd5d4_g4_compositor_stamp(0);
+
+    sync_caches();
+
+    gd5d4_g4_compositor_stamp(1);
+
+    XimrExe(ctx);
+
+    gd5d4_g4_compositor_stamp(2);
+
+    return 0;
+}
