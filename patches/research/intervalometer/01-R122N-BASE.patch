+/*
+ * GD-D6-ZEBRA31Y-G6E-EARLY-ONESHOT-REARM
+ *
+ * G6D HW trace showed that the long first entry-bridge render
+ * prevents the worker from rearming Canon's one-shot until that
+ * render has completed.
+ *
+ * Rearm before rendering, but ONLY during the strict Z31Y entry
+ * bridge.
+ *
+ * Callback context remains state-only:
+ * generation++ and give_semaphore().
+ *
+ * If Canon owns +0x48, gd5d4_z31p_arm_commit_callback() simply
+ * refuses to replace it, preserving the existing safety rule.
+ */
+static const char
+gd5d4_z31y_g6e_build_marker[]
+__attribute__((used)) =
+    "Z31Y-G6E";
+
+
+/*
+ * GD-D6-ZEBRA31Y-G6F-OPPORTUNISTIC-REARM
+ *
+ * Return whether our callback is now installed/already installed.
+ * A Canon-owned slot still returns false and is never replaced.
+ */
+static inline int
+gd5d4_z31y_g6e_early_rearm(void)
+{
+    if (
+        !gd5d4_z31y_late_handoff_inhibit &&
+        gd5d4_z31y_transition_bridge_active &&
+        gd5d4_layer1_menu_entry_pending &&
+        !gd5d4_z31y_menu_active &&
+        test147_5d4_gdraw_active &&
+        (
+            CURRENT_GUI_MODE == 0 ||
+            CURRENT_GUI_MODE == 0x4A
+        )
+    )
+    {
+        return
+            gd5d4_z31p_arm_commit_callback();
+    }
+
+    return 0;
+}
