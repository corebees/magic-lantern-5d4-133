+    if (
+        gd5d4_ghost03_clear_seq_5d4 != 0xFFFFFFFFU &&
+        gd5d4_ghost03_begin_seq_5d4 == 0xFFFFFFFFU &&
+        gd5d4_ghost04_seq_5d4 == 0xFFFFFFFFU
