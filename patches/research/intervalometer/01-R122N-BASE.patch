+/*
+ * TESTLV6:
+ *
+ * Convert the completed 720x480 indexed ML menu directly into
+ * the already-active dedicated XIMR layer1.
+ *
+ * This deliberately bypasses Canon layer0.
+ */
+static int
+testlv6_publish_menu_layer1_5d4(void)
+{
+
+    /*
+     * G6J1:
+     * logical ML menu is now active and TESTLV6 owns the normal
+     * publication path.
+     *
+     * Retire the opaque transition snapshot immediately before
+     * the existing publisher does its normal work.
+     */
+    if (
+        gd5d4_g6j1_snapshot_active &&
+        menu_shown &&
+        testlv6_lv_menu_no_host_5d4 &&
+        level_curtain_active_5d4
+    )
+    {
+        gd5d4_g6j1_retire_snapshot();
+    }
+
+    if (!testlv6_lv_menu_no_host_5d4)
+        return -600;
+
+    if (!level_curtain_active_5d4)
+        return -601;
+
+    uint8_t *src =
+        bmp_vram();
+
+    if (!src)
+        return -602;
+
+    /*
+     * Snapshot entry state before beginning the potentially long
+     * 720x480 conversion.
+     *
+     * entry_pending cannot normally retire until menu_active is
+     * published, but use a local value so lock policy remains
+     * internally consistent for this invocation.
+     */
+    const int g6b_entry =
+        gd5d4_z31y_entry_scope_now();
+
+    uint32_t *dst = 0;
+    uint32_t pitch = 0;
+    uint32_t ox = 0;
+    uint32_t oy = 0;
+
+    /*
+     * test149 begin_rgba() returns the dedicated layer1 surface
+     * which is NOT currently visible.
+     *
+     * During G6B entry this is intentionally outside BMP_LOCK:
+     * READY Zebra modifies only the already-visible surface and
+     * never toggles A/B in the transition bridge.
+     */
+    int rc =
+        test149_5d4_gdraw_begin_rgba(
+            &dst,
+            &pitch,
+            &ox,
+            &oy
+        );
+
+    if (rc != 0 || !dst)
+        return rc ? rc : -603;
+
+    if (g6b_entry)
+        gd5d4_ghost03_mark_menu_begin_5d4(dst);
+
+    memset(
+        gd5d4_z31y_menu_cell_mask,
+        0,
+        sizeof(gd5d4_z31y_menu_cell_mask)
+    );
+
+    for (uint32_t y = 0; y < 480; y++)
+    {
+        uint8_t *in =
+            src + BM(0, y);
+
+        uint32_t *out =
+            dst +
+            (oy + y) * pitch +
+            ox;
+
+        for (uint32_t x = 0; x < 720; x++)
+        {
+            const uint32_t rgba =
+                indexed2rgb(in[x]);
+
+            out[x] = rgba;
+
+            if ((rgba >> 24) != 0)
+            {
+                const uint32_t cell =
+                    (y >> 1) * 180U +
+                    (x >> 2);
+
+                gd5d4_z31y_menu_cell_mask[
+                    cell >> 5
+                ] |=
+                    1U <<
+                    (cell & 31);
+            }
+        }
+
+        /*
+         * G6B cooperative scheduling points.
+         *
+         * menu_redraw_task is priority 0x1a while 5d4_gdraw is 0x1f.
+         * Without an explicit sleep/yield, moving work outside the
+         * mutex can merely turn mutex starvation into priority
+         * starvation.
+         *
+         * Only two points are used in the 480-row conversion.
+         * They exist exclusively during the first Zebra entry build.
+         */
+        if (
+            g6b_entry &&
+            (
+                y == 159U ||
+                y == 319U
+            )
+        )
+        {
+            msleep(1);
+        }
+    }
+
+    if (g6b_entry)
+    {
+        /*
+         * Only the real XIMR A/B handoff and corresponding logical
+         * menu ownership publication are serialized with Zebra.
+         *
+         * G3 markers now describe the final present-lock interval.
+         */
+        gd5d4_g3_menu_lock_wait_start();
+
+        BMP_LOCK(
+            gd5d4_g3_menu_lock_acquired();
+
+            gd5d4_ghost03_mark_menu_pre_5d4();
+
+            rc =
+                test149_5d4_gdraw_present_rgba();
+
+            gd5d4_ghost03_mark_menu_post_5d4(rc);
+
+            if (rc == 0)
+            {
+                uint32_t next =
+                    gd5d4_z31y_menu_generation + 1;
+
+                if (next == 0)
+                    next = 1;
+
+                gd5d4_z31y_menu_generation =
+                    next;
+
+                gd5d4_z31y_menu_active = 1;
+
+                gd5d4_g1_mark_menu_active();
+
+                /*
+                 * GHOST09A:
+                 * successful XIMR present is the authoritative
+                 * completion point of LV -> ML ENTRY.
+                 */
+                gd5d4_z31y_menu_entry_committed();
+            }
+            else
+            {
+                gd5d4_z31y_menu_active = 0;
+            }
+
+            gd5d4_g3_menu_publish_return(rc);
+        )
+
+        gd5d4_g3_menu_lock_released();
+
+        return rc;
+    }
+
+    /*
+     * Historical/non-entry path.
+     * Caller still owns the old complete BMP_LOCK.
+     */
+    rc =
+        test149_5d4_gdraw_present_rgba();
+
+    if (rc == 0)
+    {
+        uint32_t next =
+            gd5d4_z31y_menu_generation + 1;
+
+        if (next == 0)
+            next = 1;
+
+        gd5d4_z31y_menu_generation =
+            next;
+
+        gd5d4_z31y_menu_active = 1;
+
+        /*
+         * G1: first successful ML menu publication.
+         */
+        gd5d4_g1_mark_menu_active();
+
+        /*
+         * GHOST09A defensive commit.
+         */
+        gd5d4_z31y_menu_entry_committed();
+    }
+    else
+    {
+        gd5d4_z31y_menu_active = 0;
+    }
+
+    return rc;
+}
+static volatile int
+testlv2_lv_curtain_visible_5d4 = 0;
