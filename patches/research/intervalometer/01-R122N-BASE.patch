+/*
+ * TESTGM17C-A — wait for hidden Canon PLAY host
+ * in normal shooting.
+ *
+ * At this point:
+ *
+ *   layer1 = frozen shooting GUI
+ *   layer0 = OFF
+ *   ML     = still closed
+ *
+ * Unlike TESTNS16B:
+ *
+ *   NO fake Q
+ *   NO mode 0x29
+ *   NO Q keepalive
+ *
+ * Historical testns16b_* state-variable names are retained
+ * temporarily to keep this first comparison patch surgical.
+ *
+ * No XIMR operation is permitted from this callback.
+ */
+static void
+testgm17c_shoot_play_host_poll_cbr()
+{
+    if (!testns16b_shoot_q_host_pending_5d4)
+        return;
+
+    /*
+     * This transaction belongs only to ordinary non-LV shooting.
+     * Electronic Level remains on its frozen M1 lifecycle.
+     */
+    if (
+        menu_shown ||
+        lv_5d4 ||
+        level_host_active_5d4()
+    )
+    {
+        testns16b_shoot_q_host_pending_5d4 = 0;
+        testns16b_shoot_q_host_poll_count_5d4 = 0;
+        testns16b_shoot_copycat_active_5d4 = 0;
+
+        testlv4_lv_cleanup_pending_5d4 = 1;
+        return;
+    }
+
+    /*
+     * Canon PLAY host committed.
+     *
+     * M1 HW testing already demonstrated that GUIMODE_PLAY
+     * gives ML native logical wheel routing without allowing
+     * MAIN to modify Tv.
+     *
+     * Reuse TESTLV6's dedicated layer1 renderer, but unlike
+     * LiveView there is now a real Canon logical host below it.
+     */
+    if (CURRENT_GUI_MODE == GUIMODE_PLAY)
+    {
+        testns16b_shoot_q_host_pending_5d4 = 0;
+        testns16b_shoot_q_host_poll_count_5d4 = 0;
+
+        testns16b_shoot_copycat_active_5d4 = 1;
+
+        /*
+         * Historical variable name:
+         * here it means "dedicated layer1 ML renderer".
+         */
+        testlv6_lv_menu_no_host_5d4 = 1;
+
+        give_semaphore(gui_sem);
+        return;
+    }
+
+    testns16b_shoot_q_host_poll_count_5d4++;
+
+    if (testns16b_shoot_q_host_poll_count_5d4 < 100)
+    {
+        delayed_call(
+            10,
+            testgm17c_shoot_play_host_poll_cbr,
+            0
+        );
+
+        return;
+    }
+
+    /*
+     * ~1 s timeout.
+     *
+     * Request compositor cleanup from menu_task context.
+     * Do not perform XIMR work here.
+     */
+    testns16b_shoot_q_host_pending_5d4 = 0;
+    testns16b_shoot_q_host_poll_count_5d4 = 0;
+    testns16b_shoot_copycat_active_5d4 = 0;
+
+    /*
+     * If PLAY never committed, request shooting mode again
+     * before revealing Canon.
+     */
+    SetGUIRequestMode(0);
+
+    testlv4_lv_cleanup_pending_5d4 = 1;
+}
