+static void
+gd5d4_z19_add_run(
+    struct gd5d4_z19_state *st,
+    int y,
+    int x0,
+    int x1
+)
+{
+    if (!st || st->full_clear || x1 <= x0)
+        return;
+
+    if (st->count >= GD5D4_Z19_MAX_RUNS)
+    {
+        st->count = 0;
+        st->full_clear = 1;
+        return;
+    }
+
+    struct gd5d4_z19_run *r =
+        &st->runs[st->count++];
+
+    r->y2 = (uint8_t)(y >> 1);
+    r->x0 = (uint8_t)x0;
+    r->x1 = (uint8_t)x1;
+}
