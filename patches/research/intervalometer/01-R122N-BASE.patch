+static void
+gd5d4_g1_mark_exit(void)
+{
+    if (
+        !gd5d4_g1_session ||
+        gd5d4_g1_exit_seen
+    )
+        return;
+
+    gd5d4_g1_exit_ms =
+        (uint32_t)get_ms_clock();
+
+    gd5d4_g1_exit_gen =
+        gd5d4_z31p_commit_generation;
+
+    gd5d4_g1_exit_seen = 1;
+}
