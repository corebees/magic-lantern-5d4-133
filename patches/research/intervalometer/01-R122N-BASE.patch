+/*
+ * GD-D6-GDCORE1
+ *
+ * Generic 5D4 indexed -> dedicated RGBA layer1 publisher.
+ *
+ * Caller owns BMP_LOCK and supplies ML's normal indexed
+ * 720x480 surface. Canon layer0 is never modified.
+ */
+static inline uint32_t gd5d4_graph_fade_rgba(uint32_t px)
+{
+    unsigned int scale = gd5d4_fad05_alpha_scale_5d4;
+    if (scale >= 255U) return px;
+    return (px & 0x00ffffffU) | ((((px >> 24) * scale + 127U) / 255U) << 24);
+}
+static int gd5d4_graph_entry_allowed(void)
+{
+    return !gd5d4_z31y_late_handoff_inhibit &&
+        (gd5d4_z31y_transition_bridge_active || gd5d4_g10t_entry_render);
+}
+
+static int
+gd5d4_publish_indexed_layer1_locked(uint8_t *src)
+{
+    if (!src)
+        return -1;
+
+    if (gd5d4_layer1_menu_entry_pending && !gd5d4_graph_entry_allowed())
+        return -20;
+
+    uint32_t *dst = 0;
+    uint32_t pitch = 0;
+    uint32_t ox = 0;
+    uint32_t oy = 0;
+
+    int rc =
+        test149_5d4_gdraw_begin_rgba(
+            &dst,
+            &pitch,
+            &ox,
+            &oy
+        );
+
+    if (rc != 0 || !dst)
+        return rc ? rc : -1;
+
+    for (uint32_t y = 0; y < 480; y++)
+    {
+        uint8_t *in =
+            src + BM(0, y);
+
+        uint32_t *out =
+            dst + (oy + y) * pitch + ox;
+
+        for (uint32_t x = 0; x < 720; x++)
+            out[x] = gd5d4_graph_fade_rgba(indexed2rgb(in[x]));
+    }
+
+    /*
+     * DELETE may arrive while the frame is being converted.
+     * Never commit a late Global Draw frame after ownership has
+     * synchronously moved to the ML-menu lifecycle.
+     */
+    if (gd5d4_layer1_menu_entry_pending && !gd5d4_graph_entry_allowed())
+        return -20;
+
+    return test149_5d4_gdraw_present_rgba();
+}
