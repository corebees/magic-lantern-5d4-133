+static void menu_close()
+{
+
+
+    if (!menu_shown)
+        return;
+
+
+
+    menu_shown = false;
+
+
+
+    customize_mode = 0;
+    update_disp_mode_bits_from_params();
+
+    lens_focus_stop();
+    menu_lv_transparent_mode = 0;
+
+#ifdef CONFIG_5D4
+    /*
+     * TESTHS5A:
+     *
+     * HS4C3 proved that "ML -> black -> ML -> Canon" contains
+     * no second menu_open().
+     *
+     * The second ML is therefore stale dedicated-layer content.
+     *
+     * Remove that content BEFORE Canon performs PLAY->shooting.
+     * Keep Canon layer0 hidden until the existing post-transition
+     * cleanup restores it.
+     */
+    if (
+        tesths5a_halfshutter_teardown_5d4 &&
+        !lv_5d4 &&
+        DISPLAY_IS_ON &&
+        testlv6_lv_menu_no_host_5d4 &&
+        testns16b_shoot_copycat_active_5d4 &&
+        level_curtain_active_5d4
+    )
+    {
+        test161_5d4_gdraw_blank_keepalive();
+        test147_5d4_gdraw_disable();
+
+        level_curtain_active_5d4 = 0;
+        level_curtain_opaque_5d4 = 0;
+        level_curtain_auto_prearmed_5d4 = 0;
+        testlv2_lv_curtain_visible_5d4 = 0;
+    }
+#endif
+
+    close_canon_menu();
+    canon_gui_enable_front_buffer(0);
+
+
+    #ifdef FEATURE_VRAM_RGBA
+#ifdef CONFIG_5D4
+    /*
+     * In LiveView, clear ML's RGBA contents normally.
+     * Outside LiveView, Canon owns the active RGBA OSD
+     * surface, so do not zero that surface here.
+     */
+    /*
+     * TESTLV6:
+     *
+     * ML never occupied Canon layer0, therefore clrscr() must not
+     * zero Canon's LiveView OSD surface on this close path.
+     */
+    if (
+        lv_5d4 &&
+        !testlv6_lv_menu_no_host_5d4
+    )
+        clrscr();
+#else
+    clrscr();
+#endif
+#endif
+
+#ifdef CONFIG_5D4
+    /*
+     * 5D4: redraw() blocks when closing the ML menu from LiveView.
+     * clrscr() has already removed the ML overlay, so skip this
+     * redraw only while LiveView is active.
+     */
+    if (!lv_5d4)
+        redraw();
+#else
+    redraw();
+#endif
+#ifdef CONFIG_5D4
+    if (ml_menu_opened_from_lv_5d4 || lv_5d4)
+        bmp_on();
+
+    /*
+     * TESTLV6 — safe menu_task-context handoff.
+     *
+     * TESTLV3/4/5 HW PASS established that these XIMR operations
+     * are safe from normal menu_task / GUI-event lifecycle context.
+     *
+     * Keep layer1 visible until Canon layer0 is restored.
+     */
+    if (testlv6_lv_menu_no_host_5d4)
+    {
+        /*
+         * TESTLV15C:
+         *
+         * TESTLV15B-RC3 keeps Canon Quick Control logically
+         * active underneath ML.
+         *
+         * If Canon is still in mode 0x29:
+         *
+         *   DO NOT restore layer0 yet.
+         *   DO NOT remove layer1 yet.
+         *
+         * Keep ML covering the screen and send hidden Q#2 only
+         * after menu_close() has completely returned.
+         */
+        if (
+            CURRENT_GUI_MODE == 0x29 &&
+            (
+                lv_5d4 ||
+                testns16b_shoot_copycat_active_5d4
+            )
+        )
+        {
+            testlv4_lv_cleanup_pending_5d4 = 0;
+
+            testlv15c_lv_q_exit_stage_5d4 = 1;
+            testlv15c_lv_q_exit_poll_count_5d4 = 0;
+
+            /*
+             * TESTNS16F-A — Q-host quiet window.
+             *
+             * TESTNS16E-RC4 proved that merely blocking new
+             * same-state keepalives after root DELETE does not
+             * eliminate the intermittent visible-Q exit.
+             *
+             * Keep layer1 covering the screen for 500 ms before
+             * Q#2, allowing any already-issued Canon/MPU Q refresh
+             * to settle before requesting the opposite transition.
+             *
+             * No XIMR work occurs from the callback.
+             */
+            delayed_call(
+                500,
+                testlv15c_lv_q_exit_cbr,
+                0
+            );
+        }
+        else
+        {
+            /*
+             * Existing TESTLV6 HW-proven fallback.
+             *
+             * If Q host is unexpectedly gone already, restore
+             * Canon immediately exactly as RC3 did.
+             */
+            testlv4_lv_cleanup_pending_5d4 = 0;
+            testlv2_lv_curtain_visible_5d4 = 0;
+
+            if (testlv5_canon_layer0_disabled_5d4)
+            {
+                testlv5_5d4_canon_gui_layer_enable(1);
+                testlv5_canon_layer0_disabled_5d4 = 0;
+            }
+
+            if (level_curtain_active_5d4)
+            {
+                test161_5d4_gdraw_blank_keepalive();
+                test147_5d4_gdraw_disable();
+
+                level_curtain_active_5d4 = 0;
+                level_curtain_opaque_5d4 = 0;
+                level_curtain_auto_prearmed_5d4 = 0;
+            }
+
+            testlv6_lv_menu_no_host_5d4 = 0;
+
+            /*
+             * TESTNS16B:
+             * release normal-shooting copycat ownership too.
+             */
