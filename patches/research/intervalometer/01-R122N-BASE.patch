+/*
+ * Advance only after one successful Zebra XIMR execute.
+ *
+ * step 1 frame was 25%  -> next frame 50%
+ * step 2 frame was 50%  -> next frame 75%
+ * step 3 frame was 75%  -> next frame 100%
+ * step 4 frame was 100% -> EXIT transaction complete
+ */
+/*
+ * GHOST10F-LIVE-FRAME-EXIT-FADE
+ * Advance on successful freshly analysed/rendered frames, without sleeping
+ * or scaling the old surface. Invalid steps retain the GHOST10D latch.
+ */
+static const char gd5d4_g10f_build_marker[] __attribute__((used)) =
+    "GHOST10F-LIVE-FRAME-EXIT-FADE";
+/* GHOST10U: each successful freshly analysed execute advances one level.
+ * Invalid/mismatched states retain the single-flight latch. No sleeps or FIO.
+ * GRAPHS12: all four exit fade frames64/128/192/255 useREADY.
+ */
+static const char gd5d4_g11c_marker[] __attribute__((used)) =
+    "GHOST11C-DYNAMIC-FEATURE-EXIT";
+static const char gd5d4_g11b_marker[] __attribute__((used)) =
+    "GHOST11B-GRAPH-CADENCE-MENU";
