+/*
+ * GHOST09A:
+ * physical root DELETE starts ML -> LV EXIT.
+ *
+ * Do not start the alpha ramp yet: ML is still visible.
+ * Zebra starts at 25% only when menu visibility really drops.
+ */
+/* GHOST10Q: two bounded scalar snapshots, no new trace arrays.
+ * Stages1 handler arrival,2 reject ENTRY,3 reject EXIT,4 gates passed.
+ * Flags: bit0 LV,1 menu shown,2 menu active,3 entry pending,4 exit pending,
+ * 5 paused,6 display on,7 bridge,8 late inhibit,9 dedicated layer active.
+ * Worker flags bit0 owned,bit1 safe; ms is heartbeat, not task liveness proof.
+ * GUI input is sole writer. Sequence prevents dumping partial input records.
+ */
+struct gd5d4_g10q_snapshot
+{
+    uint32_t ms, stage, flags, gui, gui_state, worker_ms, worker_flags;
+    uint32_t gen, ready, active, job_ready;
+};
+static volatile struct gd5d4_g10q_snapshot gd5d4_g10q_last, gd5d4_g10q_rejected;
+static volatile uint32_t gd5d4_g10q_seq, gd5d4_g10q_rejects;
+static uint32_t gd5d4_g10q_dump_seq;
+static volatile uint32_t gd5d4_g10q_worker_ms, gd5d4_g10q_worker_flags;
+static const char gd5d4_g10q_marker[] __attribute__((used)) =
+    "GHOST10Q-DELETE-REJECTION-SNAPSHOT";
+void gd5d4_g10q_delete_snapshot(uint32_t stage)
+{
+    struct gd5d4_g10q_snapshot d;
+    d.ms = (uint32_t)get_ms_clock(); d.stage = stage;
+    d.flags = (lv_5d4 ? 1U : 0U) | (gui_menu_shown() ? 2U : 0U) |
+        (gd5d4_z31y_menu_active ? 4U : 0U) |
+        (gd5d4_layer1_menu_entry_pending ? 8U : 0U) |
+        (gd5d4_z31y_exit_pending ? 16U : 0U) | (lv_paused ? 32U : 0U) |
+        (DISPLAY_IS_ON ? 64U : 0U) |
+        (gd5d4_z31y_transition_bridge_active ? 128U : 0U) |
+        (gd5d4_z31y_late_handoff_inhibit ? 256U : 0U) |
+        (test147_5d4_gdraw_active ? 512U : 0U);
+    d.gui = CURRENT_GUI_MODE; d.gui_state = gui_state;
+    d.worker_ms = gd5d4_g10q_worker_ms;
+    d.worker_flags = gd5d4_g10q_worker_flags;
+    d.gen = gd5d4_z31p_commit_generation;
+    d.ready = DV_VRAM_READY; d.active = DV_VRAM_ACTIVE;
+    d.job_ready = job_state_ready_to_take_pic();
+    gd5d4_g10q_seq++;
+    gd5d4_g10q_last = d;
+    if (stage == 2U || stage == 3U)
+    {
+        gd5d4_g10q_rejected = d;
+        gd5d4_g10q_rejects++;
+    }
+    gd5d4_g10q_seq++;
+}
+static void gd5d4_g10q_dump_if_quiet(void)
+{
+    if (!GD5D4_G10R_DIAG_FIO) return;
+
+    uint32_t seq = gd5d4_g10q_seq;
+    if (!seq || (seq & 1U) || seq == gd5d4_g10q_dump_seq ||
+        (uint32_t)((uint32_t)get_ms_clock() - gd5d4_g10q_last.ms) < 3000U ||
+        !lv_5d4 || !DISPLAY_IS_ON || gui_menu_shown() ||
+        gd5d4_z31y_menu_active || gd5d4_z31y_exit_pending ||
+        CURRENT_GUI_MODE != 0 || gd5d4_g10m_window_active())
+        return;
+    struct gd5d4_g10q_snapshot last = gd5d4_g10q_last;
+    struct gd5d4_g10q_snapshot rejected = gd5d4_g10q_rejected;
+    uint32_t rejects = gd5d4_g10q_rejects;
+    if (seq != gd5d4_g10q_seq) return;
+    FILE *f = FIO_CreateFileOrAppend("ML/LOGS/Z31YG4.TXT");
+    if (!f) return;
+    my_fprintf(f, "GHOST10Q-DELETE-REJECTION-SNAPSHOT seq=%08x rejects=%08x dump_ms=%08x\n",
+        seq, rejects, (uint32_t)get_ms_clock());
+    for (unsigned i = 0; i < 2; i++)
+    {
+        struct gd5d4_g10q_snapshot *d = i ? &rejected : &last;
+        my_fprintf(f, "GHOST10Q kind=%08x ms=%08x stage=%08x flags=%08x gui=%08x state=%08x worker_ms=%08x worker_flags=%08x gen=%08x ready=%08x active=%08x job=%08x\n",
+            i, d->ms, d->stage, d->flags, d->gui, d->gui_state,
+            d->worker_ms, d->worker_flags, d->gen, d->ready, d->active, d->job_ready);
+    }
+    FIO_CloseFile(f);
+    gd5d4_g10q_dump_seq = seq;
+}
