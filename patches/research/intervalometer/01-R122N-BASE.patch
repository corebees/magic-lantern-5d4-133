+/*
+ * GD-D6-ZEBRA31W
+ *
+ * OVER presentation states:
+ *
+ *   0 = transparent
+ *   1 = threshold feather
+ *   2 = normal Zebra
+ *
+ * State 1 is exactly the first luma code above threshold.
+ * No extra YUV read is required.
+ */
+static inline uint8_t
+gd5d4_z31w_over_state(
+    int Y,
+    int zlh
+)
+{
+    if (Y <= zlh)
+        return 0;
+
+    if (Y == zlh + 1)
+        return 1;
+
+    return 2;
+}
