+/*
+ * FAD04A-SYNC-PREHOST-FADEOUT
+ *
+ * Scale alpha only on the currently visible dedicated RGBA layer1
+ * surface. No front/back switch and no layer reconfiguration.
+ *
+ * Caller controls serialization and timing.
+ */
+int
+testfad04a_5d4_gdraw_scale_visible_alpha(
+    unsigned int num,
+    unsigned int den
+)
+{
+    if (!den)
+        return -1;
+
+    uint32_t *buf = 0;
+    uint32_t pitch = 0;
+    uint32_t ox = 0;
+    uint32_t oy = 0;
+
+    int rc =
+        test31d_5d4_gdraw_begin_visible_rgba(
+            &buf,
+            &pitch,
+            &ox,
+            &oy
+        );
+
+    if (rc != 0 || !buf)
+        return rc ? rc : -2;
+
+    for (uint32_t y = 0; y < 480; y++)
+    {
+        uint32_t *row =
+            buf +
+            (oy + y) * pitch +
+            ox;
+
+        for (uint32_t x = 0; x < 720; x++)
+        {
+            uint32_t px = row[x];
+            uint32_t a = px >> 24;
+
+            if (!a)
+                continue;
+
+            uint32_t new_a =
+                (a * num + den / 2) / den;
+
+            if (new_a > 255)
+                new_a = 255;
+
+            row[x] =
+                (px & 0x00FFFFFFU) |
+                (new_a << 24);
+        }
+    }
+
+    return test31e_5d4_gdraw_execute_visible();
+}
