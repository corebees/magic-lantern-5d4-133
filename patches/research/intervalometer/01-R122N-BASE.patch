+#ifdef FEATURE_WAVEFORM
+/*
+ * GD-D6-ZEBRA27J-A-FULLSCREEN-XIMR
+ *
+ * Fullscreen Waveform keeps upstream's exclusive semantics:
+ * Zebra is not composited while Fullscreen is selected.
+ *
+ * Avoid an additional ~1.4 MiB RGBA cache.  hist_build() already
+ * produces the compact 180x120 Waveform analysis buffer; expand
+ * that directly into the inactive dedicated layer1 backbuffer.
+ */
+static int
+gd5d4_render_fullscreen_waveform_rgba_locked(void)
+{
+    if (!waveform_draw || waveform_size != 2)
+        return -30;
+
+    if (gd5d4_layer1_menu_entry_pending && !gd5d4_graph_entry_allowed())
+        return -20;
+
+    /*
+     * Preserve upstream Fullscreen half-shutter semantics:
+     * temporarily hide the graph rather than presenting stale data.
+     */
+    if (get_halfshutter_pressed())
+    {
+        uint32_t *blank = 0;
+        uint32_t pitch = 0;
+        uint32_t ox = 0;
+        uint32_t oy = 0;
+
+        int rc =
+            test149_5d4_gdraw_begin_rgba(
+                &blank,
+                &pitch,
+                &ox,
+                &oy
+            );
+
+        if (rc != 0 || !blank)
+            return rc ? rc : -31;
+
+        if (gd5d4_layer1_menu_entry_pending && !gd5d4_graph_entry_allowed())
+            return -20;
+
+        return test149_5d4_gdraw_present_rgba();
+    }
+
+    /*
+     * One low-cadence YUV scan.
+     * Histogram may also be enabled in configuration, but upstream
+     * intentionally does not DISPLAY Histogram in Fullscreen mode.
+     */
+    hist_build();
+
+    if (!waveform)
+        return -32;
+
+    if (gd5d4_layer1_menu_entry_pending && !gd5d4_graph_entry_allowed())
+        return -20;
+
+    uint32_t *dst = 0;
+    uint32_t pitch = 0;
+    uint32_t ox = 0;
+    uint32_t oy = 0;
+
+    /*
+     * begin_rgba() clears the complete visible 720x480 region.
+     * Fullscreen subsequently overwrites every logical pixel.
+     */
+    int rc =
+        test149_5d4_gdraw_begin_rgba(
+            &dst,
+            &pitch,
+            &ox,
+            &oy
+        );
+
+    if (rc != 0 || !dst)
+        return rc ? rc : -33;
+
+    gd5d4_waveform_palette_init();
+
+
+    /* WAVEFORM01: classify each compact cell once, then expand its exact
+     * RGBA value to the same 4x4 block. Preserve source, palette, fade and
+     * presentation order; no additional cache or memory allocation.
+     */
+    for (int src_y = WAVEFORM_HEIGHT - 1; src_y >= 0; src_y--)
+    {
+        const int wf_row = WAVEFORM_HEIGHT - src_y - 1;
+        for (int x = 0; x < WAVEFORM_WIDTH; x++)
+        {
+            uint32_t count = (waveform[x + wf_row * WAVEFORM_WIDTH] * 42U) >> 7;
+            int pal;
+            if (count > 37U) pal = COLOR_RED;
+            else if (count > 0U) pal = count + 43;
+            else if (src_y == ((WAVEFORM_HEIGHT * 1) >> 2)) pal = COLOR_BLUE;
+            else if (src_y == ((WAVEFORM_HEIGHT * 2) >> 2)) pal = 0xE;
+            else if (src_y == ((WAVEFORM_HEIGHT * 3) >> 2)) pal = COLOR_BLUE;
+            else pal = waveform_bg;
+            const uint32_t rgba = gd5d4_graph_fade_rgba(gd5d4_waveform_rgba_lut[pal & 0xFF]);
+            for (int ky = 0; ky < 4; ky++)
+            {
+                uint32_t *out = dst + (oy + src_y * 4 + ky) * pitch + ox + x * 4;
+                out[0] = rgba; out[1] = rgba; out[2] = rgba; out[3] = rgba;
+            }
+        }
+    }
+
+    if (gd5d4_layer1_menu_entry_pending && !gd5d4_graph_entry_allowed())
+        return -20;
+
+    return test149_5d4_gdraw_present_rgba();
+}
+#endif
