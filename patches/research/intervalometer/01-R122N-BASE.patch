+/*
+ * GD-D6-ZEBRA5-DIRECT-RGBA
+ *
+ * Fast 5D4 Luma Zebra path.
+ *
+ * Unlike Histogram/Waveform, Zebra does not build the complete
+ * indexed 720x480 surface and then convert every pixel to RGBA.
+ *
+ * begin_rgba() already gives us a transparent layer1 frame.
+ * Draw only Zebra pixels directly into that RGBA surface.
+ */
+#ifdef FEATURE_ZEBRA
+
+/*
+ * GD-D6-ZEBRA29A-DELTA-CELL
+ *
+ * Write the exact six-row classic ML Zebra pattern into one 4x6
+ * display cell. Passing color=0 erases only the pixels which can
+ * belong to this pattern.
+ */
+static inline void
+gd5d4_z29a_write_classic6(
+    uint32_t *out[6],
+    int x,
+    int y,
+    uint32_t color
+)
+{
+    /*
+     * GD-D6-ZEBRA29N-MID-SPACING-HYSTERESIS
+     *
+     * Continuous 45-degree Zebra bands.
+     *
+     *   band width : 2 pixels
+     *   period     : 6 pixels
+     *   clear gap  : 4 pixels
+     *
+     * Absolute x/y phase keeps each diagonal continuous across
+     * 4x6 DELTA-CELL boundaries.
+     */
+    for (int yy = 0; yy < 6; yy++)
+    {
+        uint32_t *row = out[yy];
+
+        for (int xx = 0; xx < 4; xx++)
+        {
+            const int phase =
+                (
+                    x + xx +
+                    1024 -
+                    (y + yy)
+                ) % 6;
+
+            if (phase < 2)
+                row[x + xx] = color;
+        }
+    }
+}
+
