+/* FOCUS01: RGBA dots from the local upstream Laplacian and color map.
+ * Standalone only, BMP_LOCK owned; no writes to Canon YUV or legacy BMP.
+ */
+
+#ifdef CONFIG_5D4
+
+/*
+ * LIVEGND MASK01-B
+ *
+ * Dedicated static RGBA renderer.
+ *
+ * No YUV access is required: this is only a visual guide.
+ * The existing 5D4 visible-layer lifecycle owns begin/execute.
+ */
+static int
+gd5d4_render_live_gnd_locked(void)
+{
+    if (!gd5d4_live_gnd_scope())
+        return -40;
+
+    if (!(global_draw & 1))
+        return -41;
+
+    if (
+        gui_menu_shown() ||
+        gd5d4_z31y_menu_active
+    )
+        return -20;
+
+    if (
+        gd5d4_layer1_menu_entry_pending &&
+        !gd5d4_graph_entry_allowed()
+    )
+        return -20;
+
+    /*
+     * Ordinary publication requires stable LiveView.
+     *
+     * Entry bridge / fade is already an established 5D4 lifecycle
+     * and may temporarily run through the invisible 0x4A host.
+     */
+    if (
+        !gd5d4_g10t_entry_render &&
+        !gd5d4_z31y_transition_bridge_active &&
+        (
+            !lv_5d4 ||
+            lv_paused ||
+            !DISPLAY_IS_ON ||
+            PLAY_OR_QR_MODE ||
+            CURRENT_GUI_MODE != 0 ||
+            gui_state != GUISTATE_IDLE ||
+            !job_state_ready_to_take_pic()
+        )
+    )
+        return -42;
+
+    uint32_t *dst = 0;
+    uint32_t pitch = 0;
+    uint32_t ox = 0;
+    uint32_t oy = 0;
+
+    int rc =
+        test31d_5d4_gdraw_begin_visible_rgba(
+            &dst,
+            &pitch,
+            &ox,
+            &oy
+        );
+
+    if (rc != 0 || !dst)
+        return rc ? rc : -43;
+
+    /*
+     * Standalone MASK01 owns the whole logical ML layer.
+     * Start from transparent on every prototype frame so no
+     * menu/overlay pixels can survive lifecycle transitions.
+     */
+    for (unsigned y = 0; y < 480U; y++)
+    {
+        memset(
+            dst + (oy + y) * pitch + ox,
+            0,
+            720U * sizeof(uint32_t)
+        );
+    }
+
+    const int center_y = 240;
+
+    /*
+     * Hard: narrow transition.
+     * Soft: deliberately wide transition.
+     *
+     * These widths are visual placeholders only; they do not yet
+     * represent a calibrated optical GND profile.
+     */
+    const int half_width =
+        live_gnd_soft ? 72 : 12;
+
+    const int top =
+        MAX(0, center_y - half_width);
+
+    const int bottom =
+        MIN(479, center_y + half_width);
+
+    const int span =
+        MAX(1, bottom - top);
+
+    uint32_t cyan =
+        gd5d4_graph_fade_rgba(
+            indexed2rgb(COLOR_CYAN)
+        );
+
+    uint32_t white =
+        gd5d4_graph_fade_rgba(
+            indexed2rgb(COLOR_WHITE)
+        );
+
+    /*
+     * Ordered sparse mask:
+     *
+     * upper edge = denser
+     * lower edge = progressively transparent
