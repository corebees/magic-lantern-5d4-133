+void
+gd5d4_g1_mark_raw4a(uint32_t post)
+{
+    if (!gd5d4_g1_session)
+        return;
+
+    if (post)
+    {
+        if (!gd5d4_g1_raw4a_post_ms)
+            gd5d4_g1_raw4a_post_ms =
+                (uint32_t)get_ms_clock();
+    }
+    else
+    {
+        if (!gd5d4_g1_raw4a_pre_ms)
+            gd5d4_g1_raw4a_pre_ms =
+                (uint32_t)get_ms_clock();
+    }
+}
+
+void
+gd5d4_g1_mark_gs_poll(
+    uint32_t gui,
+    uint32_t gen_before,
+    uint32_t gen_now,
+    uint32_t busy
+)
+{
+    if (!gd5d4_g1_session)
+        return;
+
+    uint32_t now =
+        (uint32_t)get_ms_clock();
+
+    gd5d4_g1_gs_gen_before =
+        gen_before;
+
+    if (
+        !gd5d4_g1_gui4a_seen_ms &&
+        gui == 0x4A
+    )
+    {
+        gd5d4_g1_gui4a_seen_ms =
+            now;
+    }
+
+    if (
+        !gd5d4_g1_gs_gen_changed_ms &&
+        gen_now != gen_before
+    )
+    {
+        gd5d4_g1_gs_gen_changed_ms =
+            now;
+
+        gd5d4_g1_gs_gen_at_change =
+            gen_now;
+
+        gd5d4_g1_gs_busy_at_change =
+            busy;
+    }
+
+    if (
+        !gd5d4_g1_gs_busy_zero_ms &&
+        gen_now != gen_before &&
+        busy == 0
+    )
+    {
+        gd5d4_g1_gs_busy_zero_ms =
+            now;
+
+        gd5d4_g1_gs_gen_at_busy_zero =
+            gen_now;
+    }
+}
+
+
+void
+gd5d4_g1_mark_gs_handoff(
+    uint32_t gen_before,
+    uint32_t gen_now,
+    uint32_t busy
+)
+{
+    if (
+        !gd5d4_g1_session ||
+        gd5d4_g1_gs_handoff_ms
+    )
+        return;
+
+    gd5d4_g1_gs_handoff_ms =
+        (uint32_t)get_ms_clock();
+
+    gd5d4_g1_gs_gen_before =
+        gen_before;
+
+    gd5d4_g1_gs_gen_at_handoff =
+        gen_now;
+
+    gd5d4_g1_gs_busy_at_handoff =
+        busy;
+}
+
+
+void
+gd5d4_g1_mark_mode4a(void)
+{
+    if (
+        !gd5d4_g1_session ||
+        gd5d4_g1_mode4a_ms
+    )
+        return;
+
+    gd5d4_g1_mode4a_ms =
+        (uint32_t)get_ms_clock();
+
+    gd5d4_g1_mode4a_gen =
+        gd5d4_z31p_commit_generation;
+
+    gd5d4_g2_mode4a_slot =
