+/*
+ * GD-D6-ZEBRA27I-A-LARGE-WAVEFORM-FASTPATH
+ *
+ * Large Waveform uses the same 180x120 low-priority analysis cache
+ * as Small, but reproduces the legacy factor=2 presentation:
+ *
+ *   width  = 180 * 2 = 360
+ *   height = 120 * 2 = 240
+ *
+ * On the 5D4 3:2 logical overlay this corresponds to the legacy
+ * placement near the right side at x=356, y=100.
+ *
+ * This first candidate intentionally performs the RGBA expansion
+ * in the READY path so hardware can tell us whether pre-rendering
+ * is actually necessary.
+ */
+static void
+gd5d4_draw_large_waveform_rgba_cached(
+    uint32_t *dst,
+    uint32_t pitch,
+    uint32_t ox,
+    uint32_t oy
+)
+{
+    if (!dst)
+        return;
+
+    if (!waveform_draw || waveform_size != 1)
+        return;
+
+    int cache_index =
+        gd5d4_waveform_cache_index;
+
+    if (cache_index < 0)
+        return;
+
+    const uint8_t *wf =
+        gd5d4_waveform_cache[cache_index];
+
+    gd5d4_waveform_palette_init();
+
+
+    const int factor = 2;
+    const int width =
+        WAVEFORM_WIDTH * factor;
+    const int height =
+        WAVEFORM_HEIGHT * factor;
+
+    const int x_origin =
+        os.x_max - width - 4;
+
+    const int y_origin =
+        os.y0 + 100;
+
+    for (int y = WAVEFORM_HEIGHT - 1; y >= 0; y--)
+    {
+        const int src_row = WAVEFORM_HEIGHT - y - 1;
+        const int y_bmp = y_origin + y * factor;
+        if (y_bmp < 0 || y_bmp + factor > 480) continue;
+        uint32_t *out = dst + (oy + y_bmp) * pitch + ox + x_origin;
+        for (int x = 0; x < WAVEFORM_WIDTH; x++)
+        {
+                uint32_t count =
+                    wf[
+                        x +
+                        src_row * WAVEFORM_WIDTH
+                    ];
+
+                count =
+                    (count * 42) >> 7;
+
+                int pal;
+
+                if (count > 42 - 5)
+                {
+                    pal = COLOR_RED;
+                }
+                else if (count > 0)
+                {
+                    pal = count + 38 + 5;
+                }
+                else if (
+                    y ==
+                    (WAVEFORM_HEIGHT * 1) >> 2
+                )
+                {
+                    pal = COLOR_BLUE;
+                }
+                else if (
+                    y ==
+                    (WAVEFORM_HEIGHT * 2) >> 2
+                )
+                {
+                    pal = 0xE;
+                }
+                else if (
+                    y ==
+                    (WAVEFORM_HEIGHT * 3) >> 2
+                )
+                {
+                    pal = COLOR_BLUE;
+                }
+                else
+                {
+                    pal = waveform_bg;
+                }
+
+            uint32_t px = gd5d4_graph_fade_rgba(gd5d4_waveform_rgba_lut[pal & 0xFF]);
+            for (int kx = 0; kx < factor; kx++) out[x * factor + kx] = px;
+        }
+        for (int ky = 1; ky < factor; ky++)
+            memcpy(out + ky * pitch, out, width * sizeof(uint32_t));
+    }
+
+    const uint32_t border =
+        gd5d4_graph_fade_rgba(gd5d4_waveform_rgba_lut[60]);
+
+    const int bx0 = x_origin - 1;
+    const int by0 = y_origin - 1;
+    const int bx1 = x_origin + width;
+    const int by1 = y_origin + height;
+
+    uint32_t *top =
+        dst + (oy + by0) * pitch + ox;
+
+    uint32_t *bottom =
+        dst + (oy + by1) * pitch + ox;
+
+    for (int x = bx0; x <= bx1; x++)
+    {
+        top[x] = border;
+        bottom[x] = border;
+    }
+
+    for (int y = by0; y <= by1; y++)
+    {
+        uint32_t *row =
+            dst + (oy + y) * pitch + ox;
+
+        row[bx0] = border;
+        row[bx1] = border;
+    }
+}
+#endif
