+     *
+     * Normal flat regions:
+     *     1 Y read per 4x6 cell.
+     *
+     * Vertical threshold transition:
+     *     3 Y reads for that 4x6 cell.
+     *
+     * Presentation remains classic ML diagonal Zebra.
+     */
+    if (
+        zebra_draw &&
+        zebra_colorspace == 0 &&
+        lv_luma_is_accurate() &&
+        (zebra_rec || NOT_RECORDING)
+    )
+    {
+        struct vram_info *lv_info =
+            get_yuv422_vram();
+
+        /*
+         * GD-D6-ZEBRA31Y-G6J3A-R2-BRIDGE-ACTIVE-SOURCE
+         *
+         * Normal LiveView keeps the established READY source.
+         *
+         * During the Z31Y entry bridge the worker is awakened by
+         * Canon's READY -> ACTIVE commit.  ACTIVE is then the
