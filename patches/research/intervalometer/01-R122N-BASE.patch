+// pump a few redraws quickly, to mask Canon's back menu
+void menu_redraw_flood()
+{
+#ifdef CONFIG_5D4
+    /*
+     * 5D4: start the redraw flood immediately outside LiveView
+     * to minimize exposure of the underlying Canon GUI.
+     * Keep the external-monitor LiveView delay unchanged.
+     */
+    if (lv_5d4 && EXT_MONITOR_CONNECTED)
+        msleep(300);
+#else
+    if (!lv) msleep(100);
+    else if (EXT_MONITOR_CONNECTED) msleep(300);
+#endif
+    for (int i = 0; i < 5; i++)
+    {
+        if (redraw_flood_stop) break;
+        if (!menu_shown) break;
+        canon_gui_enable_front_buffer(0);
+        menu_redraw_full();
+        msleep(20);
+    }
+#ifdef FEATURE_VRAM_RGBA
+    // force redraw now, it looks glitchy if you only set ml_refresh_display_needed
+    refresh_yuv_from_rgb();
+#endif
+    msleep(50);
+
+#ifdef CONFIG_5D4
+
+    /*
+     * Keep the frozen level curtain until ML has completed the redraw
+     * flood and final RGBA publication. Removing it earlier exposes a
+     * late Canon backing-GUI frame.
+     */
+    if (level_ml_entry_armed_5d4)
+    {
+        if (menu_shown)
+        {
+            menu_redraw_full();
+
+#ifdef FEATURE_VRAM_RGBA
+            refresh_yuv_from_rgb();
+#endif
+        }
+
+        /*
+         * HW-proven N-A graceful transparent -> disable sequence.
+         */
+        level_curtain_disable_5d4();
+        level_ml_entry_armed_5d4 = 0;
+    }
+#endif
+
+    redraw_flood_stop = 1;
+}
+
+static void start_redraw_flood()
+{
+    redraw_flood_stop = 0;
+    task_create("menu_redraw_flood", 0x1c, 0, menu_redraw_flood, 0);
+}
