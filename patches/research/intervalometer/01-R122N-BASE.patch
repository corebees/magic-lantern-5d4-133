+void
+gd5d4_z31y_menu_exit_arm(void)
+{
+    /* GRAPHS08: an explicit root CLOSE supersedes unfinished ENTRY.
+     * Caller is menu.c's physical root DELETE with menu_shown true.
+     * Retire it under the render lock before arming the EXIT transaction.
+     */
+    BMP_LOCK(
+        if (gui_menu_shown() && gd5d4_layer1_menu_entry_pending)
+        {
+            gd5d4_layer1_menu_entry_pending = 0;
+            gd5d4_z31y_late_handoff_inhibit = 0;
+            gd5d4_z31y_transition_bridge_active = 0;
+            gd5d4_z19_reset = 1;
+        }
+    )
+
+    if (gd5d4_z31y_exit_pending)
+        return;
+
+    gd5d4_g10c_exit_arm_ms =
+        (uint32_t)get_ms_clock();
+
+    for (unsigned i = 0; i < 11; i++)
+        gd5d4_g10e_phase[i] = 0;
+    gd5d4_g10e_attempts = 0;
+    gd5d4_g10m_post_ms = 0;
+    gd5d4_g10p_sample_ms = 0;
+    gd5d4_g10j_count = 0;
+    gd5d4_g10j_dropped = 0;
+    gd5d4_g10g_count = 0;
+    gd5d4_g10g_dropped = 0;
+    gd5d4_g10c_menu_drop_ms = 0;
+    gd5d4_g10c_safe_lv_ms = 0;
+    gd5d4_g10c_clear_ms = 0;
+    gd5d4_g10c_postexit_zebra_ms = 0;
+    gd5d4_g10c_release_ms = 0;
+    gd5d4_g10c_blocked_ms = 0;
+
+    gd5d4_g10c_fade_rc = 0x7fffffff;
+    gd5d4_g10c_complete_dumped = 0;
+    gd5d4_g10c_blocked_dumped = 0;
+
+    gd5d4_z31y_exit_pending = 1;
+    gd5d4_z31y_exit_fade_step = 0;
+    gd5d4_z31y_exit_buffers_cleared = 0;
+}
