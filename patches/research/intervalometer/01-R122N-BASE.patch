+/*
+ * GD-D6-ZEBRA31Y-G6J2A-EARLY-YUV-FREEZE
+ *
+ * Hardware research candidate.
+ *
+ * Goal:
+ *
+ *   DELETE
+ *     -> stop Zebra publication
+ *     -> very quickly duplicate currently displayed ACTIVE YUV
+ *     -> redirect DV_VRAM_ACTIVE to that frozen copy
+ *     -> build existing G6J1 full RGBA composite
+ *        while background is already static
+ *     -> restore Canon YUV ownership
+ *     -> continue existing 0x4A / ML menu lifecycle
+ *
+ * Current 5D4 YUV geometry:
+ *
+ *     physical pitch = 928 * 2 bytes
+ *     height         = 600
+ *     bytes          = 1,113,600
+ *
+ * Buffer is allocated once during ordinary Zebra operation,
+ * never at DELETE time.
+ *
+ * This is intentionally independent from
+ * CONFIG_CAN_REDIRECT_DISPLAY_BUFFER_EASILY, which is not enabled
+ * on the current 5D4 build.
+ */
+
+#define GD5D4_G6J2_YUV_PITCH   (928U * 2U)
+#define GD5D4_G6J2_YUV_HEIGHT  600U
+#define GD5D4_G6J2_YUV_BYTES   \
+    (GD5D4_G6J2_YUV_PITCH * GD5D4_G6J2_YUV_HEIGHT)
+
+static uint8_t *
+gd5d4_g6j2_yuv_raw = 0;
+
+static uint8_t *
+gd5d4_g6j2_yuv_draw = 0;
+
+static volatile int
+gd5d4_g6j2_yuv_alloc_attempted = 0;
+
+static volatile int
+gd5d4_g6j2_yuv_freeze_active = 0;
+
+static volatile uint32_t
+gd5d4_g6j2_saved_active = 0;
+
+
+/*
+ * Allocate once outside the DELETE critical path.
+ *
+ * Same general policy as the dedicated 5D4 RGBA backend:
+ * allocate persistent display memory once and retain it.
+ */
+static int
+gd5d4_g6j2_prepare_yuv_buffer(void)
+{
+    if (gd5d4_g6j2_yuv_draw)
+        return 0;
+
+    if (gd5d4_g6j2_yuv_alloc_attempted)
+        return -910;
+
+    gd5d4_g6j2_yuv_alloc_attempted = 1;
+
+    gd5d4_g6j2_yuv_raw =
+        malloc(
+            GD5D4_G6J2_YUV_BYTES +
+            0x100
+        );
+
+    if (!gd5d4_g6j2_yuv_raw)
+        return -911;
+
+    gd5d4_g6j2_yuv_draw =
+        (uint8_t *)
+        (
+            (
+                (uintptr_t)
+                    gd5d4_g6j2_yuv_raw +
+                0xFFU
+            ) &
+            ~((uintptr_t)0xFFU)
+        );
+
+    memset(
+        gd5d4_g6j2_yuv_draw,
+        0,
+        GD5D4_G6J2_YUV_BYTES
+    );
+
+    sync_caches();
+
+    return 0;
+}
+
+
+/*
+ * Start YUV freeze.
+ *
+ * IMPORTANT:
+ * this function does NOT wait for another frame.
+ *
+ * It copies the ACTIVE buffer that is on screen when DELETE is
+ * handled, publishes the copy through DV_VRAM_ACTIVE and returns.
+ */
+/*
+ * GD-D6-ZEBRA31Y-G6J2B-EARLY-ACTIVE-PIN
+ *
+ * G6J2A copied ~1.1 MB before redirecting the display and HW
+ * proved that this still allowed visible Zebra/background
+ * separation before the freeze.
+ *
+ * G6J2B performs NO COPY in the critical DELETE path.
+ *
+ * Capture the address of the frame that is on screen right now
+ * and pin pActive to that exact Canon buffer.
+ *
+ * This should take only a few CPU instructions.
+ */
+int
+gd5d4_g6j2_yuv_freeze_begin(void)
+{
+    if (
+        !lv_5d4 ||
+        !DISPLAY_IS_ON ||
+        CURRENT_GUI_MODE != 0 ||
+        gd5d4_g6j2_yuv_freeze_active
+    )
+    {
+        return -920;
+    }
+
+    uint32_t active =
+        DV_VRAM_ACTIVE;
+
+    if (
+        !active ||
+        active == 0x01000000
+    )
+    {
+        return -922;
+    }
+
+    gd5d4_g6j2_saved_active =
+        active;
+
+    gd5d4_g6j2_yuv_freeze_active =
+        1;
+
+    /*
+     * Intentionally write back the exact address already being
+     * displayed.
+     *
+     * Subsequent keepalive calls prevent Canon's normal ACTIVE
+     * rotation from becoming visible during the short transition.
+     */
+    DV_VRAM_ACTIVE =
+        gd5d4_g6j2_saved_active;
+
+    return 0;
+}
+
+
+/*
+ * Canon may rewrite pActive at frame boundaries.
+ *
+ * Reassert our frozen pointer during G6J1 construction.
+ * This write is cheap and bounded to the short transition window.
+ */
+static inline void
+gd5d4_g6j2_yuv_freeze_keepalive(void)
+{
+    if (
+        gd5d4_g6j2_yuv_freeze_active &&
+        gd5d4_g6j2_saved_active
+    )
+    {
+        DV_VRAM_ACTIVE =
+            gd5d4_g6j2_saved_active;
+    }
+}
+
+
+/*
+ * Relinquish YUV ownership.
+ *
+ * Prefer Canon READY if it is valid and different from our
+ * private freeze buffer. Otherwise restore the ACTIVE address
+ * saved before redirect.
+ */
+void
+gd5d4_g6j2_yuv_freeze_end(void)
+{
+    if (!gd5d4_g6j2_yuv_freeze_active)
+        return;
+
+    uint32_t resume =
+        DV_VRAM_READY;
+
+    if (
+        !resume ||
+        resume == 0x01000000
+    )
+    {
+        resume =
+            gd5d4_g6j2_saved_active;
+    }
+
+    /*
+     * Drop software ownership before returning Canon's current
+     * READY frame to display.
+     */
+    gd5d4_g6j2_yuv_freeze_active =
+        0;
+
+    if (
+        resume &&
+        resume != 0x01000000
+    )
+    {
+        DV_VRAM_ACTIVE =
+            resume;
+    }
+
+    gd5d4_g6j2_saved_active =
+        0;
+}
+
+
+int
+gd5d4_g6j1_present_snapshot(void)
+{
+    if (
+        !lv_5d4 ||
+        !DISPLAY_IS_ON ||
+        CURRENT_GUI_MODE != 0 ||
+        !test147_5d4_gdraw_active
+    )
+    {
+        return -900;
+    }
+
+    /*
+     * Refresh BM -> LV geometry.
+     */
+    struct vram_info *lv_info =
+        get_yuv422_vram();
+
+    const uint32_t active_addr =
+        DV_VRAM_ACTIVE;
+
+    if (!lv_info || !active_addr)
+        return -901;
+
+    /*
+     * ACTIVE is intentional:
+     * this is the LiveView frame actually displayed underneath
+     * the Zebra when DELETE is pressed.
+     */
+    uint8_t *lvram =
+        (uint8_t *)CACHEABLE(active_addr);
+
+
+    /*
+     * Exact Zebra surface currently visible to the user.
+     */
+    uint32_t *zebra_src = 0;
+    uint32_t zebra_pitch = 0;
+    uint32_t zebra_ox = 0;
+    uint32_t zebra_oy = 0;
+
+    int rc =
+        test31d_5d4_gdraw_begin_visible_rgba(
+            &zebra_src,
+            &zebra_pitch,
+            &zebra_ox,
+            &zebra_oy
+        );
+
+    if (rc != 0 || !zebra_src)
+        return rc ? rc : -902;
+
+
+    /*
+     * Reacquire current Canon GUI layer0.
+     *
+     * Same geometry convention already used by the existing
+     * hardware-tested 5D4 curtain code:
+     *
+     *     960x540 -> visible 720x480 at +120,+30
+     */
+    uint8_t *canon_buf =
+        rgb_vram_preinit();
+
+    struct MARV *canon =
+        rgb_vram_info;
+
+    const uint32_t *canon_src = 0;
+
+    uint32_t canon_w = 0;
+    uint32_t canon_h = 0;
+    uint32_t canon_ox = 0;
+    uint32_t canon_oy = 0;
+
+    if (
+        canon_buf &&
+        canon &&
+        canon->bitmap_data &&
+        canon->width &&
+        canon->height
+    )
+    {
+        canon_w = canon->width;
+        canon_h = canon->height;
+
+        canon_ox =
+            canon_w >= 960 ? 120U : 0U;
+
+        canon_oy =
+            canon_h >= 540 ? 30U : 0U;
+
+        if (
+            canon_w >= canon_ox + 720U &&
+            canon_h >= canon_oy + 480U
+        )
+        {
+            canon_src =
+                (const uint32_t *)
+                    canon->bitmap_data;
+        }
+    }
+
+
+    /*
+     * Acquire inactive dedicated layer1 surface.
+     *
+     * noclear is intentional: every output pixel is overwritten.
+     */
+    uint32_t *dst = 0;
+    uint32_t pitch = 0;
+    uint32_t ox = 0;
+    uint32_t oy = 0;
+
+    rc =
+        test162_5d4_gdraw_begin_rgba_noclear(
+            &dst,
+            &pitch,
+            &ox,
+            &oy
+        );
+
+    if (rc != 0 || !dst)
+        return rc ? rc : -903;
+
+    if (dst == zebra_src)
+        return -904;
+
+
+    /*
+     * Build opaque 720x480 snapshot.
+     *
+     * Current hardware-tuned G6F mapping is MAP900.
+     *
+     * One RGB conversion is used for each UYVY pixel pair.
+     * This is a short transition curtain, not the realtime Zebra
+     * renderer; minimizing DELETE latency is preferred here.
+     */
+    for (int y = 0; y < 480; y++)
+    {
+        /*
+         * G6J2A:
+         * Canon may refresh pActive asynchronously.
+         * Keep the YUV curtain asserted while G6J1 performs the
+         * expensive RGB/alpha construction.
+         */
+        gd5d4_g6j2_yuv_freeze_keepalive();
+
+        uint32_t *vrow =
+            (uint32_t *)
+                (lvram + BM2LV_R(y));
+
+        uint32_t *out =
+            dst +
+            (oy + (uint32_t)y) *
+                pitch +
+            ox;
+
+        const uint32_t *zrow =
+            zebra_src +
+            (zebra_oy + (uint32_t)y) *
+                zebra_pitch +
+            zebra_ox;
+
+        const uint32_t *crow = 0;
+
+        if (canon_src)
+        {
+            crow =
+                canon_src +
+                (canon_oy + (uint32_t)y) *
+                    canon_w +
+                canon_ox;
+        }
+
+        for (int x = 0; x < 720; x += 2)
+        {
+            const int lv_x =
+                (x * 900) / 720;
+
+            const uint32_t uyvy =
+                vrow[lv_x >> 1];
+
+            int Y;
+            int R;
+            int G;
+            int B;
+
+            COMPUTE_UYVY2YRGB(
+                uyvy,
+                Y,
+                R,
+                G,
+                B
+            );
+
+            (void)Y;
+
+            const uint32_t base =
+                0xFF000000U |
+                (((uint32_t)R & 0xFFU) << 16) |
+                (((uint32_t)G & 0xFFU) << 8) |
+                ((uint32_t)B & 0xFFU);
+
+            for (int dx = 0; dx < 2; dx++)
+            {
+                const int px =
+                    x + dx;
+
+                uint32_t composite =
+                    base;
+
+                if (crow)
+                {
+                    composite =
+                        gd5d4_g6j1_flatten_rgba(
+                            composite,
+                            crow[px]
+                        );
+                }
+
+                composite =
+                    gd5d4_g6j1_flatten_rgba(
+                        composite,
+                        zrow[px]
+                    );
+
+                out[px] =
+                    composite;
+            }
+        }
+    }
+
+
+    rc =
+        test149_5d4_gdraw_present_rgba();
+
+    if (rc == 0)
+        gd5d4_g6j1_snapshot_active = 1;
+
+    return rc;
+}
