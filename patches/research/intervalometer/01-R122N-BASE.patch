+/* GHOST10R: isolate diagnostic file I/O as an observer-effect control.
+ * Keep bounded RAM capture and all source/render/lifecycle policies intact.
+ * No automatic or blocked-DELETE diagnostic writes in this build.
+ */
+#define GD5D4_G10R_DIAG_FIO 0
+static const char gd5d4_g10s_marker[] __attribute__((used)) =
+    "GHOST10S";
+static const char gd5d4_g10r_marker[] __attribute__((used)) =
+    "GHOST10R-NO-DIAGNOSTIC-FIO";
+
+
+/* R61: three timestamps, reuse the existing G1 capture array. */
+void gd5d4_r61_stamp(unsigned int slot)
+{
+    if (gd5d4_g1_session && slot < 3U &&
+        gd5d4_g1_commit_count < GD5D4_G1_MAX_COMMITS - 3U)
+        gd5d4_g1_commit_ms[GD5D4_G1_MAX_COMMITS - 3U + slot] =
+            (uint32_t)get_ms_clock();
+}
+
+static void
+gd5d4_g1_dump_if_stable(int safe_lv)
+{
+#if defined(CONFIG_5D4)
+    /*
+     * R54 — G1-only, minimal one-shot trace.
+     * No new persistent state or diagnostic arrays.
+     * Existing transition safety callsite remains unchanged.
+     */
+    if (!safe_lv || !gd5d4_g1_session ||
+        !gd5d4_g1_exit_seen || gd5d4_g1_dumped)
+        return;
+
+    gd5d4_g1_dumped = 1;
+
+    FILE *r54_file =
+        FIO_CreateFileOrAppend("ML/LOGS/Z31YG1.TXT");
+
+    if (r54_file)
+    {
+        my_fprintf(
+            r54_file,
+            "R61PH run=%08x e=%08x p=%08x "
+            "f=%08x l=%08x c=%08x\n",
+            gd5d4_g1_run,
+            gd5d4_g1_entry_ms,
+            gd5d4_g1_raw4a_pre_ms,
+            gd5d4_g1_commit_ms[GD5D4_G1_MAX_COMMITS - 3U],
+            gd5d4_g1_commit_ms[GD5D4_G1_MAX_COMMITS - 2U],
+            gd5d4_g1_commit_ms[GD5D4_G1_MAX_COMMITS - 1U]
+        );
+        FIO_CloseFile(r54_file);
+    }
+
+    gd5d4_g1_session = 0;
+    return;
+#else
+
+    if (!GD5D4_G10R_DIAG_FIO) return;
+
+    if (
+        !safe_lv ||
+        !gd5d4_g1_session ||
+        !gd5d4_g1_exit_seen ||
+        gd5d4_g1_dumped
+    )
+        return;
+
+    /*
+     * From this point we are back in stable ordinary LiveView.
+     * FIO is now deliberately allowed.
+     */
+    gd5d4_g1_dumped = 1;
+
+    uint32_t dump_ms =
+        (uint32_t)get_ms_clock();
+
+    uint32_t dump_gen =
+        gd5d4_z31p_commit_generation;
+
+    FILE *f =
+        FIO_CreateFileOrAppend(
+            "ML/LOGS/Z31YG4.TXT"
+        );
+
+    if (!f)
+    {
+        gd5d4_g1_session = 0;
+        return;
+    }
+
+    my_fprintf(
+        f,
+        "\n"
+        "========================================\n"
+        " Z31Y-G1 RUN %08x\n"
+        "========================================\n"
+        "ENTRY       ms=%08x gen=%08x gui=%08x\n"
+        "RAW_4A      pre=%08x post=%08x dur=%08x\n"
+        "GS_GATE     gui4a=%08x genchg=%08x busy0=%08x handoff=%08x\n"
+        "GS_DATA     before=%08x genchg=%08x busy_gen=%08x gen_busy0=%08x hand_gen=%08x hand_busy=%08x\n"
+        "MODE_4A     ms=%08x gen=%08x\n"
+        "MENU_SHOWN  ms=%08x gen=%08x\n"
+        "MENU_ACTIVE ms=%08x gen=%08x menugen=%08x\n"
+        "EXIT        ms=%08x gen=%08x\n"
+        "DUMP        ms=%08x gen=%08x\n"
+        "COMMITS     count=%08x dropped=%08x\n",
+        gd5d4_g1_run,
+        gd5d4_g1_entry_ms,
+        gd5d4_g1_entry_gen,
+        gd5d4_g1_entry_gui,
+        gd5d4_g1_raw4a_pre_ms,
+        gd5d4_g1_raw4a_post_ms,
+        gd5d4_g1_raw4a_post_ms >= gd5d4_g1_raw4a_pre_ms
+            ? gd5d4_g1_raw4a_post_ms - gd5d4_g1_raw4a_pre_ms
+            : 0,
+        gd5d4_g1_gui4a_seen_ms,
+        gd5d4_g1_gs_gen_changed_ms,
+        gd5d4_g1_gs_busy_zero_ms,
+        gd5d4_g1_gs_handoff_ms,
+        gd5d4_g1_gs_gen_before,
+        gd5d4_g1_gs_gen_at_change,
+        gd5d4_g1_gs_busy_at_change,
+        gd5d4_g1_gs_gen_at_busy_zero,
+        gd5d4_g1_gs_gen_at_handoff,
+        gd5d4_g1_gs_busy_at_handoff,
+        gd5d4_g1_mode4a_ms,
+        gd5d4_g1_mode4a_gen,
+        gd5d4_g1_menu_shown_ms,
+        gd5d4_g1_menu_shown_gen,
+        gd5d4_g1_menu_active_ms,
+        gd5d4_g1_menu_active_gen,
+        gd5d4_g1_menu_generation,
+        gd5d4_g1_exit_ms,
+        gd5d4_g1_exit_gen,
+        dump_ms,
+        dump_gen,
+        gd5d4_g1_commit_count,
+        gd5d4_g1_commit_dropped
+    );
+
+    my_fprintf(
+        f,
+        "GHOST03 AB "
+        "seq_now=%08x "
+        "clear(seq=%08x disp=%08x vis=%08x) "
+        "begin(seq=%08x disp=%08x buf=%08x) "
+        "pre(seq=%08x disp=%08x back=%08x) "
+        "post(seq=%08x disp=%08x rc=%08x) "
+        "flags=%08x\n",
+        gd5d4_ghost03_present_seq_5d4,
+        gd5d4_ghost03_clear_seq_5d4,
+        gd5d4_ghost03_clear_disp_5d4,
+        gd5d4_ghost03_clear_vis_5d4,
+        gd5d4_ghost03_begin_seq_5d4,
+        gd5d4_ghost03_begin_disp_5d4,
+        gd5d4_ghost03_begin_buf_5d4,
+        gd5d4_ghost03_pre_seq_5d4,
+        gd5d4_ghost03_pre_disp_5d4,
+        gd5d4_ghost03_pre_back_5d4,
+        gd5d4_ghost03_post_seq_5d4,
+        gd5d4_ghost03_post_disp_5d4,
+        gd5d4_ghost03_post_rc_5d4,
+        gd5d4_ghost03_flags_5d4
+    );
+
+    my_fprintf(
+        f,
+        "GHOST04 ORIGIN "
+        "seq=%08x kind=%08x caller=%08x\n",
+        gd5d4_ghost04_seq_5d4,
+        gd5d4_ghost04_kind_5d4,
+        gd5d4_ghost04_caller_5d4
+    );
+
+
+    uint32_t count =
+        gd5d4_g1_commit_count;
+
+    if (count > GD5D4_G1_MAX_COMMITS)
+        count = GD5D4_G1_MAX_COMMITS;
+
+    uint32_t prev =
+        gd5d4_g1_entry_ms;
+
+    for (
+        uint32_t i = 0;
+        i < count;
+        i++
+    )
+    {
+        uint32_t t =
+            gd5d4_g1_commit_ms[i];
+
+        uint32_t gen =
+            gd5d4_g1_commit_gen[i];
+
+        my_fprintf(
+            f,
+            "C%02x ms=%08x d_entry=%08x d_prev=%08x gen=%08x\n",
+            i,
+            t,
+            t - gd5d4_g1_entry_ms,
+            t - prev,
+            gen
+        );
+
+        prev = t;
+    }
+
+    my_fprintf(
+        f,
+        "SLOTS mode4a=%08x menu_shown=%08x menu_active=%08x\n"
+        "ARMS count=%08x dropped=%08x\n",
+        gd5d4_g2_mode4a_slot,
+        gd5d4_g2_menu_shown_slot,
+        gd5d4_g2_menu_active_slot,
+        gd5d4_g2_arm_count,
+        gd5d4_g2_arm_dropped
+    );
+
+    uint32_t g2_count =
+        gd5d4_g2_arm_count;
+
+    if (g2_count > GD5D4_G2_MAX_ARMS)
+        g2_count = GD5D4_G2_MAX_ARMS;
+
+    for (
+        uint32_t i = 0;
+        i < g2_count;
+        i++
+    )
+    {
+        my_fprintf(
+            f,
+            "A%02x ms=%08x d_entry=%08x gen=%08x "
+            "before=%08x after=%08x result=%08x\n",
+            i,
+            gd5d4_g2_arm_ms[i],
+            gd5d4_g2_arm_ms[i] -
+                gd5d4_g1_entry_ms,
+            gd5d4_g2_arm_gen[i],
+            gd5d4_g2_arm_before[i],
+            gd5d4_g2_arm_after[i],
+            gd5d4_g2_arm_result[i]
+        );
+    }
+
+    my_fprintf(
+        f,
+        "G3 SERIAL enter=%08x lock=%08x render_ret=%08x "
+        "return=%08x rc=%08x\n",
+        gd5d4_g3_serial_enter_ms,
+        gd5d4_g3_serial_lock_ms,
+        gd5d4_g3_render_return_ms,
+        gd5d4_g3_serial_return_ms,
+        gd5d4_g3_serial_rc
+    );
+
+    my_fprintf(
+        f,
+        "G3 ZEBRA enter=%08x begin_done=%08x begin_rc=%08x "
+        "pre_exec=%08x post_exec=%08x exec_rc=%08x\n",
+        gd5d4_g3_zebra_enter_ms,
+        gd5d4_g3_begin_done_ms,
+        gd5d4_g3_begin_rc,
+        gd5d4_g3_before_execute_ms,
+        gd5d4_g3_after_execute_ms,
+        gd5d4_g3_execute_rc
+    );
+
+    my_fprintf(
+        f,
+        "G3 MENU wait=%08x lock=%08x publish_ret=%08x "
+        "unlock=%08x rc=%08x\n",
+        gd5d4_g3_menu_wait_ms,
+        gd5d4_g3_menu_lock_ms,
+        gd5d4_g3_menu_publish_return_ms,
+        gd5d4_g3_menu_unlock_ms,
+        gd5d4_g3_menu_publish_rc
+    );
+
+    my_fprintf(
+        f,
+        "G4 CALLS count=%08x dropped=%08x\n",
+        gd5d4_g4_count,
+        gd5d4_g4_dropped
+    );
+
+    uint32_t g4_count =
+        gd5d4_g4_count;
+
+    if (g4_count > GD5D4_G4_MAX_RENDER_CALLS)
+        g4_count =
+            GD5D4_G4_MAX_RENDER_CALLS;
+
+    for (
+        uint32_t i = 0;
+        i < g4_count;
+        i++
+    )
+    {
+        uint32_t enter =
+            gd5d4_g4_enter_ms[i];
+
+        uint32_t lock =
+            gd5d4_g4_lock_ms[i];
+
+        uint32_t render_ret =
+            gd5d4_g4_render_ret_ms[i];
+
+        uint32_t ret =
+            gd5d4_g4_return_ms[i];
+
+        my_fprintf(
+            f,
+            "R%02x "
+            "enter=%08x d_entry=%08x "
+            "lock=%08x wait=%08x "
+            "render_ret=%08x work=%08x "
+            "return=%08x total=%08x "
+            "gen=%08x gui=%08x shown=%08x active=%08x "
+            "rc=%08x\n",
+            i,
+            enter,
+            enter - gd5d4_g1_entry_ms,
+            lock,
+            lock ? lock - enter : 0xFFFFFFFF,
+            render_ret,
+            (render_ret && lock)
+                ? render_ret - lock
+                : 0xFFFFFFFF,
+            ret,
+            ret ? ret - enter : 0xFFFFFFFF,
+            gd5d4_g4_gen[i],
+            gd5d4_g4_gui[i],
+            gd5d4_g4_menu_shown[i],
+            gd5d4_g4_menu_active[i],
+            gd5d4_g4_rc[i]
+        );
+
+        my_fprintf(
+            f,
+            "P%02x "
+            "bd=%08x prep=%08x scan=%08x "
+            "x0=%08x x1=%08x "
+            "fc=%08x ref=%08x cell=%08x pair=%08x "
+            "ra=%08x rms=%08x\\n",
+            i,
+            gd5d4_g4_begin_done_ms[i],
+            gd5d4_g4_prep_done_ms[i],
+            gd5d4_g4_scan_done_ms[i],
+            gd5d4_g4_pre_exec_ms[i],
+            gd5d4_g4_post_exec_ms[i],
+            gd5d4_g4_full_clear[i],
+            gd5d4_g4_refined_cells[i],
+            gd5d4_g4_changed_cells[i],
+            gd5d4_g4_changed_pairs[i],
+            gd5d4_g4_rearm_calls[i],
+            gd5d4_g4_rearm_ms[i]
+        );
+    
+        my_fprintf(
+            f,
+            "D%02x "
+            "b0=%08x b1=%08x b2=%08x b3=%08x "
+            "b4=%08x b5=%08x b6=%08x b7=%08x "
+            "b8=%08x b9=%08x b10=%08x b11=%08x "
+            "b12=%08x b13=%08x b14=%08x b15=%08x "
+            "s0=%08x s1=%08x sx=%08x\\n",
+            i,
+            gd5d4_g4_scan_band_ms[i][0],
+            gd5d4_g4_scan_band_ms[i][1],
+            gd5d4_g4_scan_band_ms[i][2],
+            gd5d4_g4_scan_band_ms[i][3],
+            gd5d4_g4_scan_band_ms[i][4],
+            gd5d4_g4_scan_band_ms[i][5],
+            gd5d4_g4_scan_band_ms[i][6],
+            gd5d4_g4_scan_band_ms[i][7],
+            gd5d4_g4_scan_band_ms[i][8],
+            gd5d4_g4_scan_band_ms[i][9],
+            gd5d4_g4_scan_band_ms[i][10],
+            gd5d4_g4_scan_band_ms[i][11],
+            gd5d4_g4_scan_band_ms[i][12],
+            gd5d4_g4_scan_band_ms[i][13],
+            gd5d4_g4_scan_band_ms[i][14],
+            gd5d4_g4_scan_band_ms[i][15],
+            gd5d4_g4_sync0_ms[i],
+            gd5d4_g4_sync1_ms[i],
+            gd5d4_g4_ximr_ms[i]
+        );
+}
+
+    FIO_CloseFile(f);
+
+    gd5d4_g1_session = 0;
+
+#endif /* R54 G1-only exporter */
+}
