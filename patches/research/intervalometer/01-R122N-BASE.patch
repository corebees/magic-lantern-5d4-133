+/* WAVEFORM03: one palette for all Waveform sizes, under BMP_LOCK. */
+static uint32_t gd5d4_waveform_rgba_lut[256];
+static int gd5d4_waveform_rgba_ready;
+static void gd5d4_waveform_palette_init(void)
+{
+    if (gd5d4_waveform_rgba_ready) return;
+    for (int i = 0; i < 256; i++) gd5d4_waveform_rgba_lut[i] = indexed2rgb(i);
+    gd5d4_waveform_rgba_ready = 1;
+}
+
+static void
+gd5d4_draw_small_waveform_rgba_cached(
+    uint32_t *dst,
+    uint32_t pitch,
+    uint32_t ox,
+    uint32_t oy
+)
+{
+    if (!dst)
+        return;
+
+    if (!waveform_draw || waveform_size != 0)
+        return;
+
+    int cache_index =
+        gd5d4_waveform_cache_index;
+
+    if (cache_index < 0)
+        return;
+
+    const uint8_t *wf =
+        gd5d4_waveform_cache[cache_index];
+
+    /*
+     * Convert indexed ML palette entries once.
+     * This avoids thousands of indexed2rgb() calls per Zebra frame.
+     */
+    gd5d4_waveform_palette_init();
+
+
+    const int x_origin = 360;
+    const int y_origin = 80;
+    const int height = 54;
+
+    /*
+     * Reproduce waveform_draw_image() for WAVEFORM_FACTOR == 1.
+     * The cached analysis changes at low cadence; composition onto
+     * the current Zebra frame is cheap and READY-driven.
+     */
+    for (int y = WAVEFORM_HEIGHT - 1; y >= 0; y--)
+    {
+        int y_bmp =
+            y_origin +
+            y * height / WAVEFORM_HEIGHT;
+
+        if (y_bmp < 0 || y_bmp >= 480)
+            continue;
+
+        /* GRAPHS09: descending y overwrites earlier rows mapped to the
+         * same output line. Render only the final owner, pixel-identically.
+         */
+        if (y > 0 && (y - 1) * height / WAVEFORM_HEIGHT ==
+            y * height / WAVEFORM_HEIGHT)
+            continue;
+
+        uint32_t *out =
+            dst +
+            (oy + y_bmp) * pitch +
+            ox +
+            x_origin;
+
+        for (int x = 0; x < WAVEFORM_WIDTH; x++)
+        {
+            uint32_t count =
+                wf[
+                    x +
+                    (WAVEFORM_HEIGHT - y - 1) *
+                    WAVEFORM_WIDTH
+                ];
+
+            /*
+             * Keep the same small-Waveform scaling behavior
+             * as the legacy renderer.
+             */
+            if (height < WAVEFORM_HEIGHT)
+                count += count;
+
+            count = (count * 42) >> 7;
+
+            int pal;
+
+            if (count > 42 - 5)
+            {
+                pal = COLOR_RED;
+            }
+            else if (count > 0)
+            {
+                pal = count + 38 + 5;
+            }
+            else if (y == (WAVEFORM_HEIGHT * 1) >> 2)
+            {
+                pal = COLOR_BLUE;
+            }
+            else if (y == (WAVEFORM_HEIGHT * 2) >> 2)
+            {
+                pal = 0xE;
+            }
+            else if (y == (WAVEFORM_HEIGHT * 3) >> 2)
+            {
+                pal = COLOR_BLUE;
+            }
+            else
+            {
+                pal = waveform_bg;
+            }
+
+            out[x] =
+                gd5d4_graph_fade_rgba(gd5d4_waveform_rgba_lut[pal & 0xFF]);
+        }
+    }
+
+    /*
+     * Border corresponding to bmp_draw_rect(60,...).
+     */
+    const uint32_t border =
+        gd5d4_graph_fade_rgba(gd5d4_waveform_rgba_lut[60]);
+
+    const int bx0 = x_origin - 1;
+    const int by0 = y_origin - 1;
+    const int bx1 = x_origin + WAVEFORM_WIDTH;
+    const int by1 = y_origin + height;
+
+    uint32_t *top =
+        dst + (oy + by0) * pitch + ox;
+
+    uint32_t *bottom =
+        dst + (oy + by1) * pitch + ox;
+
+    for (int x = bx0; x <= bx1; x++)
+    {
+        top[x] = border;
+        bottom[x] = border;
+    }
+
+    for (int y = by0; y <= by1; y++)
+    {
+        uint32_t *row =
+            dst + (oy + y) * pitch + ox;
+
+        row[bx0] = border;
+        row[bx1] = border;
+    }
+}
