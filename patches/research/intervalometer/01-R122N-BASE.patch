+/*
+ * GD-D6-ZEBRA31Y-G6J1-ACTIVE-FULLFRAME-SNAPSHOT
+ *
+ * G6J1:
+ *
+ * G6F keeps the last Zebra layer visible during LV -> ML menu
+ * transition, while LiveView underneath may continue moving.
+ *
+ * During a pan this creates the visible relative displacement.
+ *
+ * Freeze one COMPLETE visual frame instead:
+ *
+ *     displayed LiveView (DV_VRAM_ACTIVE)
+ *       + current Canon GUI layer0
+ *       + exact currently-visible G6F Zebra
+ *
+ * into opaque dedicated layer1.
+ *
+ * NO fake menu.
+ * NO UILOCK.
+ * NO wheel/input routing changes.
+ * F2 unchanged.
+ */
+volatile int
+gd5d4_g6j1_snapshot_active = 0;
+
+
+static inline uint32_t
+gd5d4_g6j1_flatten_rgba(
+    uint32_t bg,
+    uint32_t fg
+)
+{
+    const uint32_t a =
+        fg >> 24;
+
+    if (a == 0)
+        return bg;
+
+    if (a >= 255)
+    {
+        return
+            0xFF000000U |
+            (fg & 0x00FFFFFFU);
+    }
+
+    const uint32_t ia =
+        255U - a;
+
+    const uint32_t br =
+        (bg >> 16) & 0xFFU;
+
+    const uint32_t bgc =
+        (bg >> 8) & 0xFFU;
+
+    const uint32_t bb =
+        bg & 0xFFU;
+
+    const uint32_t fr =
+        (fg >> 16) & 0xFFU;
+
+    const uint32_t fgc =
+        (fg >> 8) & 0xFFU;
+
+    const uint32_t fb =
+        fg & 0xFFU;
+
+    const uint32_t r =
+        (fr * a + br * ia + 127U) / 255U;
+
+    const uint32_t g =
+        (fgc * a + bgc * ia + 127U) / 255U;
+
+    const uint32_t b =
+        (fb * a + bb * ia + 127U) / 255U;
+
+    return
+        0xFF000000U |
+        (r << 16) |
+        (g << 8) |
+        b;
+}
