+            unsigned int gd5d4_fad05_scale =
+                gd5d4_fad05_alpha_scale_5d4;
+
+            if (gd5d4_fad05_scale > 255U)
+                gd5d4_fad05_scale = 255U;
+
+            const uint32_t gd5d4_fad05_main_alpha =
+                (
+                    0xFAU * gd5d4_fad05_scale +
+                    127U
+                ) / 255U;
+
+            const uint32_t gd5d4_fad05_edge_alpha =
+                (
+                    0xEBU * gd5d4_fad05_scale +
+                    127U
+                ) / 255U;
+
