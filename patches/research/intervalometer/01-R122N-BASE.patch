+/*
+ * Current GDCORE1 renderer.
+ *
+ * Histogram remains the only enabled real Global Draw feature.
+ * Rendering policy and 10 Hz task timing are intentionally
+ * unchanged from hardware-validated HIST3G.
+ */
+/*
+ * GD-D6-ZEBRA1-LUMA
+ *
+ * 5D4-safe Zebra renderer for GDCORE1.
+ *
+ * Reads Canon YUV using the existing BM->LV mapping, but writes
+ * only into the isolated ML indexed framebuffer supplied by the
+ * GDCORE renderer.
+ *
+ * Deliberately does NOT use:
+ * - bmp_vram_real()
+ * - bvram_mirror
+ * - DIGIC_ZEBRA_REGISTER
+ * - legacy draw_zebras()/draw_zebra_and_focus()
+ *
+ * First hardware test supports Luma Zebra only.
+ */
+#ifdef FEATURE_ZEBRA
+/*
+ * GD-D6-ZEBRA29J-MAP900-ALPHA60
+ *
+ * Correct per-pixel UYVY luminance selection.
+ */
+static inline int
+gd5d4_z29j_luma_at(
+    const uint32_t *row,
+    int lv_x
+)
+{
+    const uint32_t uyvy =
+        row[lv_x >> 1];
+
+    return
+        (uyvy >> ((lv_x & 1) ? 24 : 8)) &
+        0xFF;
+}
+
+
+/*
+ * Z29J diagnostic Zebra opacity.
+ *
+ * indexed2rgb() returns RGBA with A=0xFF.
+ * Preserve RGB and use approximately 93% source alpha.
+ */
+#define GD5D4_Z29J_ZEBRA_ALPHA 0xED
+
+static inline uint32_t
+gd5d4_z29j_apply_alpha(uint32_t rgba)
+{
+    return
+        (rgba & 0x00FFFFFF) |
+        ((uint32_t)GD5D4_Z29J_ZEBRA_ALPHA << 24);
+}
+
+
+static void
+gd5d4_draw_zebra_luma_locked(uint8_t *dst)
+{
+    if (!dst)
+        return;
+
+    if (!zebra_draw)
+        return;
+
+    if (zebra_colorspace != 0)
+        return;
+
+    if (!lv_luma_is_accurate())
+        return;
+
+    if (!(zebra_rec || NOT_RECORDING))
+        return;
+
+    struct vram_info *lv_info = get_yuv422_vram();
+
+    if (!lv_info || !lv_info->vram)
+        return;
+
+    uint8_t *lvram = lv_info->vram;
+
+    const int zlh =
+        gd5d4_zebra_luma_hi_from_percent(
+            zebra_level_hi
+        );
+
+    const int zll =
+        gd5d4_zebra_luma_lo_from_percent(
+            zebra_level_lo
+        );
+
+    /*
+     * Keep the first test independent from legacy `lv`-based
+     * get_y_skip_offset_for_overlays().
+     *
+     * Use the complete logical ML overlay area.
+     */
+    /*
+     * GD-D6-ZEBRA28B-CLASSIC-DIAGONAL
+     *
+     * Restore the classic Magic Lantern Zebra density.
+     *
+     * zebra_color_word_row() supplies the native four-row diagonal
+     * phase:
+     *
+     *   row 0: CC..
+     *   row 1: .CC.
+     *   row 2: ..CC
+     *   row 3: C..C
+     *
+     * Process every 2-row pair exactly like the legacy Luma Zebra.
+     * Threshold mapping, YUV mapping and publisher are unchanged.
+     */
+    for (int y = os.y0;
+         y < os.y_max - 1;
+         y += 2)
+    {
+        const uint32_t gd5d4_z_over0 =
+            zebra_color_word_row(COLOR_RED, y);
+
+        const uint32_t gd5d4_z_under0 =
+            zebra_color_word_row(COLOR_BLUE, y);
+
+        const uint32_t gd5d4_z_over1 =
+            zebra_color_word_row(COLOR_RED, y + 1);
+
+        const uint32_t gd5d4_z_under1 =
+            zebra_color_word_row(COLOR_BLUE, y + 1);
+
+        uint32_t *v_row =
+            (uint32_t *)(lvram + BM2LV_R(y));
+
+        uint32_t *b_row =
+            (uint32_t *)(dst + BM_R(y));
+
+        uint32_t *b_row2 =
+            (uint32_t *)(dst + BM_R(y + 1));
+
+        for (int x = os.x0;
+             x < os.x_max;
+             x += 4)
+        {
+            /*
+             * GD-D6-ZEBRA2-MAP920:
+             * TEST122 observed a 928-pixel row pitch, but the
+             * active image was suspected to be about 920 pixels.
+             *
+             * Probe horizontal active width locally without
+             * changing the global BM2LV mapping.
+             */
+            const int gd5d4_lv_x =
+                (x * 900) / 720;
+
+            const int Y =
+                gd5d4_z29j_luma_at(
+                    v_row,
+                    gd5d4_lv_x
+                );
+
+            uint32_t c1 = 0;
+            uint32_t c2 = 0;
+
+            if (zebra_level_hi <= 100 &&
+                unlikely(Y > zlh))
+            {
+                c1 = gd5d4_z_over0;
+                c2 = gd5d4_z_over1;
+            }
+            else if (zebra_level_lo > 0 &&
+                     unlikely(Y < zll))
+            {
+                c1 = gd5d4_z_under0;
+                c2 = gd5d4_z_under1;
+            }
+
+            b_row[x >> 2] = c1;
+            b_row2[x >> 2] = c2;
+        }
+    }
+}
+#endif
+
+
+#ifdef FEATURE_WAVEFORM
+/*
+ * Z27E direct-RGBA Small Waveform compositor.
+ *
+ * Geometry matches the hardware-tested Z27D Small Waveform:
+ * x=360, y=80, logical source 180x120, displayed height 54.
+ */
+static void
+gd5d4_clear_small_waveform_rgba_region(
+    uint32_t *dst,
+    uint32_t pitch,
+    uint32_t ox,
+    uint32_t oy
+)
+{
+    if (!dst)
+        return;
+
+    const int x0 = 359;
+    const int y0 = 79;
+    const int w = 182;
+    const int h = 56;
+
+    for (int y = 0; y < h; y++)
+    {
+        memset(
+            dst + (oy + y0 + y) * pitch + ox + x0,
+            0,
+            w * sizeof(uint32_t)
+        );
+    }
+}
