+
+        if (gd5d4_g10g_active >= 0)
+        {
+            volatile struct gd5d4_g10g_record *d =
+                &gd5d4_g10g_rows[gd5d4_g10g_active];
+            d->source = (uint32_t)get_ms_clock();
+            d->source_addr = ready_addr;
+            d->ready0 = DV_VRAM_READY;
+            d->active0 = DV_VRAM_ACTIVE;
+            d->gen0 = gd5d4_z31p_commit_generation;
+        }
