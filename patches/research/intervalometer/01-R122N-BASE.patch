+#ifdef CONFIG_5D4
+
+/*
+ * 5D4 electronic-level -> ML menu transition.
+ *
+ * Prearm the dedicated XIMR layer1 while Canon's electronic level is
+ * stable and keep it transparent. On DELETE, copy the current Canon
+ * level frame into this already-active layer and make it opaque.
+ *
+ * Canon's Q/backing-GUI transition then runs behind the frozen frame.
+ * ML opens only after the Canon GUI mode has committed, and the
+ * curtain remains visible until the final ML redraw is published.
+ *
+ * Do not initialize or reconfigure this XIMR backend after the
+ * synthetic Q transition has started; that ordering was unsafe on
+ * physical 5D Mark IV hardware.
+ */
+extern int test149_5d4_gdraw_begin_rgba(
+    uint32_t **buffer,
+    uint32_t *pitch,
+    uint32_t *ox,
+    uint32_t *oy
+);
+extern int test149_5d4_gdraw_present_rgba(void);
+extern int test161_5d4_gdraw_blank_keepalive(void);
+extern void test147_5d4_gdraw_disable(void);
+extern volatile int test147_5d4_gdraw_active;
+
+/*
+ * GD-D6-ZEBRA31Y-G6J1-ACTIVE-FULLFRAME-SNAPSHOT
+ */
+extern volatile int
+    gd5d4_g6j1_snapshot_active;
+
+extern int
+gd5d4_g6j1_present_snapshot(void);
+
+extern void
+gd5d4_g6j1_retire_snapshot(void);
+
+
+/*
+ * GD-D6-ZEBRA31Y-G6J2A-EARLY-YUV-FREEZE
+ */
+extern int
+gd5d4_g6j2_yuv_freeze_begin(void);
+
+extern void
+gd5d4_g6j2_yuv_freeze_end(void);
+
+static volatile int
+level_curtain_active_5d4 = 0;
+
+
+static volatile int level_curtain_opaque_5d4 = 0;
+
+
+static volatile int level_ml_entry_armed_5d4 = 0;
+
+
+static volatile int level_curtain_auto_prearmed_5d4 = 0;
+
+
+static int
+level_curtain_prearm_5d4()
+{
+    if (level_curtain_active_5d4)
+        return 0;
+
+    uint32_t *dst = 0;
+    uint32_t pitch = 0;
+    uint32_t ox = 0;
+    uint32_t oy = 0;
+
+    /*
+     * begin_rgba() sets up the dedicated backend if needed
+     * and clears visible 720x480 layer contents to zero.
+     *
+     * Zero = transparent.
+     */
+    int rc = test149_5d4_gdraw_begin_rgba(
+        &dst,
+        &pitch,
+        &ox,
+        &oy
+    );
+
+    if (rc != 0 || !dst)
+        return rc ? rc : -100;
+
+    /*
+     * Draw nothing: begin_rgba() already produced the desired
+     * fully transparent frame.
+     */
+    rc = test149_5d4_gdraw_present_rgba();
+
+    if (rc != 0)
+    {
+        test147_5d4_gdraw_disable();
+        return rc;
+    }
+
+    level_curtain_active_5d4 = 1;
+
+    return 0;
+}
+
+
+static int
+level_curtain_present_black_5d4()
+{
+
+    if (!level_curtain_active_5d4)
+        return -200;
+
+    uint32_t *dst = 0;
+    uint32_t pitch = 0;
+    uint32_t ox = 0;
+    uint32_t oy = 0;
+
+    int rc = test149_5d4_gdraw_begin_rgba(
+        &dst,
+        &pitch,
+        &ox,
+        &oy
+    );
+
+    if (rc != 0 || !dst)
+        return rc ? rc : -201;
+
+    /*
+     * begin_rgba() cleared the visible region to transparent.
+     * Replace it with the same RGBA black representation used
+     * by ML's indexed -> RGBA path.
+     *
+     * Do NOT memset to zero: zero is transparent.
+     */
+    const uint32_t black =
+        indexed2rgb(COLOR_BLACK);
+
+    for (uint32_t y = 0; y < 480; y++)
+    {
+        uint32_t *out =
+            dst + (y + oy) * pitch + ox;
+
+        for (uint32_t x = 0; x < 720; x++)
+            out[x] = black;
+    }
+
+    rc = test149_5d4_gdraw_present_rgba();
+
+    if (rc == 0)
+        level_curtain_opaque_5d4 = 1;
+
+    return rc;
+}
+
+
+static int
+level_curtain_present_snapshot_5d4()
+{
+    if (!level_curtain_active_5d4)
+        return -300;
+
+    /*
+     * Reacquire Canon/WINSYS layer0 while the electronic level
+     * is still the active visible Canon GUI.
+     */
+    uint8_t *canon_buf =
+        rgb_vram_preinit();
+
+    struct MARV *canon =
+        rgb_vram_info;
+
+    /*
+     * If Canon's surface is unavailable, retain the already
+     * hardware-proven BLACK curtain rather than risk an exposed
+     * GUI transition.
+     */
+    if (
+        !canon_buf ||
+        !canon ||
+        !canon->bitmap_data ||
+        canon->width == 0 ||
+        canon->height == 0
+    )
+    {
+        return level_curtain_present_black_5d4();
+    }
+
+    uint32_t src_w = canon->width;
+    uint32_t src_h = canon->height;
+
+    /*
+     * Same geometry rule used by the dedicated layer1 backend.
+     *
+     * Normal 5D4 Canon RGBA surface is 960x540, with the
+     * visible ML/Canon 720x480 rectangle at +120,+30.
+     */
+    uint32_t src_ox =
+        (src_w >= 960) ? 120 : 0;
+
+    uint32_t src_oy =
+        (src_h >= 540) ? 30 : 0;
+
+    if (
+        src_w < src_ox + 720 ||
+        src_h < src_oy + 480
+    )
+    {
+        return level_curtain_present_black_5d4();
+    }
+
+    const uint32_t *src =
+        (const uint32_t *)canon->bitmap_data;
+
+    /*
+     * Layer1 was already set up by N-D.
+     *
+     * begin_rgba() therefore obtains only the inactive
+     * layer1 backbuffer; it must NOT create a new backend here.
+     */
+    uint32_t *dst = 0;
+    uint32_t pitch = 0;
+    uint32_t ox = 0;
+    uint32_t oy = 0;
+
+    int rc =
+        test149_5d4_gdraw_begin_rgba(
+            &dst,
+            &pitch,
+            &ox,
+            &oy
+        );
+
+    if (rc != 0 || !dst)
+        return rc ? rc : -301;
+
+    /*
+     * Copy the currently visible Canon level.
+     *
+     * ARGB alpha is the high byte on this RGBA path.
+     *
+     * The curtain must be fully opaque, otherwise Canon's
+     * Q/PLAY frame could become visible through transparent
+     * portions of the copied level layer.
+     *
+     * Fully-transparent source pixels become opaque black.
+     * Other pixels retain their RGB but receive full opacity.
+     */
+    for (uint32_t y = 0; y < 480; y++)
+    {
+        const uint32_t *in =
+            src +
+            (src_oy + y) * src_w +
+            src_ox;
+
+        uint32_t *out =
+            dst +
+            (oy + y) * pitch +
+            ox;
+
+        for (uint32_t x = 0; x < 720; x++)
+        {
+            uint32_t px = in[x];
+
+            if ((px & 0xFF000000u) == 0)
+                out[x] = 0xFF000000u;
+            else
+                out[x] = px | 0xFF000000u;
+        }
+    }
+
+    rc =
+        test149_5d4_gdraw_present_rgba();
+
+    if (rc == 0)
+        level_curtain_opaque_5d4 = 1;
+
+    return rc;
+}
+
+
+
+/*
+ * TESTLV2 — LiveView GUI-only frozen curtain.
+ *
+ * Preserve Canon source alpha exactly. Canon OSD pixels remain
+ * visible/static while transparent pixels continue to expose the
+ * moving LiveView image underneath.
+ */
+static int
+testlv2_present_gui_snapshot_5d4()
+{
+    if (!level_curtain_active_5d4)
+        return -400;
+
+    uint8_t *canon_buf =
+        rgb_vram_preinit();
+
+    struct MARV *canon =
+        rgb_vram_info;
+
+    if (
+        !canon_buf ||
+        !canon ||
+        !canon->bitmap_data ||
+        canon->width == 0 ||
+        canon->height == 0
+    )
+        return -401;
+
+    uint32_t src_w = canon->width;
+    uint32_t src_h = canon->height;
+
+    uint32_t src_ox =
+        (src_w >= 960) ? 120 : 0;
+
+    uint32_t src_oy =
+        (src_h >= 540) ? 30 : 0;
+
+    if (
+        src_w < src_ox + 720 ||
+        src_h < src_oy + 480
+    )
+        return -402;
+
+    const uint32_t *src =
+        (const uint32_t *)canon->bitmap_data;
+
+    uint32_t *dst = 0;
+    uint32_t pitch = 0;
+    uint32_t ox = 0;
+    uint32_t oy = 0;
+
+    int rc =
+        test149_5d4_gdraw_begin_rgba(
+            &dst,
+            &pitch,
+            &ox,
+            &oy
+        );
+
+    if (rc != 0 || !dst)
+        return rc ? rc : -403;
+
+    for (uint32_t y = 0; y < 480; y++)
+    {
+        const uint32_t *in =
+            src +
+            (src_oy + y) * src_w +
+            src_ox;
+
+        uint32_t *out =
+            dst +
+            (oy + y) * pitch +
+            ox;
+
+        for (uint32_t x = 0; x < 720; x++)
+        {
+            /*
+             * Critical difference from Electronic-Level M1:
+             * alpha is NOT forced opaque.
+             */
+            out[x] = in[x];
+        }
+    }
+
+    return test149_5d4_gdraw_present_rgba();
+}
