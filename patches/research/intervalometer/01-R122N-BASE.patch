+ * RAM-only diagnostic.
+ *
+ * Detect whether any successful layer1 present occurs between
+ * the first ML-menu begin_rgba() and its later present_rgba().
+ *
+ * Buffer IDs:
+ *   1 = A
+ *   2 = B
+ *   0 = unknown
+ */
+volatile uint32_t gd5d4_ghost03_present_seq_5d4 = 0;
+
+volatile uint32_t gd5d4_ghost03_clear_seq_5d4 = 0xFFFFFFFFU;
+volatile uint32_t gd5d4_ghost03_clear_disp_5d4 = 0xFFFFFFFFU;
+volatile uint32_t gd5d4_ghost03_clear_vis_5d4 = 0xFFFFFFFFU;
+
+volatile uint32_t gd5d4_ghost03_begin_seq_5d4 = 0xFFFFFFFFU;
+volatile uint32_t gd5d4_ghost03_begin_disp_5d4 = 0xFFFFFFFFU;
+volatile uint32_t gd5d4_ghost03_begin_buf_5d4 = 0xFFFFFFFFU;
+
+volatile uint32_t gd5d4_ghost03_pre_seq_5d4 = 0xFFFFFFFFU;
+volatile uint32_t gd5d4_ghost03_pre_disp_5d4 = 0xFFFFFFFFU;
+volatile uint32_t gd5d4_ghost03_pre_back_5d4 = 0xFFFFFFFFU;
+
+volatile uint32_t gd5d4_ghost03_post_seq_5d4 = 0xFFFFFFFFU;
+volatile uint32_t gd5d4_ghost03_post_disp_5d4 = 0xFFFFFFFFU;
+volatile uint32_t gd5d4_ghost03_post_rc_5d4 = 0xFFFFFFFFU;
+
+volatile uint32_t gd5d4_ghost03_flags_5d4 = 0;
+
+
+/*
+ * GHOST04-PRE-MENU-PRESENT-ORIGIN
+ *
