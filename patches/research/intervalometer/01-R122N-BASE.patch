+
+static uint32_t
+gd5d4_z31p_commit_callback(uint32_t arg)
+{
+    (void)arg;
+
+    /*
+     * Single writer: Canon callback context.
+     * Worker is read-only.
+     */
+    gd5d4_z31p_commit_generation++;
+
+    /*
+     * GD-D6-ZEBRA31Y-G1-ENTRY-COMMIT-TIMELINE
+     *
+     * RAM only.
+     * No FIO, XIMR, allocation or menu work from this callback.
+     */
+    if (gd5d4_g1_commit_capture)
+    {
+        uint32_t i =
+            gd5d4_g1_commit_count;
+
+        if (i < GD5D4_G1_MAX_COMMITS)
+        {
+            gd5d4_g1_commit_ms[i] =
+                (uint32_t)get_ms_clock();
+
+            gd5d4_g1_commit_gen[i] =
+                gd5d4_z31p_commit_generation;
+
+            gd5d4_g1_commit_count =
+                i + 1;
+        }
+        else
+        {
+            gd5d4_g1_commit_dropped++;
+        }
+    }
+
+    /*
+     * DryOS give_semaphore() is explicitly documented
+     * as interrupt-context safe.
+     */
+    if (gd5d4_z31p_sem_valid())
+        give_semaphore(gd5d4_z31p_commit_sem);
+
+    /*
+     * FE1196F2 stores callback return value into +0x48.
+     * Zero retires this one-shot.
+     */
+    return 0;
+}
+
+
+static int
+gd5d4_z31p_arm_commit_callback(void)
+{
+    uint32_t base =
+        DISP_VRAM_STRUCT_PTR;
+
+    if (!base)
+        return 0;
+
+    volatile uint32_t *slot_cb =
+        (volatile uint32_t *)
+            (base + 0x48);
+
+    volatile uint32_t *slot_arg =
+        (volatile uint32_t *)
+            (base + 0x4C);
+
+    const uint32_t our_cb =
+        (uint32_t)
+            gd5d4_z31p_commit_callback;
+
+    /*
+     * G2:
+     * take timestamp outside the IRQ/FIQ critical section.
+     */
+    uint32_t g2_ms =
+        gd5d4_g1_commit_capture
+            ? (uint32_t)get_ms_clock()
+            : 0;
+
+    uint32_t old_irq =
+        cli();
+
+    uint32_t g2_before =
+        *slot_cb;
+
+    /*
+     * result:
+     *
+     *   1 = our callback was already installed
+     *   2 = empty slot; installed our callback now
+     *   3 = slot occupied by another callback
+     */
+    uint32_t g2_result = 3;
+
+    int armed = 0;
+
+    if (*slot_cb == our_cb)
+    {
+        armed = 1;
+        g2_result = 1;
+    }
+    else if (*slot_cb == 0)
+    {
+        *slot_arg = 0;
+        *slot_cb = our_cb;
+
+        armed = 1;
+        g2_result = 2;
+    }
+
+    uint32_t g2_after =
+        *slot_cb;
+
+    /*
+     * RAM-only transition trace.
+     */
+    if (gd5d4_g1_commit_capture)
+    {
+        uint32_t i =
+            gd5d4_g2_arm_count;
+
+        if (i < GD5D4_G2_MAX_ARMS)
+        {
+            gd5d4_g2_arm_ms[i] =
+                g2_ms;
+
+            gd5d4_g2_arm_gen[i] =
+                gd5d4_z31p_commit_generation;
+
+            gd5d4_g2_arm_before[i] =
+                g2_before;
+
+            gd5d4_g2_arm_after[i] =
+                g2_after;
+
+            gd5d4_g2_arm_result[i] =
+                g2_result;
+
+            gd5d4_g2_arm_count =
+                i + 1;
+        }
+        else
+        {
+            gd5d4_g2_arm_dropped++;
+        }
+    }
+
+    sei(old_irq);
+
+    return armed;
+}
