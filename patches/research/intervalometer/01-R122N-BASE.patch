+/*
+ * TEST149 — direct RGBA Global Draw frame access.
+ *
+ * No indexed framebuffer is involved.
+ *
+ * begin_rgba():
+ *   - setup dedicated XIMR layer if necessary
+ *   - acquire invisible backbuffer
+ *   - clear ONLY visible 720x480 RGBA region
+ *
+ * present_rgba():
+ *   - atomically switch XIMR layer 1 to completed backbuffer
+ */
+
+int
+test149_5d4_gdraw_begin_rgba(
+    uint32_t **buffer,
+    uint32_t *pitch,
+    uint32_t *ox,
+    uint32_t *oy
+)
+{
+    if (!buffer || !pitch || !ox || !oy)
+        return -10;
+
+    if (!test146_active)
+    {
+        int rc = test146_backend_setup();
+
+        if (rc != 0)
+            return rc;
+    }
+
+    uint32_t *dst =
+        test146_backend_begin_frame();
+
+    if (!dst)
+        return -11;
+
+    /*
+     * Clear only ML's visible 720x480 area.
+     *
+     * Everything outside this region was made transparent
+     * during backend setup and remains untouched.
+     *
+     * This replaces the old 345600 indexed2rgb conversions.
+     */
+    for (uint32_t y = 0; y < 480; y++)
+    {
+        memset(
+            dst +
+                (test146_oy + y) *
+                    test146_surface_w +
+                test146_ox,
+            0,
+            720 * sizeof(uint32_t)
+        );
+    }
+
+    *buffer = dst;
+    *pitch = test146_surface_w;
+    *ox = test146_ox;
+    *oy = test146_oy;
+
+    return 0;
+}
