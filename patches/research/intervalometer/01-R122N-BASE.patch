+/* GHOST12A: upstream RGB semantics in dedicated 5D4 layer1.
+ * Baseline scope RGB alone. No reuse of the two-bit Luma delta cache.
+ */
+/* GHOST12F: bounded lazy-allocated capture; manual export inside ML only.
+ * Generation and pointer changes are ordering clues, not source frame age.
+ * All shared capture state is accessed under the existing BMP lock.
+ */
+static MENU_SELECT_FUNC(gd5d4_g12c_arm)
+{
+    (void)priv; (void)delta;
+    int allowed = 0;
+    BMP_LOCK(
+        if (gui_menu_shown()) {
+            gd5d4_g12c_armed = 0;
+            gd5d4_g12c_count = 0;
+            allowed = 1;
+        }
+    );
+    if (!allowed) return;
+    /* Allocated once, only from an explicit menu action after boot.
+     * Retain until shutdown: no worker can race with a free/reallocation.
+     * Count stays zero and capture stays stopped on allocation failure.
+     */
+    if (!gd5d4_g12c_rows)
+        gd5d4_g12c_rows = malloc(sizeof(*gd5d4_g12c_rows) * GD5D4_G12C_MAX);
+    BMP_LOCK(
+        if (gui_menu_shown() && gd5d4_g12c_rows)
+            gd5d4_g12c_armed = 1;
+    );
+}
+static MENU_SELECT_FUNC(gd5d4_g12c_save)
+{
+    (void)priv; (void)delta;
+    unsigned n = 0;
+    int allowed = 0;
+    BMP_LOCK(
+        if (gui_menu_shown()) {
+            gd5d4_g12c_armed = 0;
+            n = gd5d4_g12c_count;
+            allowed = 1;
+        }
+    );
+    if (!allowed) return;
+    FILE *f = FIO_CreateFileOrAppend("ML/LOGS/Z12CTIME.TXT");
+    if (!f) return;
+    my_fprintf(f, "GRAPHS15 RAM_PHASES count=%08x ms hex cfg:alpha8,wf2,hist,exit,entry,info2,zebra\n", n);
+    for (unsigned i = 0; i < n; i++) {
+        const struct gd5d4_g12c_row *d = &gd5d4_g12c_rows[i];
+        my_fprintf(f, "%08x start=%08x begin=%08x clear=%08x raster=%08x end=%08x src=%08x ready_end=%08x active_end=%08x gen0=%08x gen1=%08x wf0=%08x wf1=%08x exec0=%08x cfg=%08x rc=%d\n",
+            i, d->start, d->begin, d->clear, d->raster, d->end,
+            d->source, d->ready_end, d->active_end, d->gen_start, d->gen_end,
+            d->wf0, d->wf1, d->exec0, d->config, d->rc);
+    }
+    FIO_CloseFile(f);
+}
