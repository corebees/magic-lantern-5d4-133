+            memset(
+                dst + (oy + cy) * pitch + ox,
+                0,
+                720 * sizeof(uint32_t)
+            );
+        }
+
+        memset(
+            z19->z31s_delta,
+            0,
+            sizeof(z19->z31s_delta)
+        );
+
+        z19->z31s_delta_valid = 1;
+        z19->full_clear = 0;
+        z19->count = 0;
+    }
+
+
+    if (phase_capture) phase.clear = get_ms_clock();
