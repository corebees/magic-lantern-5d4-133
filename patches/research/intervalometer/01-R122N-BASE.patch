+
+void
+gd5d4_g1_mark_menu_shown(void)
+{
+    if (
+        !gd5d4_g1_session ||
+        gd5d4_g1_menu_shown_ms
+    )
+        return;
+
+    gd5d4_g1_menu_shown_ms =
+        (uint32_t)get_ms_clock();
+
+    gd5d4_g1_menu_shown_gen =
+        gd5d4_z31p_commit_generation;
+
+    gd5d4_g2_menu_shown_slot =
+        gd5d4_g2_read_commit_slot();
+}
+
+
+void
+gd5d4_g1_mark_menu_active(void)
+{
+    if (
+        !gd5d4_g1_session ||
+        gd5d4_g1_menu_active_ms
+    )
+        return;
+
+    gd5d4_g1_menu_active_ms =
+        (uint32_t)get_ms_clock();
+
+    gd5d4_g1_menu_active_gen =
+        gd5d4_z31p_commit_generation;
+
+    gd5d4_g1_menu_generation =
+        gd5d4_z31y_menu_generation;
+
+    gd5d4_g2_menu_active_slot =
+        gd5d4_g2_read_commit_slot();
+
+    /*
+     * Entry question answered.
+     *
+     * Stop collecting READY callbacks now; leaving the ML menu open
+     * must not fill the diagnostic buffer.
+     */
+    gd5d4_g1_commit_capture = 0;
+}
