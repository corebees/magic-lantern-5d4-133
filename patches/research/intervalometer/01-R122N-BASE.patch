+    gd5d4_ghost03_clear_vis_5d4 = 0xFFFFFFFFU;
+
+    gd5d4_ghost03_begin_seq_5d4 = 0xFFFFFFFFU;
+    gd5d4_ghost03_begin_disp_5d4 = 0xFFFFFFFFU;
+    gd5d4_ghost03_begin_buf_5d4 = 0xFFFFFFFFU;
+
+    gd5d4_ghost03_pre_seq_5d4 = 0xFFFFFFFFU;
+    gd5d4_ghost03_pre_disp_5d4 = 0xFFFFFFFFU;
+    gd5d4_ghost03_pre_back_5d4 = 0xFFFFFFFFU;
+
+    gd5d4_ghost03_post_seq_5d4 = 0xFFFFFFFFU;
+    gd5d4_ghost03_post_disp_5d4 = 0xFFFFFFFFU;
+    gd5d4_ghost03_post_rc_5d4 = 0xFFFFFFFFU;
+
+    gd5d4_ghost03_flags_5d4 = 0;
+
+    gd5d4_ghost04_seq_5d4 = 0xFFFFFFFFU;
+    gd5d4_ghost04_kind_5d4 = 0xFFFFFFFFU;
+    gd5d4_ghost04_caller_5d4 = 0xFFFFFFFFU;
+}
+
+
+void
+gd5d4_ghost03_mark_clear_5d4(void)
+{
+    gd5d4_ghost03_clear_seq_5d4 =
+        gd5d4_ghost03_present_seq_5d4;
+
+    gd5d4_ghost03_clear_disp_5d4 =
+        test146_display_a ? 1U : 0U;
+
+    gd5d4_ghost03_clear_vis_5d4 =
+        test146_display_a ? 1U : 2U;
+}
+
+
+void
+gd5d4_ghost03_mark_menu_begin_5d4(const void *dst)
+{
+    gd5d4_ghost03_begin_seq_5d4 =
+        gd5d4_ghost03_present_seq_5d4;
+
+    gd5d4_ghost03_begin_disp_5d4 =
+        test146_display_a ? 1U : 0U;
+
+    gd5d4_ghost03_begin_buf_5d4 =
+        gd5d4_ghost03_buffer_id_5d4(dst);
+
+    if (
+        gd5d4_ghost03_clear_seq_5d4 != 0xFFFFFFFFU &&
+        gd5d4_ghost03_clear_seq_5d4 !=
+            gd5d4_ghost03_begin_seq_5d4
+    )
+    {
+        /* Present occurred after final clear, before menu begin. */
+        gd5d4_ghost03_flags_5d4 |= 0x01U;
+    }
+}
+
+
+void
+gd5d4_ghost03_mark_menu_pre_5d4(void)
+{
+    gd5d4_ghost03_pre_seq_5d4 =
+        gd5d4_ghost03_present_seq_5d4;
+
+    gd5d4_ghost03_pre_disp_5d4 =
+        test146_display_a ? 1U : 0U;
+
+    gd5d4_ghost03_pre_back_5d4 =
+        test146_display_a ? 2U : 1U;
+
+    if (
+        gd5d4_ghost03_begin_seq_5d4 !=
+        gd5d4_ghost03_pre_seq_5d4
+    )
+    {
+        /* Intervening successful present between begin and present. */
+        gd5d4_ghost03_flags_5d4 |= 0x02U;
+    }
+
+    if (
+        gd5d4_ghost03_begin_buf_5d4 !=
+        gd5d4_ghost03_pre_back_5d4
+    )
+    {
+        /* Buffer filled at begin is no longer software backbuffer. */
+        gd5d4_ghost03_flags_5d4 |= 0x04U;
+    }
+}
+
+
+void
+gd5d4_ghost03_mark_menu_post_5d4(int rc)
+{
+    gd5d4_ghost03_post_seq_5d4 =
+        gd5d4_ghost03_present_seq_5d4;
+
+    gd5d4_ghost03_post_disp_5d4 =
+        test146_display_a ? 1U : 0U;
+
+    gd5d4_ghost03_post_rc_5d4 =
+        (uint32_t)rc;
+
+    if (rc == 0)
+    {
+        if (
+            gd5d4_ghost03_post_seq_5d4 !=
+            gd5d4_ghost03_pre_seq_5d4 + 1U
+        )
+        {
+            gd5d4_ghost03_flags_5d4 |= 0x08U;
+        }
+
+        if (
+            gd5d4_ghost03_post_disp_5d4 ==
+            gd5d4_ghost03_pre_disp_5d4
+        )
+        {
+            gd5d4_ghost03_flags_5d4 |= 0x10U;
+        }
+    }
+}
+
+/*
+ * TEST147:
+ * Tells the legacy indexed->Canon-RGBA refresh task that
+ * dedicated layer 1 currently owns Global Draw publication.
+ */
+volatile int test147_5d4_gdraw_active = 0;
+
+
+static test146_surface_fn
+test146_set_surface(void)
+{
+    return TEST146_THUMB(
+        0xfe23d7e8,
+        test146_surface_fn
+    );
+}
+
+
+static test146_enable_fn
+test146_set_enable(void)
+{
+    return TEST146_THUMB(
+        0xfe23d7c8,
+        test146_enable_fn
+    );
+}
+
+
+static test146_rect_fn
+test146_set_rect(void)
+{
+    return TEST146_THUMB(
+        0xfe23d886,
+        test146_rect_fn
+    );
+}
+
+
+static test146_blend_fn
+test146_set_blend(void)
+{
+    return TEST146_THUMB(
+        0xfe23d994,
+        test146_blend_fn
+    );
+}
+
+
+static test146_mode_fn
+test146_set_mode(void)
+{
+    return TEST146_THUMB(
+        0xfe23da24,
+        test146_mode_fn
+    );
+}
+
+
+/*
+ * SETUP
+ *
+ * Create two independent RGBA surfaces and attach layer 1.
+ */
+static int
+test146_backend_setup(void)
+{
+    if (test146_active)
+        return 0;
+
+    struct MARV *canon = _rgb_vram_info;
+
+    if (!canon ||
+        canon->signature != 0x5652414D ||
+        !canon->bitmap_data ||
+        canon->width < 720 ||
+        canon->height < 480 ||
+        canon->width > 1024 ||
+        canon->height > 640)
+    {
+        return -1;
+    }
+
+    test146_surface_w = canon->width;
+    test146_surface_h = canon->height;
+
+    test146_surface_bytes =
+        test146_surface_w *
+        test146_surface_h *
+        sizeof(uint32_t);
+
+    /*
+     * Allocate once.
+     * As in TEST89D/145, do not free these buffers at runtime.
+     */
+    if (!test146_marv_a)
+        test146_marv_a =
+            malloc(sizeof(struct MARV));
+
+    if (!test146_marv_b)
+        test146_marv_b =
+            malloc(sizeof(struct MARV));
+
+    if (!test146_marv_a ||
+        !test146_marv_b)
+    {
+        return -2;
+    }
+
+    memcpy(
+        test146_marv_a,
+        canon,
+        sizeof(struct MARV)
+    );
+
+    memcpy(
+        test146_marv_b,
+        canon,
+        sizeof(struct MARV)
+    );
+
+    if (!test146_buf_a)
+    {
+        uint8_t *raw =
+            malloc(test146_surface_bytes + 0x100);
+
+        if (!raw)
+            return -3;
+
+        /*
+         * TEST154:
+         * retain both mappings of the same aligned memory.
+         */
+        test154_draw_a =
+            (uint8_t *)
