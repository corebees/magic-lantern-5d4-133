+
+static void
+level_curtain_disable_5d4()
+{
+
+    /*
+     * G6J2A fail-safe.
+     */
+    gd5d4_g6j2_yuv_freeze_end();
+
+
+    /*
+     * G6J1 fail-safe:
+     * never retain snapshot software ownership across curtain
+     * teardown or an aborted transition.
+     */
+    gd5d4_g6j1_snapshot_active = 0;
+
+    if (!level_curtain_active_5d4)
+        return;
+
+    /*
+     * Graceful transparent-frame -> backend-disable sequence.
+     */
+    test161_5d4_gdraw_blank_keepalive();
+    test147_5d4_gdraw_disable();
+
+    level_curtain_active_5d4 = 0;
+    level_curtain_opaque_5d4 = 0;
+    level_curtain_auto_prearmed_5d4 = 0;
+}
