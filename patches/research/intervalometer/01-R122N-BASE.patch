+static void close_canon_menu()
+{
+#ifdef GUIMODE_ML_MENU
+#ifdef CONFIG_5D4
+    /*
+     * TESTLV6:
+     * no Canon GUI mode was ever entered.
+     */
+    if (testlv6_lv_menu_no_host_5d4)
+    {
+        /*
+         * TESTGM17C-A:
+         *
+         * Normal shooting DOES have a Canon logical host:
+         * GUIMODE_PLAY.
+         *
+         * Keep layer1 covering the entire transition while Canon
+         * returns to shooting mode 0.
+         *
+         * LiveView Q-host remains untouched and returns exactly
+         * as TESTLV15C expects.
+         */
+        if (
+            !lv_5d4 &&
+            testns16b_shoot_copycat_active_5d4
+        )
+        {
+            SetGUIRequestMode(0);
+
+            /*
+             * Wait up to ~1 second for Canon shooting mode.
+             *
+             * No XIMR operation occurs while the Canon mode is
+             * changing. menu_close() removes layer1 afterwards.
+             */
+            for (int i = 0; i < 100; i++)
+            {
+                if (CURRENT_GUI_MODE == 0)
+                    break;
+
+                msleep(10);
+            }
+        }
+
+        /*
+         * TESTGM18B-A — LiveView 0x4A exit.
+         *
+         * Keep ML layer1 visible while Canon relinquishes the
+         * invisible 0x4A input host.
+         *
+         * Only after CURRENT_GUI_MODE returns to 0 will the
+         * existing menu_close() lifecycle restore Canon layer0
+         * and blank/disable ML layer1.
+         */
+        if (lv_5d4)
+        {
+            SetGUIRequestMode(0);
+
+            for (int i = 0; i < 100; i++)
+            {
+                if (CURRENT_GUI_MODE == 0)
+                    break;
+
+                msleep(10);
+            }
+        }
+
+        return;
+    }
+
+    /* TEST238: no Canon mode was entered in normal shooting. */
+    if (ml_menu_no_host_5d4)
+        return;
+#endif
+    if (CURRENT_GUI_MODE == 0) return;
+    if (sensor_cleaning) return;
+
+#ifdef CONFIG_5D4
+    /*
+     * 5D4 LiveView:
+     * GUIMODE_ML_MENU (0x48) itself puts Canon into
+     * GUISTATE_MENUDISP. Do not abort close_canon_menu()
+     * in that specific case, otherwise Canon never leaves
+     * the ML backing dialog and the LV button stops working.
+     */
+    if (gui_state == GUISTATE_MENUDISP &&
+        !ml_menu_opened_from_lv_5d4)
+        return;
+#else
+    if (gui_state == GUISTATE_MENUDISP) return;
+#endif
+#ifdef CONFIG_5D4
+    if (ml_menu_opened_from_lv_5d4)
+    {
+        /*
+         * 5D4 LiveView:
+         * GUIMODE_ML_MENU (0x48) creates a Canon MENUDISP
+         * backing dialog. Close it explicitly.
+         *
+         * Do not use the current value of 'lv' here.
+         */
+        bmp_off();
+        SetGUIRequestMode(0);
+
+        /*
+         * Wait up to ~1 second for Canon to leave MENUDISP.
+         */
+        for (int i = 0; i < 20; i++)
+        {
+            if (gui_state != GUISTATE_MENUDISP)
+                break;
+
+            msleep(50);
+        }
+
+    }
+    else
+    {
+        /*
+         * Normal shooting / PLAY path.
+         */
+        SetGUIRequestMode(0);
+        msleep(100);
+    }
+#else
+    if (lv) bmp_off(); // mask out the underlying Canon menu :)
+    SetGUIRequestMode(0);
+    msleep(100);
+#endif
+    // bitmap will be re-enabled in the caller
+#endif
+#ifdef CONFIG_5DC
+    //~ forces the 5dc screen to turn off for ML menu.
+    if (DISPLAY_IS_ON && !HALFSHUTTER_PRESSED)
+        fake_simple_button(BGMT_MENU);
+    msleep(50);
+#endif
+}
