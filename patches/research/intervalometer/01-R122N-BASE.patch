+
+/*
+ * GD-D6-ZEBRA29M-CONTINUOUS-FEATHER-ALPHA93
+ *
+ * Four-level threshold feather.
+ */
+static inline uint8_t
+gd5d4_z29m_level_from_distance(int d)
+{
+    if (d <= 2)
+        return 1;
+
+    if (d <= 4)
+        return 2;
+
+    if (d <= 6)
+        return 3;
+
+    return 4;
+}
+
+
+static inline uint8_t
+gd5d4_z29m_classify_y(
+    int Y,
+    int zlh,
+    int zll
+)
+{
+    if (
+        zebra_level_hi <= 100 &&
+        unlikely(Y > zlh)
+    )
+    {
+        return
+            gd5d4_z29m_level_from_distance(
+                Y - zlh
+            );
+    }
+
+    if (
+        zebra_level_lo > 0 &&
+        unlikely(Y < zll)
+    )
+    {
+        return
+            (uint8_t)(
+                4 +
+                gd5d4_z29m_level_from_distance(
+                    zll - Y
+                )
+            );
+    }
+
+    return 0;
+}
+
+
+/*
+ * Z29N temporal hysteresis for DELTA-CELL.
+ *
+ * old_level:
+ *   0 = transparent
+ *   1..4 = previous feather level
+ *
+ * This deliberately uses the existing delta_state byte instead of
+ * introducing another per-cell history buffer.
+ */
+static inline uint8_t
+gd5d4_z29n_level_hysteresis(
+    int distance,
+    uint8_t old_level
+)
+{
+    uint8_t raw = 0;
+
+    if (distance > 0)
+        raw =
+            gd5d4_z29m_level_from_distance(
+                distance
+            );
+
+    if (old_level == 0)
+        return raw;
+
+    /*
+     * ON/OFF dead-band:
+     *
+     * once level 1 is active, allow Y to fall to one code value
+     * below the nominal threshold before removing Zebra.
+     */
+    if (old_level == 1)
+    {
+        if (distance < -1)
+            return 0;
+
+        if (distance <= 3)
+            return 1;
+
+        return raw;
+    }
+
+    /*
+     * 30 <-> 50% boundary.
+     * Raw transition is between distance 2 and 3.
+     */
+    if (old_level == 2)
+    {
+        if (distance <= 1)
+            return raw;
+
+        if (distance <= 5)
+            return 2;
+
+        return raw;
+    }
+
+    /*
+     * 50 <-> 70% boundary.
+     * Raw transition is between distance 4 and 5.
+     */
+    if (old_level == 3)
+    {
+        if (distance <= 3)
+            return raw;
+
+        if (distance <= 7)
+            return 3;
+
+        return raw;
+    }
+
+    /*
+     * 70 <-> 93% boundary.
+     * Raw transition is between distance 6 and 7.
+     */
+    if (old_level == 4)
+    {
+        if (distance <= 5)
+            return raw;
+
+        return 4;
+    }
+
+    return raw;
+}
+
+
+static inline uint8_t
+gd5d4_z29n_classify_y(
+    int Y,
+    int zlh,
+    int zll,
+    uint8_t old_state
+)
+{
+    /*
+     * OVEREXPOSURE:
+     * states 1..4
+     */
+    if (zebra_level_hi <= 100)
+    {
+        const uint8_t old_over =
+            old_state >= 1 &&
+            old_state <= 4
+                ? old_state
+                : 0;
+
+        const int d =
+            Y - zlh;
+
+        if (d > 0 || old_over)
+        {
+            const uint8_t level =
+                gd5d4_z29n_level_hysteresis(
+                    d,
+                    old_over
+                );
+
+            if (level)
+                return level;
+        }
+    }
+
+    /*
+     * UNDEREXPOSURE:
+     * states 5..8
+     */
+    if (zebra_level_lo > 0)
+    {
+        const uint8_t old_under =
+            old_state >= 5 &&
+            old_state <= 8
+                ? old_state - 4
+                : 0;
+
+        const int d =
+            zll - Y;
+
+        if (d > 0 || old_under)
+        {
+            const uint8_t level =
+                gd5d4_z29n_level_hysteresis(
+                    d,
+                    old_under
+                );
+
+            if (level)
+                return
+                    (uint8_t)(4 + level);
+        }
+    }
+
+    return 0;
+}
