+            lv_info &&
+            ready_addr
+        )
+        {
+            uint8_t *ready_vram =
+                (uint8_t *)CACHEABLE(
+                    ready_addr
+                );
+
+            const int zlh =
+                gd5d4_zebra_luma_hi_from_percent(
+                    zebra_level_hi
+                );
+
+
+            const int zll =
+                gd5d4_zebra_luma_lo_from_percent(
+                    zebra_level_lo
+                );
+
+            /*
+             * GD-D6-ZEBRA31W-ALPHA98-FEATHER
+             *
+             * Main Zebra:
+             *     250 / 255 = 98.0%
+             *
+             * Threshold feather:
+             *     235 / 255 = 92.2%
+             */
+            const uint32_t red_rgba =
+                indexed2rgb(COLOR_RED);
+
+            /*
+             * FAD05-LIVE-FADE-FRESH-FRAMES
+             *
+             * Snapshot the fade factor ONCE per render so every
+             * Zebra pixel in this frame uses the same opacity.
+             *
+             * Ordinary operation stays exactly 255/255.
+             */
+            /* Alpha changes require repainting unchanged classifications too. */
+            const int gd5d4_g10f_repaint_alpha =
+                gd5d4_g11i_info_render || /* GRAPHS15: refresh INFO alpha too. */
