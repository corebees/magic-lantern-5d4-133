+/*
+ * Retire the frozen snapshot immediately before the real
+ * TESTLV6 menu publisher replaces it.
+ *
+ * No XimrExe here.
+ * The real menu publisher performs the next display commit.
+ */
+void
+gd5d4_g6j1_retire_snapshot(void)
+{
+    if (!gd5d4_g6j1_snapshot_active)
+        return;
+
+    uint32_t *dst = 0;
+    uint32_t pitch = 0;
+    uint32_t ox = 0;
+    uint32_t oy = 0;
+
+    int rc =
+        test31d_5d4_gdraw_begin_visible_rgba(
+            &dst,
+            &pitch,
+            &ox,
+            &oy
+        );
+
+    if (rc == 0 && dst)
+    {
+        for (uint32_t y = 0; y < 480; y++)
+        {
+            memset(
+                dst +
+                    (oy + y) * pitch +
+                    ox,
+                0,
+                720U * sizeof(uint32_t)
+            );
+        }
+    }
+
+    gd5d4_g6j1_snapshot_active = 0;
+}
