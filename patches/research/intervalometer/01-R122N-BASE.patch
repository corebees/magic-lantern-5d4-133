+static struct gd5d4_z19_state *
+gd5d4_z19_select(uint32_t *dst)
+{
+    if (gd5d4_z19_reset)
+    {
+        memset(&gd5d4_z19_a, 0, sizeof(gd5d4_z19_a));
+        memset(&gd5d4_z19_b, 0, sizeof(gd5d4_z19_b));
+
+        gd5d4_z19_a.full_clear = 1;
+        gd5d4_z19_b.full_clear = 1;
+
+        gd5d4_z19_reset = 0;
+    }
+
+    if (gd5d4_z19_a.dst == dst)
+        return &gd5d4_z19_a;
+
+    if (gd5d4_z19_b.dst == dst)
+        return &gd5d4_z19_b;
+
+    if (!gd5d4_z19_a.dst)
+    {
+        gd5d4_z19_a.dst = dst;
+        gd5d4_z19_a.full_clear = 1;
+        return &gd5d4_z19_a;
+    }
+
+    if (!gd5d4_z19_b.dst)
+    {
+        gd5d4_z19_b.dst = dst;
+        gd5d4_z19_b.full_clear = 1;
+        return &gd5d4_z19_b;
+    }
+
+    gd5d4_z19_reset = 1;
+    return gd5d4_z19_select(dst);
+}
