+        // filter out strong edges where first derivative is strong
+        // as these are usually false positives
+        int d1x = ABS(p8_xplus1 - p8_xmin1);
+        int d1y = ABS(p8_yplus1 - p8_ymin1);
+        int d1 = MAX(d1x, d1y);
+        e = MAX(e - ((d1 << focus_peaking_filter_edges) >> 2), 0) * 2;
+    }
+    return e;
+}
