+static int
+gd5d4_hist_rgb_color(
+    int y,
+    int sizeR,
+    int sizeG,
+    int sizeB
+)
+{
+    switch (
+        (y > sizeR ? 0 : 1) |
+        (y > sizeG ? 0 : 2) |
+        (y > sizeB ? 0 : 4)
+    )
+    {
+        case 0: return COLOR_ALMOST_BLACK;
+        case 1: return COLOR_RED;
+        case 2: return COLOR_GREEN2;
+        case 4: return COLOR_LIGHT_BLUE;
+        case 3: return COLOR_YELLOW;
+        case 6: return COLOR_CYAN;
+        case 5: return COLOR_MAGENTA;
+        case 7: return COLOR_WHITE;
+    }
+
+    return 0;
+}
