+static void piggyback_canon_menu()
+{
+#ifdef GUIMODE_ML_MENU
+    int new_gui_mode = GUIMODE_ML_MENU;
+    if (!new_gui_mode) return;
+    if (sensor_cleaning) return;
+
+#ifdef CONFIG_5D4
+    /*
+     * TESTLV6:
+     *
+     * LiveView itself is the host.
+     *
+     * Canon GUI layer0 is already hidden and layer1 is already
+     * displaying our curtain. Do not request GUIMODE_ML_MENU,
+     * PLAY, Q or any other Canon GUI transition.
+     */
+    if (testlv6_lv_menu_no_host_5d4)
+    {
+        /*
+         * TESTNS16B:
+         * TESTLV6's dedicated-layer renderer is now also reused
+         * by ordinary shooting copycat mode.
+         */
+        ml_menu_opened_from_lv_5d4 =
+            lv_5d4 ? 1 : 0;
+
+        ml_menu_opened_from_level_5d4 = 0;
+        ml_menu_no_host_5d4 = 0;
+
+        /*
+         * TESTGM18D-B:
+         *
+         * Naked 0x4A never executes NotifyBoxHide().
+         * Remove this side effect only from the LiveView
+         * persistent-host experiment.
+         */
+        if (!(
+            lv_5d4 &&
+            CURRENT_GUI_MODE == 0x4A
+        ))
+        {
+            NotifyBoxHide();
+        }
+
+        return;
+    }
+#endif
+
+    if (gui_state == GUISTATE_MENUDISP) return;
+    NotifyBoxHide();
+
+#ifdef CONFIG_5D4
+
+    /*
+     * Electronic Level path: Canon's backing mode was established
+     * before menu_open(), so no Canon mode transition is allowed here.
+     */
+    if (ml_menu_level_host_prepared_5d4)
+    {
+        /*
+         * TESTLV13B E:
+         * ML opens on prepared Electronic-Level host.
+         */
+        testlv13b_capture_5d4(
+            &testlv13b_e_5d4
+        );
+
+        /*
+         * TESTLV14B phase E:
+         * ML is now opening on the prepared PLAY host.
+         */
+        testlv14b_phase_5d4 = 5;
+
+        ml_menu_level_host_prepared_5d4 = 0;
+
+        ml_menu_opened_from_lv_5d4 = 0;
+        ml_menu_opened_from_level_5d4 = 1;
+        ml_menu_no_host_5d4 = 0;
+
+
+        menu_redraw_full();
+
+#ifdef FEATURE_VRAM_RGBA
+        refresh_yuv_from_rgb();
+
+
+#endif
+
+        start_redraw_flood();
+
+        return;
+    }
+#endif
+
+
+#ifdef CONFIG_5D4
+    /*
+     * Snapshot before SetGUIRequestMode can alter Canon GUI/LV state.
+     */
+    ml_menu_opened_from_lv_5d4 = lv_5d4 ? 1 : 0;
+
+
+    ml_menu_opened_from_level_5d4 =
+        (!lv_5d4 && level_host_active_5d4()) ? 1 : 0;
+
+    /* TEST238: plain normal shooting needs no Canon backing GUI. */
+    ml_menu_no_host_5d4 =
+        (
+            !lv_5d4 &&
+            CURRENT_GUI_MODE == 0 &&
+            !ml_menu_opened_from_level_5d4
+        ) ? 1 : 0;
+
+    if (ml_menu_no_host_5d4)
+        return;
+#endif
+
+    if (new_gui_mode != (int)CURRENT_GUI_MODE)
+    {
+#ifdef CONFIG_5D4
+
+        if (ml_menu_opened_from_level_5d4)
+        {
+            menu_redraw_full();
+#ifdef FEATURE_VRAM_RGBA
+            refresh_yuv_from_rgb();
+#endif
+        }
+#endif
+
+        start_redraw_flood();
+        #ifdef CONFIG_5D4
+        if (lv_5d4)
+        {
+            extern int test149_5d4_gdraw_begin_rgba(
+                uint32_t **buffer,
+                uint32_t *pitch,
+                uint32_t *ox,
+                uint32_t *oy
+            );
+            extern int test149_5d4_gdraw_present_rgba(void);
+
+            menu_redraw_full();
+
+            /*
+             * GHOST05-SUPPRESS-LEGACY-LV-PREPRESENT
+             *
+             * Zebra-only TESTLV6 entry already owns the dedicated
+             * layer1 lifecycle.
+             *
+             * GHOST03/GHOST04 hardware correlation proved that a rare
+             * extra A/B present may occur after FAD06A clear-both and
+             * before the authoritative TESTLV6 menu publisher.
+             *
+             * Do not allow this historical LiveView pre-present path
+             * to compete with TESTLV6 during that specific ownership
+             * window.
+             *
+             * Keep menu_redraw_full(), bmp_off() and the following
+             * SetGUIRequestMode() behavior unchanged.
+             *
+             * Histogram/Waveform/non-Zebra combinations retain the
+             * existing path.
+             */
+            if (!(
+                    gd5d4_layer1_menu_entry_pending &&
+                    gd5d4_z31y_zebra_only_scope_now()
+                ))
+            {
+                uint32_t *dst = 0;
+                uint32_t pitch = 0;
+                uint32_t ox = 0;
+                uint32_t oy = 0;
+
+                if (test149_5d4_gdraw_begin_rgba(
+                        &dst, &pitch, &ox, &oy) == 0)
+                {
+                    uint8_t *src = bmp_vram();
+
+                    if (src)
+                    {
+                        for (uint32_t y = 0; y < 480; y++)
+                        {
+                            uint8_t *in = src + BM(0, y);
+                            uint32_t *out =
+                                dst + (y + oy) * pitch + ox;
+
+                            for (uint32_t x = 0; x < 720; x++)
+                                out[x] = indexed2rgb(in[x]);
+                        }
+
+                        test149_5d4_gdraw_present_rgba();
+                    }
+                }
+            }
+
+            bmp_off();
+        } // mask out the underlying Canon menu :)
+#else
+        if (lv) bmp_off(); // mask out the underlying Canon menu :)
+#endif
+        SetGUIRequestMode(new_gui_mode);
+#ifdef CONFIG_5D4
+        /*
+         * 5D4: LiveView needs a longer Canon GUI settling time.
+         * Outside LiveView, use a shorter transition to minimize
+         * the visible Canon backing frame.
+         */
+
+        if (ml_menu_opened_from_level_5d4)
+            msleep(20);
+        else
+            msleep(lv_5d4 ? 125 : 75);
+
+        if (ml_menu_opened_from_lv_5d4)
+        {
+            extern void test147_5d4_gdraw_disable(void);
+            extern int test161_5d4_gdraw_blank_keepalive(void);
+
+            menu_redraw_full();
+            refresh_yuv_from_rgb();
+
+            /* TEST196: graceful layer1 -> Canon handoff */
+msleep(20);            test161_5d4_gdraw_blank_keepalive();            test147_5d4_gdraw_disable();
+        }
+#else
+        msleep(200);
+#endif
+        // bmp will be enabled after first redraw
+    }
+#endif
+}
