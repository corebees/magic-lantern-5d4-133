+static void
+gd5d4_draw_histogram_rgba_cached(
+    uint32_t *dst,
+    uint32_t pitch,
+    uint32_t ox,
+    uint32_t oy
+)
+{
+    if (!dst)
+        return;
+
+    if (!hist_draw || waveform_draw)
+        return;
+
+    if (hist_type >= 2)
+        return;
+
+    int ci = gd5d4_histogram_cache_index;
+
+    if (ci < 0)
+        return;
+
+    const struct Histogram *h =
+        &gd5d4_histogram_cache[ci];
+
+    if (h->is_raw)
+        return;
+
+    uint32_t hmax = h->max ? h->max : 1;
+    uint32_t log_max = log_length(hmax);
+
+    if (!log_max)
+        log_max = 1;
+
+    static uint32_t rgba_lut[256];
+    static int rgba_lut_ready = 0;
+
+    if (!rgba_lut_ready)
+    {
+        for (int i = 0; i < 256; i++)
+            rgba_lut[i] = indexed2rgb(i);
+
+        rgba_lut_ready = 1;
+    }
+
+    const int x_origin = 560;
+    const int y_origin = 80;
+
+    for (int x = 0; x < HIST_WIDTH; x++)
+    {
+        uint32_t size =
+            hist_log
+                ? log_length(h->hist[x]) *
+                    hist_height / log_max
+                : h->hist[x] *
+                    hist_height / hmax;
+
+        uint32_t sizeR =
+            hist_log
+                ? log_length(h->hist_r[x]) *
+                    hist_height / log_max
+                : h->hist_r[x] *
+                    hist_height / hmax;
+
+        uint32_t sizeG =
+            hist_log
+                ? log_length(h->hist_g[x]) *
+                    hist_height / log_max
+                : h->hist_g[x] *
+                    hist_height / hmax;
+
+        uint32_t sizeB =
+            hist_log
+                ? log_length(h->hist_b[x]) *
+                    hist_height / log_max
+                : h->hist_b[x] *
+                    hist_height / hmax;
+
+        for (int row = 0; row < hist_height; row++)
+        {
+            int level = hist_height - row;
+            int pal;
+
+            if (h->is_rgb)
+            {
+                pal =
+                    gd5d4_hist_rgb_color(
+                        level,
+                        sizeR,
+                        sizeG,
+                        sizeB
+                    );
+            }
+            else
+            {
+                if (level > (int)size)
+                {
+                    pal = COLOR_BG;
+                }
+                else
+                {
+#ifdef FEATURE_FALSE_COLOR
+                    pal =
+                        falsecolor_fordraw(
+                            ((x << 8) / HIST_WIDTH) &
+                            0xFF
+                        );
+#else
+                    pal = COLOR_WHITE;
+#endif
+                }
+            }
+
+            dst[
+                (oy + y_origin + row) * pitch +
+                ox +
+                x_origin +
+                x
+            ] = rgba_lut[pal & 0xFF];
+        }
+    }
+
+    const uint32_t border =
+        rgba_lut[60];
+
+    const int bx0 = x_origin - 1;
+    const int by0 = y_origin - 1;
+    const int bx1 = x_origin + HIST_WIDTH;
+    const int by1 = y_origin + hist_height;
+
+    uint32_t *top =
+        dst + (oy + by0) * pitch + ox;
+
+    uint32_t *bottom =
+        dst + (oy + by1) * pitch + ox;
+
+    for (int x = bx0; x <= bx1; x++)
+    {
+        top[x] = border;
+        bottom[x] = border;
+    }
+
+    for (int y = by0; y <= by1; y++)
+    {
+        uint32_t *row =
+            dst + (oy + y) * pitch + ox;
+
+        row[bx0] = border;
+        row[bx1] = border;
+    }
+}
