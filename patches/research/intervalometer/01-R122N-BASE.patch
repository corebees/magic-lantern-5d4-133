+                (red_rgba & 0x00FFFFFF) |
+                (gd5d4_fad05_main_alpha << 24);
+
+            const uint32_t edge_color =
+                (red_rgba & 0x00FFFFFF) |
+                (gd5d4_fad05_edge_alpha << 24);
+
+
+            const uint32_t blue_rgba =
+                indexed2rgb(COLOR_BLUE);
+
+            const uint32_t under_color =
+                (blue_rgba & 0x00FFFFFF) |
+                (gd5d4_fad05_main_alpha << 24);
+
