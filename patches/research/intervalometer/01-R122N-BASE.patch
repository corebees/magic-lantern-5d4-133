+static void
+gd5d4_clear_histogram_rgba_region(
+    uint32_t *dst,
+    uint32_t pitch,
+    uint32_t ox,
+    uint32_t oy
+)
+{
+    if (!dst)
+        return;
+
+    /*
+     * GD-D6-ZEBRA27G-R3-HISTOGRAM-CONDITIONAL-CLEAR
+     *
+     * Do not clear the Histogram rectangle on every READY-driven
+     * Zebra frame while Histogram is disabled.
+     *
+     * If a cached Histogram existed previously, clear the region
+     * exactly once and invalidate the cache so stale graph pixels
+     * cannot survive an ON -> OFF transition.
+     */
+    if (hist_draw)
+        return;
+
+    if (gd5d4_histogram_cache_index < 0)
+        return;
+
+    gd5d4_histogram_cache_index = -1;
+
+    const int w =
+        HIST_WIDTH + 2;
+
+    const int h =
+        hist_height + 2;
+
+    /*
+     * Small / standard dedicated location.
+     */
+    const int x0_small = 559;
+    const int y0_small = 79;
+
+    /*
+     * Large-Waveform legacy-compatible Histogram location.
+     */
+    const int hist_x_large =
+        os.x_max -
+        HIST_WIDTH -
+        2;
+
+    const int hist_y_large =
+        os.y_max -
+        (lv ? os.off_169 + 10 : 0) -
+        hist_height -
+        1;
+
+    const int x0_large =
+        hist_x_large - 1;
+
+    const int y0_large =
+        hist_y_large - 1;
+
+    for (int y = 0; y < h; y++)
+    {
+        memset(
+            dst +
+                (oy + y0_small + y) *
+                    pitch +
+                ox +
+                x0_small,
+            0,
+            w * sizeof(uint32_t)
+        );
+
+        memset(
+            dst +
+                (oy + y0_large + y) *
+                    pitch +
+                ox +
+                x0_large,
+            0,
+            w * sizeof(uint32_t)
+        );
+    }
+}
