+}
+
+static MENU_UPDATE_FUNC(gd5d4_r24c_wf_update)
+{
+    uint32_t n=gd5d4_r24c_stats.samples;
+    MENU_SET_VALUE("%u / %u us",
+        n ? gd5d4_r24c_stats.wf_sum/n : 0,
+        gd5d4_r24c_stats.wf_max);
+}
+
+static MENU_UPDATE_FUNC(gd5d4_r24c_hist_update)
+{
+    uint32_t n=gd5d4_r24c_stats.samples;
+    MENU_SET_VALUE("%u / %u us",
+        n ? gd5d4_r24c_stats.hist_sum/n : 0,
+        gd5d4_r24c_stats.hist_max);
+}
+
+static MENU_UPDATE_FUNC(gd5d4_r24c_total_update)
+{
+    uint32_t n=gd5d4_r24c_stats.samples;
+    MENU_SET_VALUE("%u / %u us",
+        n ? gd5d4_r24c_stats.total_sum/n : 0,
+        gd5d4_r24c_stats.total_max);
+}
+
+static MENU_UPDATE_FUNC(gd5d4_r24c_interval_update)
+{
+    uint32_t n=gd5d4_r24c_stats.intervals;
+    MENU_SET_VALUE("%u / %u us",
+        n ? gd5d4_r24c_stats.interval_sum/n : 0,
+        gd5d4_r24c_stats.interval_max);
+}
+
+static MENU_UPDATE_FUNC(gd5d4_r24c_clock_update)
+{
+    MENU_SET_VALUE("%u us",
+        gd5d4_r24c_stats.clock_us);
+}
+
+static struct menu_entry gd5d4_r24c_menus[] =
+{
+    {
+        .name="R24C Samples",
+        .priv=&gd5d4_r24c_menu_dummy,
+        .max=0,
+        .update=gd5d4_r24c_count_update,
+        .help="Combined graph samples, capped at 192."
+    },
+    {
+        .name="R24C YUV avg/max",
+        .priv=&gd5d4_r24c_menu_dummy,
+        .max=0,
+        .update=gd5d4_r24c_yuv_update,
+        .help="hist_build execution time, microseconds."
+    },
+    {
+        .name="R24C WF avg/max",
+        .priv=&gd5d4_r24c_menu_dummy,
+        .max=0,
+        .update=gd5d4_r24c_wf_update,
+        .help="Waveform cache section, microseconds."
+    },
+    {
+        .name="R24C HIST avg/max",
+        .priv=&gd5d4_r24c_menu_dummy,
+        .max=0,
+        .update=gd5d4_r24c_hist_update,
+        .help="Histogram cache section, microseconds."
+    },
+    {
+        .name="R24C Total avg/max",
+        .priv=&gd5d4_r24c_menu_dummy,
+        .max=0,
+        .update=gd5d4_r24c_total_update,
+        .help="Complete combined producer, microseconds."
+    },
+    {
+        .name="R24C Period avg/max",
+        .priv=&gd5d4_r24c_menu_dummy,
+        .max=0,
+        .update=gd5d4_r24c_interval_update,
+        .help="Time between combined producer starts."
+    },
+    {
+        .name="R24C Clock read",
+        .priv=&gd5d4_r24c_menu_dummy,
+        .max=0,
+        .update=gd5d4_r24c_clock_update,
+        .help="Two consecutive clock reads, microseconds."
+    },
+};
+#endif
+
