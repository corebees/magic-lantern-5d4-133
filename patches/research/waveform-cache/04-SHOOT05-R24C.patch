  * Double buffering prevents the fast renderer from reading the
  * cache currently being refreshed by the low-priority task.
  */
+
+/*
+ * SHOOT05-R24C — experimental bounded profiler.
+ * Writer: combined graph producer on low-priority LV.
+ * Reader: ML Debug menu.
+ *
+ * No disk I/O, heap allocation or timer calls in READY.
+ * No change to graph production algorithms.
+ */
+#define GD5D4_R24C_LIMIT 192U
+
+static volatile struct
+{
+    uint32_t samples;
+    uint32_t intervals;
+    uint32_t yuv_sum, yuv_max;
+    uint32_t wf_sum, wf_max;
+    uint32_t hist_sum, hist_max;
+    uint32_t total_sum, total_max;
+    uint32_t interval_sum, interval_max;
+    uint32_t clock_us;
+    uint64_t previous_start;
+} gd5d4_r24c_stats;
+
+static uint32_t
+gd5d4_r24c_delta(uint64_t a,uint64_t b)
+{
+    if (b<a) return 0;
+    uint64_t d=b-a;
+    return (uint32_t)(d>1000000ULL ? 1000000ULL : d);
+}
+
+static void
+gd5d4_r24c_push(
+    uint64_t t0,
+    uint64_t t1,
+    uint64_t t2,
+    uint64_t t3
+)
+{
+    uint32_t n=gd5d4_r24c_stats.samples;
+    if (n>=GD5D4_R24C_LIMIT) return;
+
+    if (n==0)
+    {
+        uint64_t a=get_us_clock();
+        uint64_t b=get_us_clock();
+        gd5d4_r24c_stats.clock_us=
+            gd5d4_r24c_delta(a,b);
+    }
+
+    if (n && t0>=gd5d4_r24c_stats.previous_start)
+    {
+        uint32_t d=gd5d4_r24c_delta(
+            gd5d4_r24c_stats.previous_start,t0
+        );
+        gd5d4_r24c_stats.interval_sum+=d;
+        if (d>gd5d4_r24c_stats.interval_max)
+            gd5d4_r24c_stats.interval_max=d;
+        gd5d4_r24c_stats.intervals++;
+    }
+
+    gd5d4_r24c_stats.previous_start=t0;
+
+    uint32_t y=gd5d4_r24c_delta(t0,t1);
+    uint32_t w=gd5d4_r24c_delta(t1,t2);
+    uint32_t h=gd5d4_r24c_delta(t2,t3);
+    uint32_t total=gd5d4_r24c_delta(t0,t3);
+
+    gd5d4_r24c_stats.yuv_sum+=y;
+    gd5d4_r24c_stats.wf_sum+=w;
+    gd5d4_r24c_stats.hist_sum+=h;
+    gd5d4_r24c_stats.total_sum+=total;
+
+    if (y>gd5d4_r24c_stats.yuv_max)
+        gd5d4_r24c_stats.yuv_max=y;
+    if (w>gd5d4_r24c_stats.wf_max)
+        gd5d4_r24c_stats.wf_max=w;
+    if (h>gd5d4_r24c_stats.hist_max)
+        gd5d4_r24c_stats.hist_max=h;
+    if (total>gd5d4_r24c_stats.total_max)
+        gd5d4_r24c_stats.total_max=total;
+
+    __sync_synchronize();
+    gd5d4_r24c_stats.samples=n+1;
+}
+
 /*
  * SHOOT05-R21: deferred Waveform cache.
  * Both tiles remain valid for the entire session.
@@ -4575,8 +4662,17 @@ gd5d4_combined_graph_cache_refresh(void)
     /*
      * One YUV scan generates both Histogram and Waveform.
      */
+    int r24c_measure =
+        gd5d4_r24c_stats.samples < GD5D4_R24C_LIMIT;
+
+    uint64_t r24c_t0 =
+        r24c_measure ? get_us_clock() : 0;
+
     hist_build();
 
+    uint64_t r24c_t1 =
+        r24c_measure ? get_us_clock() : 0;
+
     /*
      * Publish Waveform cache.
      */
@@ -4600,11 +4696,22 @@ gd5d4_combined_graph_cache_refresh(void)
      * Reuse the Histogram generated by the SAME hist_build().
      * No second YUV scan.
      */
+    uint64_t r24c_t2 =
+        r24c_measure ? get_us_clock() : 0;
+
     gd5d4_histogram_use_current_build = 1;
 
     gd5d4_histogram_cache_refresh();
 
     gd5d4_histogram_use_current_build = 0;
+
+    if (r24c_measure)
+    {
+        uint64_t r24c_t3=get_us_clock();
+        gd5d4_r24c_push(
+            r24c_t0,r24c_t1,r24c_t2,r24c_t3
+        );
+    }
 }
 #endif
 
@@ -13610,6 +13717,119 @@ int handle_overlays_playback(struct event * event)
 }
 #endif
 
